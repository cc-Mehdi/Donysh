{
  "name": "hesabyar-web",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build:css": "npm run build:icons && tailwindcss -i ./Styles/app.css -o ./wwwroot/css/app.css --minify",
    "build:icons": "node ./scripts/build-icons.mjs",
    "watch:css": "tailwindcss -i ./Styles/app.css -o ./wwwroot/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "lucide-static": "^1.61.0",
    "tailwindcss": "4.3.3"
  },
  "overrides": {
    "@parcel/watcher": "2.6.0",
    "source-map-js": "1.2.2"
  }
}
