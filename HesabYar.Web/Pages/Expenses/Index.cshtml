@page
@model IndexModel
@{
    ViewData["Title"] = "مخارج";
    var fromValue = FormValueHelper.RawOrPersianDate(ViewData, "From", Model.From);
    var toValue = FormValueHelper.RawOrPersianDate(ViewData, "To", Model.To);
}
<div class="mb-6 flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
    <div><h2 class="text-2xl font-black">فهرست مخارج</h2><p class="mt-1 text-sm text-slate-500">جست‌وجو، فیلتر و مدیریت خرج‌های فضای فعال</p></div>
    <a asp-page="Create" class="btn-primary">＋ ثبت خرج جدید</a>
</div>

<section class="card mb-5">
    <form method="get" class="grid gap-3 md:grid-cols-2 xl:grid-cols-5">
        <div class="xl:col-span-2">
            <label asp-for="Q" class="label">جست‌وجوی دلیل خرج</label>
            <input asp-for="Q" class="input" placeholder="مثلاً خرید هفتگی" />
        </div>
        <div>
            <label asp-for="CategoryId" class="label">دسته‌بندی</label>
            <select asp-for="CategoryId" class="input">
                <option value="">همه دسته‌ها</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Id">@category.Icon @category.Name</option>
                }
            </select>
        </div>
        <div>
            <label asp-for="From" class="label">از تاریخ</label>
            <input id="From" name="From" value="@fromValue" type="text" inputmode="numeric" autocomplete="off" data-persian-date class="input ltr-input" placeholder="۱۴۰۵/۰۵/۰۱" />
        </div>
        <div>
            <label asp-for="To" class="label">تا تاریخ</label>
            <input id="To" name="To" value="@toValue" type="text" inputmode="numeric" autocomplete="off" data-persian-date class="input ltr-input" placeholder="۱۴۰۵/۰۵/۳۱" />
        </div>
        <div class="flex gap-2 md:col-span-2 xl:col-span-5">
            <label><input asp-for="NeedsReview" /> فقط نیازمند بررسی</label>
            <button class="btn-primary" type="submit">اعمال فیلتر</button>
            <a asp-page="Index" class="btn-secondary">پاک‌کردن فیلتر</a>
        </div>
    </form>
</section>

<div class="mb-4 flex items-center justify-between rounded-2xl bg-slate-900 px-5 py-4 text-white">
    <span class="text-sm text-slate-300">مجموع نتایج (@Model.Items.Count مورد)</span>
    <strong class="text-lg">@Formatters.Money(Model.Total)</strong>
</div>

@if (Model.IsSharedWorkspace)
{
    <section class="card mb-5">
        <div class="mb-4 flex flex-col justify-between gap-2 sm:flex-row sm:items-end">
            <div>
                <h3 class="card-title">@(Model.HasDateFilter ? "خرج اعضا در بازه انتخابی" : "خرج اعضا در این ماه")</h3>
                <p class="muted mt-1">خرج هر عضو در @Model.MemberExpensesPeriodTitle با فیلترهای انتخاب‌شده نمایش داده می‌شود.</p>
            </div>
            <span class="badge">مجموع: @Formatters.Money(Model.MemberExpensesTotal)</span>
        </div>

        @if (Model.MemberExpenses.Count == 0)
        {
            <p class="rounded-2xl bg-slate-50 p-5 text-center text-sm text-slate-500">@(Model.HasActiveFilter ? "هیچ عضوی با فیلترهای انتخاب‌شده خرجی ندارد." : "عضوی برای نمایش وجود ندارد.")</p>
        }
        else
        {
            <div class="grid gap-3 md:grid-cols-2">
                @foreach (var member in Model.MemberExpenses)
                {
                    var share = Model.MemberExpensesTotal <= 0 ? 0 : Math.Round(member.Amount / Model.MemberExpensesTotal * 100, 1);
                    <article class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <h4 class="truncate font-black">@member.DisplayName</h4>
                                <p class="mt-1 text-xs text-slate-500">@member.Count خرج ثبت‌شده · @Formatters.Percent(share) از مخارج این بازه</p>
                            </div>
                            <strong class="shrink-0 text-sm text-rose-600">@Formatters.Money(member.Amount)</strong>
                        </div>

                        @if (member.Categories.Count == 0)
                        {
                            <p class="mt-3 rounded-xl bg-white p-3 text-xs text-slate-500">در این بازه و با فیلترهای انتخاب‌شده خرجی توسط این عضو ثبت نشده است.</p>
                        }
                        else
                        {
                            <div class="mt-3 grid gap-2">
                                @foreach (var category in member.Categories)
                                {
                                    <div class="flex items-center justify-between gap-2 rounded-xl bg-white p-3 text-xs">
                                        <span class="truncate font-bold">@category.Icon @category.Name <span class="text-slate-400">(@category.Count مورد)</span></span>
                                        <span class="shrink-0 font-bold text-rose-600">@Formatters.Money(category.Amount)</span>
                                    </div>
                                }
                            </div>
                        }
                    </article>
                }
            </div>
        }
    </section>
}

@if (Model.Items.Count == 0)
{
    <div class="empty"><div class="text-5xl">🧾</div><h3 class="mt-4 text-lg font-bold">خرجی پیدا نشد</h3><p class="mt-1 text-sm text-slate-500">فیلترها را تغییر دهید یا یک خرج جدید ثبت کنید.</p><a asp-page="Create" class="btn-primary mt-5">ثبت خرج</a></div>
}
else
{
    <div class="hidden md:block table-wrap">
        <table class="table">
            <thead><tr><th>شرح</th><th>دسته</th><th>تاریخ</th><th>ثبت‌کننده</th><th>مبلغ</th><th class="w-52">عملیات</th></tr></thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td class="font-bold">@item.Reason @if(item.NeedsReview) { <span class="badge">پیامکی · نیازمند بررسی</span> }</td>
                    <td><span class="inline-flex items-center gap-2"><span class="text-lg">@item.Category.Icon</span>@item.Category.Name</span></td>
                    <td class="text-slate-500">@Formatters.PersianDate(item.ExpenseDate)</td>
                    <td class="text-slate-500">@item.CreatedByUser.DisplayName</td>
                    <td class="font-black text-rose-600">@Formatters.Money(item.Amount)</td>
                    <td>
                        <div class="flex gap-1">
                            <a asp-page="Edit" asp-route-id="@item.Id" class="btn-secondary px-3 py-2">ویرایش</a>
                            @if (Model.TransferDestinations.Count > 0)
                            {
                                <button type="button" class="btn-secondary px-3 py-2 text-indigo-700"
                                        data-expense-transfer-open
                                        data-expense-id="@item.Id"
                                        data-expense-title="@item.Reason"
                                        data-expense-amount="@Formatters.Money(item.Amount)">
                                    انتقال
                                </button>
                            }
                            <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id">
                                <button class="btn-secondary px-3 py-2 text-rose-600" data-confirm="این خرج حذف شود؟" type="submit">حذف</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="space-y-3 md:hidden">
        @foreach (var item in Model.Items)
        {
            <article class="card p-4">
                @if(item.NeedsReview) { <p class="badge mb-2">پیامکی · نیازمند بررسی</p> }
                <div class="flex items-start justify-between gap-3">
                    <div class="flex min-w-0 items-center gap-3">
                        <span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-slate-100 text-xl">@item.Category.Icon</span>
                        <div class="min-w-0"><h3 class="truncate font-bold">@item.Reason</h3><p class="mt-1 text-xs text-slate-500">@item.Category.Name · @Formatters.PersianDate(item.ExpenseDate)</p></div>
                    </div>
                    <strong class="shrink-0 text-sm text-rose-600">@Formatters.Money(item.Amount)</strong>
                </div>
                <div class="mt-4 flex items-center justify-between border-t border-slate-100 pt-3">
                    <span class="text-xs text-slate-500">ثبت توسط @item.CreatedByUser.DisplayName</span>
                    <div class="flex gap-2">
                        <a asp-page="Edit" asp-route-id="@item.Id" class="text-xs font-bold text-indigo-700">ویرایش</a>
                        @if (Model.TransferDestinations.Count > 0)
                        {
                            <button type="button" class="text-xs font-bold text-indigo-700"
                                    data-expense-transfer-open
                                    data-expense-id="@item.Id"
                                    data-expense-title="@item.Reason"
                                    data-expense-amount="@Formatters.Money(item.Amount)">
                                انتقال
                            </button>
                        }
                        <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id"><button type="submit" class="text-xs font-bold text-rose-600" data-confirm="این خرج حذف شود؟">حذف</button></form>
                    </div>
                </div>
            </article>
        }
    </div>
}

@if (Model.TransferDestinations.Count > 0)
{
    <div hidden data-expense-transfer-modal
         class="fixed inset-0 z-50 grid place-items-end bg-slate-950/55 p-0 backdrop-blur-sm sm:place-items-center sm:p-5"
         role="dialog" aria-modal="true" aria-labelledby="expense-transfer-title">
        <section class="max-h-[92vh] w-full overflow-y-auto rounded-t-3xl bg-white shadow-2xl sm:max-w-xl sm:rounded-3xl">
            <header class="sticky top-0 z-10 flex items-start justify-between gap-4 border-b border-slate-100 bg-white/95 px-5 py-4 backdrop-blur sm:px-6">
                <div>
                    <p class="mb-1 text-xs font-bold text-indigo-600">جابجایی بین فضاهای مالی</p>
                    <h2 id="expense-transfer-title" class="text-xl font-black">انتقال خرج</h2>
                    <p class="mt-1 text-sm text-slate-500">مقصد، دسته و عنوان نهایی خرج را انتخاب کنید.</p>
                </div>
                <button type="button" data-expense-transfer-close
                        class="grid size-10 shrink-0 place-items-center rounded-xl bg-slate-100 text-xl text-slate-600"
                        aria-label="بستن پنجره">×</button>
            </header>

            <form method="post" asp-page-handler="Transfer" data-expense-transfer-form class="space-y-5 p-5 sm:p-6">
                <input asp-for="Transfer.ExpenseId" type="hidden" data-expense-transfer-id />

                <div class="rounded-2xl border border-indigo-100 bg-indigo-50 p-4">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <p class="text-xs font-bold text-indigo-600">خرج انتخاب‌شده</p>
                            <p class="mt-1 truncate font-black text-slate-900" data-expense-transfer-summary-title></p>
                            <p class="mt-1 text-xs text-slate-500">از فضای «@Model.CurrentWorkspaceName»</p>
                        </div>
                        <strong class="shrink-0 text-sm text-rose-600" data-expense-transfer-summary-amount></strong>
                    </div>
                </div>

                <div>
                    <label asp-for="Transfer.DestinationWorkspaceId" class="label">فضای مالی مقصد</label>
                    <select asp-for="Transfer.DestinationWorkspaceId" class="input" data-expense-transfer-workspace required>
                        @foreach (var workspace in Model.TransferDestinations)
                        {
                            <option value="@workspace.Id">@workspace.Name · @(workspace.Type == WorkspaceType.Shared ? "مشترک" : "شخصی")</option>
                        }
                    </select>
                    <p class="muted mt-1">فقط فضاهایی نمایش داده می‌شوند که به آن‌ها دسترسی دارید.</p>
                </div>

                <div>
                    <label asp-for="Transfer.DestinationCategoryId" class="label">دسته در فضای مقصد</label>
                    <select asp-for="Transfer.DestinationCategoryId" class="input" data-expense-transfer-category required>
                        @foreach (var category in Model.TransferCategories)
                        {
                            <option value="@category.Id" data-workspace-id="@category.WorkspaceId">@category.Icon @category.Name</option>
                        }
                    </select>
                    <p class="mt-1 hidden text-xs font-bold text-amber-700" data-expense-transfer-no-category>
                        این فضای مالی دستهٔ فعالی ندارد؛ ابتدا برای آن یک دسته بسازید.
                    </p>
                </div>

                <div>
                    <label asp-for="Transfer.Reason" class="label">عنوان خرج در مقصد</label>
                    <input asp-for="Transfer.Reason" class="input" maxlength="200" required
                           data-expense-transfer-reason placeholder="مثلاً خرید هفتگی" />
                    <span asp-validation-for="Transfer.Reason" class="field-error"></span>
                </div>

                <div class="rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm leading-7 text-amber-900">
                    پس از تأیید، خرج از فضای «@Model.CurrentWorkspaceName» برداشته می‌شود و با همان مبلغ و تاریخ در فضای مقصد قرار می‌گیرد.
                </div>

                <div class="grid gap-2 sm:grid-cols-2">
                    <button type="submit" class="btn-primary w-full" data-expense-transfer-submit>تأیید انتقال</button>
                    <button type="button" class="btn-secondary w-full" data-expense-transfer-close>انصراف</button>
                </div>
            </form>
        </section>
    </div>
}
