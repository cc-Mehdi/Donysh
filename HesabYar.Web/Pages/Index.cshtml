@page
@model IndexModel
@{
    ViewData["Title"] = "داشبورد";
    var categoryStops = new List<string>();
    decimal offset = 0;
    foreach (var slice in Model.CategoryBreakdown)
    {
        var end = offset + slice.Percent;
        categoryStops.Add($"{slice.Color} {offset.ToString(System.Globalization.CultureInfo.InvariantCulture)}% {end.ToString(System.Globalization.CultureInfo.InvariantCulture)}%");
        offset = end;
    }
    if (offset < 100) categoryStops.Add($"#e6eafa {offset.ToString(System.Globalization.CultureInfo.InvariantCulture)}% 100%");
    var categoryGradient = $"conic-gradient({string.Join(",", categoryStops)})";
    var greeting = DateTime.Now.Hour < 12 ? "صبح بخیر" : DateTime.Now.Hour < 18 ? "روز بخیر" : "شب بخیر";
}
<div class="finance-dashboard">
    <section class="dashboard-hero">
        <div class="dashboard-hero-top">
            <span class="dashboard-date"><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#calendar-days"></use></svg>@Formatters.PersianDate(Model.Today)</span>
            <div class="dashboard-hero-tools">
                <form method="get" asp-page="/Expenses/Index" role="search" class="dashboard-search">
                    <svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#search"></use></svg>
                    <input name="Q" type="search" placeholder="جستجو در مخارج..." aria-label="جستجو در مخارج" />
                </form>
                <button type="button" class="dashboard-icon-button" data-finance-theme-toggle aria-label="تغییر پوسته" aria-pressed="false"><svg class="lucide-icon theme-icon-moon" aria-hidden="true"><use href="/icons/lucide.svg#moon"></use></svg><svg class="lucide-icon theme-icon-sun" aria-hidden="true"><use href="/icons/lucide.svg#sun"></use></svg></button>
                <button type="button" class="dashboard-icon-button dashboard-menu-button" data-open-sidebar aria-label="بازکردن منو"><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#menu"></use></svg></button>
                <span class="dashboard-avatar" aria-hidden="true">@((ViewData["DashboardDisplayName"]?.ToString() ?? "د").Substring(0, 1))</span>
            </div>
        </div>
        <div class="dashboard-hero-lower">
            <div class="dashboard-greeting"><h1>@greeting،<br />@ViewData["DashboardDisplayName"]</h1><p>امروز یک قدم کوچک، فردای آرام‌تر 🌱</p></div>
            <div class="dashboard-hero-actions">
                <a asp-page="/Workspaces/Index" class="hero-workspace"><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#wallet"></use></svg><span><small>فضای مالی</small><strong>@Model.CurrentWorkspace.Name</strong></span><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#chevron-down"></use></svg></a>
                <a asp-page="/Expenses/Create" class="hero-action hero-action-primary"><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#plus"></use></svg>ثبت خرج</a>
                <a href="https://life.donysh.ir/" class="hero-action hero-action-life"><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#leaf"></use></svg>دُنیش زندگی</a>
            </div>
            <div class="dashboard-tip"><span class="dashboard-tip-icon">💡</span><div><strong>نکته امروز</strong><p>خرج‌هایت را ثبت کن تا تصویر روشنی از ماهت داشته باشی.</p></div></div>
        </div>
    </section>
    <div class="dashboard-content">
        <div class="dashboard-left">
            <div class="dashboard-metrics">
                <a asp-page="/Expenses/Index" class="metric-card metric-primary"><div><span>کل هزینه‌های این ماه</span><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#chart-column-increasing"></use></svg></div><strong>@Model.MonthTotal.ToString("N0")</strong><small>تومان · @Model.MonthExpenseCount خرج ثبت‌شده</small></a>
                <a asp-page="/Savings/Index" class="metric-card metric-savings"><div><span>پس‌انداز این ماه</span><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#piggy-bank"></use></svg></div><strong>@Model.MonthSavings.ToString("N0")</strong><small>تومان · واریزی هدف‌ها</small></a>
                <a asp-page="/Budgets/Index" class="metric-card metric-budget"><div><span>بودجه باقی‌مانده</span><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#wallet"></use></svg></div><strong>@Model.BudgetRemaining.ToString("N0")</strong><small>تومان · @Model.BudgetCards.Count بودجه فعال</small></a>
                <a asp-page="/Obligations/Index" class="metric-card metric-obligations"><div><span>تعهدات پرداخت‌نشده</span><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#calendar-days"></use></svg></div><strong>@Model.MonthObligationUnpaid.ToString("N0")</strong><small>تومان · از @Formatters.Money(Model.MonthObligationTotal) این ماه</small></a>
            </div>
            <div class="dashboard-analytics-grid">
                <section class="dashboard-panel trend-panel">
                    <div class="dashboard-panel-head"><h2>روند هزینه‌ها</h2><a asp-page="/Reports/Index">گزارش کامل</a></div>
                    <div class="dashboard-chart-tabs" aria-label="بازه نمودار"><span class="active">ماهانه</span><span>خرج روزانه</span></div>
                    @if (!Model.ExpenseTrend.Any(x => x.Amount > 0))
                    {
                        <div class="dashboard-empty">هنوز خرجی برای نمایش در نمودار ثبت نشده است.</div>
                    }
                    else
                    {
                        <div class="trend-scroll"><div class="trend-chart" role="img" aria-label="نمودار خرج روزانهٔ ماه جاری">
                            @foreach (var point in Model.ExpenseTrend)
                            {
                                <div class="trend-day" title="روز @point.Day: @Formatters.Money(point.Amount)"><span class="trend-bar" style="height:@(point.Height.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span><small>@(point.Day == 1 || point.Day % 5 == 0 ? point.Day.ToString() : "")</small></div>
                            }
                        </div></div>
                    }
                </section>
                <section class="dashboard-panel category-panel">
                    <div class="dashboard-panel-head"><h2>دسته‌بندی هزینه‌ها</h2><a asp-page="/Categories/Index">همه دسته‌ها</a></div>
                    @if (Model.CategoryBreakdown.Count == 0)
                    {
                        <div class="dashboard-empty">با ثبت اولین خرج، سهم دسته‌ها اینجا نمایش داده می‌شود.</div>
                    }
                    else
                    {
                        <div class="category-body"><div class="category-ring" style="background:@categoryGradient"><div><strong>@Model.MonthTotal.ToString("N0")</strong><small>تومان</small></div></div><ul class="category-list">
                            @foreach (var category in Model.CategoryBreakdown)
                            {
                                <li><span class="category-dot" style="background:@category.Color"></span><span>@category.Name</span><strong>@Formatters.Percent(category.Percent)</strong></li>
                            }
                        </ul></div>
                    }
                </section>
                <section class="dashboard-panel recent-panel">
                    <div class="dashboard-panel-head"><h2>آخرین مخارج</h2><a asp-page="/Expenses/Index">مشاهده همه</a></div>
                    @if (Model.RecentExpenses.Count == 0)
                    {
                        <div class="dashboard-empty"><div>هنوز خرجی ثبت نشده.<br /><a asp-page="/Expenses/Create">اولین خرج را ثبت کن</a></div></div>
                    }
                    else
                    {
                        <div class="recent-list">
                            @foreach (var expense in Model.RecentExpenses.Take(4))
                            {
                                <a asp-page="/Expenses/Index" class="recent-item"><span class="recent-icon">@expense.Category.Icon</span><span class="recent-copy"><strong>@expense.Reason</strong><small>@expense.Category.Name</small></span><b>@Formatters.Money(expense.Amount)</b></a>
                            }
                        </div>
                    }
                </section>
            </div>
            @if (Model.BudgetCards.Any(x => x.IsExceeded) || Model.ObligationAlerts.Count > 0)
            {
                <div class="dashboard-alerts">
                    @if (Model.BudgetCards.Any(x => x.IsExceeded))
                    {
                        <a asp-page="/Budgets/Index">سقف بودجهٔ @string.Join("، ", Model.BudgetCards.Where(x => x.IsExceeded).Select(x => x.Name)) رد شده است.</a>
                    }
                    @foreach (var alert in Model.ObligationAlerts)
                    {
                        <a asp-page="/Obligations/Index">@alert.Title: @(alert.IsOverdue ? "از سررسید گذشته" : $"{alert.DaysUntilDue} روز تا سررسید")</a>
                    }
                </div>
            }
        </div>
        <aside class="dashboard-goals dashboard-panel">
            <div class="dashboard-panel-head"><h2>اهداف و برنامه‌ها</h2><a asp-page="/Savings/Index">مشاهده همه</a></div>
            @if (Model.SavingsCards.Count == 0)
            {
                <div class="dashboard-empty"><div>هنوز هدفی نداری.<br /><a asp-page="/Savings/Index">هدف تازه بساز</a></div></div>
            }
            else
            {
                <div class="goal-list">
                    @foreach (var goal in Model.SavingsCards.Take(3))
                    {
                        var width = Math.Clamp(goal.Percent, 0, 100);
                        <a asp-page="/Savings/Index" class="goal-card"><div class="goal-title"><span class="goal-icon"><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#target"></use></svg></span><strong>@goal.Name</strong></div><div class="goal-progress"><div class="progress"><span style="width:@(width.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span></div><b>@Formatters.Percent(goal.Percent)</b></div><small>@Formatters.Money(goal.Saved) / @Formatters.Money(goal.Target)</small></a>
                    }
                </div>
            }
        </aside>
    </div>
</div>
