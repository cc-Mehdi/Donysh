@inject IWorkspaceContext WorkspaceContext
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
@inject IConfiguration Configuration
@{
    var authenticated = User.Identity?.IsAuthenticated == true;
    var currentWorkspace = authenticated ? await WorkspaceContext.GetCurrentAsync() : null;
    var currentUser = authenticated ? await UserManager.GetUserAsync(User) : null;
    var currentUserDisplayName = string.IsNullOrWhiteSpace(currentUser?.DisplayName)
        ? currentUser?.Email
        : currentUser?.DisplayName;
    IReadOnlyList<Workspace> workspaces = authenticated ? await WorkspaceContext.GetAccessibleAsync() : Array.Empty<Workspace>();
    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    var isDashboard = page.Equals("/Index", StringComparison.OrdinalIgnoreCase);
    var configuredLifeUrl = Configuration["Products:LifeUrl"];
    var lifeUrl = Uri.TryCreate(configuredLifeUrl, UriKind.Absolute, out var parsedLifeUrl)
        && parsedLifeUrl.Scheme == Uri.UriSchemeHttps
            ? parsedLifeUrl.AbsoluteUri
            : "https://life.donysh.ir/";

    string NavClass(string prefix) => page.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)
        ? "nav-link nav-link-active"
        : "nav-link";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#4f46e5" />
    @if (isDashboard)
    {
        <script src="~/js/finance-theme-init.js" asp-append-version="true"></script>
    }
    <link rel="icon" type="image/png" href="~/images/donysh-mark.png" asp-append-version="true" />
    <title>@ViewData["Title"] - Donysh</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
@if (authenticated)
{
    <div class="finance-shell min-h-screen lg:grid lg:grid-cols-[17rem_1fr]">
        <aside id="sidebar" class="finance-sidebar fixed inset-y-0 right-0 z-40 hidden w-72 border-l border-slate-200 bg-white p-5 lg:static lg:block lg:w-auto">
            <div class="mb-7 flex items-center justify-between">
                <a asp-page="/Index" aria-label="Donysh">
                    <partial name="_Brand" />
                </a>
                <button type="button" class="rounded-xl p-2 text-slate-500 lg:hidden" data-close-sidebar aria-label="بستن"><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#x"></use></svg></button>
            </div>

            @if (currentWorkspace is not null)
            {
                <div class="mb-6 rounded-2xl border border-indigo-100 bg-indigo-50 p-3">
                    <div class="mb-2 flex items-center justify-between gap-2">
                        <span class="text-xs font-semibold text-indigo-700">فضای فعال</span>
                        <span class="badge">@(currentWorkspace.Type == WorkspaceType.Shared ? "مشترک" : "شخصی")</span>
                    </div>
                    <form method="post" asp-page="/Workspaces/Switch">
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <select name="workspaceId" class="input py-2 text-sm" data-auto-submit aria-label="انتخاب فضای مالی">
                            @foreach (var workspace in workspaces)
                            {
                                <option value="@workspace.Id" selected="@(workspace.Id == currentWorkspace.Id)">@workspace.Name</option>
                            }
                        </select>
                    </form>
                </div>
            }

            <nav class="space-y-1">
                <a asp-page="/Index" class="@NavClass("/Index")"><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#house"></use></svg><span>داشبورد</span></a>
                <a asp-page="/Expenses/Index" class="@NavClass("/Expenses")"><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#receipt"></use></svg><span>مخارج</span></a>
                <a asp-page="/Categories/Index" class="@NavClass("/Categories")"><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#tags"></use></svg><span>دسته‌بندی‌ها</span></a>
                <a asp-page="/Budgets/Index" class="@NavClass("/Budgets")"><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#wallet"></use></svg><span>بودجه‌ها</span></a>
                <a asp-page="/Obligations/Index" class="@NavClass("/Obligations")"><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#calendar-days"></use></svg><span>اقساط و هزینه‌های ثابت</span></a>
                <a asp-page="/Savings/Index" class="@NavClass("/Savings")"><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#piggy-bank"></use></svg><span>پس‌انداز</span></a>
                <a asp-page="/Reports/Index" class="@NavClass("/Reports")"><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#chart-no-axes-combined"></use></svg><span>گزارش‌ها</span></a>
                <a asp-page="/Ai/Index" class="@NavClass("/Ai")"><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#sparkles"></use></svg><span>دستیار هوشمند</span></a>
                <a asp-page="/Mobile/Index" class="@NavClass("/Mobile")"><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#smartphone"></use></svg><span>همراه دُنیش</span></a>
                <a asp-page="/Workspaces/Index" class="@NavClass("/Workspaces")"><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#landmark"></use></svg><span>فضاهای مالی</span></a>
                <a asp-page="/Settings/Index" class="@NavClass("/Settings")"><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#settings"></use></svg><span>تنظیمات</span></a>
            </nav>

            <div class="absolute inset-x-5 bottom-5 lg:static lg:mt-10">
                <a href="@lifeUrl" class="product-switcher mb-3 hidden lg:flex" aria-label="رفتن به دُنیش زندگی">
                    <img class="product-switcher-life-logo" src="~/images/donysh-life-logo.png" alt="" width="48" height="48" />
                    <span class="product-switcher-copy"><small>برنامه‌ریزی و عادت‌ها</small><strong>دُنیش زندگی</strong></span>
                    <span class="product-switcher-arrow" aria-hidden="true">←</span>
                </a>
                <div class="rounded-2xl border border-slate-200 p-3">
                    <div class="mb-3 min-w-0">
                        <div class="truncate text-sm font-semibold">@currentUserDisplayName</div>
                        <div class="truncate text-xs text-slate-500">@currentUser?.Email</div>
                    </div>
                    <div class="grid gap-2">
                        <a asp-page="/Settings/Index" class="btn-secondary w-full">تنظیمات حساب</a>
                        <form method="post" asp-page="/Account/Logout" data-native-submit data-logout-form>
                            <button class="btn-secondary w-full" type="submit">خروج</button>
                        </form>
                    </div>
                </div>
            </div>
        </aside>

        <div class="min-w-0">
            <header class="sticky top-0 z-30 border-b border-slate-200/80 bg-white/90 backdrop-blur">
                <div class="flex h-16 items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">
                    <div class="flex min-w-0 items-center gap-3">
                        <button type="button" class="grid size-10 place-items-center rounded-xl border border-slate-200 bg-white lg:hidden" data-open-sidebar aria-label="بازکردن منو"><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#menu"></use></svg></button>
                        <div class="min-w-0">
                            <h1 class="truncate font-bold">@ViewData["Title"]</h1>
                            @if (currentWorkspace is not null)
                            {
                                <p class="truncate text-xs text-slate-500">@currentWorkspace.Name</p>
                            }
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        @if (isDashboard)
                        {
                            <button type="button" class="theme-toggle" data-finance-theme-toggle aria-label="تغییر پوسته" aria-pressed="false"><svg class="lucide-icon theme-icon-moon" aria-hidden="true"><use href="/icons/lucide.svg#moon"></use></svg><svg class="lucide-icon theme-icon-sun" aria-hidden="true"><use href="/icons/lucide.svg#sun"></use></svg></button>
                        }
                        @await Component.InvokeAsync("ObligationAlert")
                        <a href="@lifeUrl" class="product-switcher-compact lg:hidden" aria-label="رفتن به دُنیش زندگی">
                            <img class="product-switcher-life-logo compact" src="~/images/donysh-life-logo.png" alt="" width="28" height="28" />
                            <span>زندگی</span>
                        </a>
                        <a asp-page="/Expenses/Create" class="btn-primary"><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#plus"></use></svg><span class="hidden sm:inline">ثبت خرج</span></a>
                    </div>
                </div>
            </header>

            <main class="mx-auto @(isDashboard ? "max-w-[100rem]" : "max-w-7xl") p-4 pb-24 sm:p-6 lg:p-8 lg:pb-8">
                @if (TempData["Success"] is string success)
                {
                    <div class="toast toast-success" data-toast>@success</div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="toast toast-error" data-toast>@error</div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <nav class="fixed inset-x-3 bottom-3 z-30 grid grid-cols-5 rounded-2xl border border-slate-200 bg-white/95 p-2 shadow-2xl backdrop-blur lg:hidden">
        <a asp-page="/Index" class="mobile-nav"><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#house"></use></svg><small>خانه</small></a>
        <a asp-page="/Expenses/Index" class="mobile-nav"><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#receipt"></use></svg><small>مخارج</small></a>
        <a asp-page="/Budgets/Index" class="mobile-nav"><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#wallet"></use></svg><small>بودجه</small></a>
        <a asp-page="/Savings/Index" class="mobile-nav"><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#piggy-bank"></use></svg><small>پس‌انداز</small></a>
        <a asp-page="/Reports/Index" class="mobile-nav"><svg class="lucide-icon" aria-hidden="true"><use href="/icons/lucide.svg#chart-no-axes-combined"></use></svg><small>گزارش</small></a>
    </nav>
}
else
{
    <main class="min-h-screen">
        @RenderBody()
    </main>
}
<script src="~/js/site.js" asp-append-version="true"></script>
@if (authenticated)
{
    <script src="~/js/session-sync.js"
            data-session-status-url="/Account/SessionStatus"
            data-signed-out-url="/Account/SignedOut"
            asp-append-version="true"></script>
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
