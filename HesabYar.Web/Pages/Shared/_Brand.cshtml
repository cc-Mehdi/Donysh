@{
    var compact = ViewData["BrandCompact"] as bool? ?? false;
    var light = ViewData["BrandLight"] as bool? ?? false;
}
<span class="donysh-brand @(light ? "donysh-brand-light" : "")" aria-label="دُنیش مالی">
    <img src="~/images/donysh-mark.png" asp-append-version="true" alt="" class="donysh-brand-mark" />
    @if (!compact)
    {
        <span class="donysh-brand-name">دُنیش مالی</span>
    }
</span>
