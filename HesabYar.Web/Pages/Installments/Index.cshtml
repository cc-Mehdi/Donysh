@page
@model HesabYar.Web.Pages.Installments.IndexModel
@{
    ViewData["Title"] = "اقساط";
    var dueDateValue = FormValueHelper.RawOrPersianDate(ViewData, "Input.FirstDueDate", Model.Input.FirstDueDate == default ? DateOnly.FromDateTime(DateTime.Today) : Model.Input.FirstDueDate);
}

<div class="mb-6">
    <h2 class="text-2xl font-black">اقساط</h2>
    <p class="mt-1 text-sm text-slate-500">تعهدهای قسطی و میزان پیشرفت پرداخت را در فضای مالی فعال مدیریت کنید.</p>
</div>

<div class="grid gap-6 xl:grid-cols-[24rem_1fr]">
    <section class="card h-fit">
        <h3 class="card-title">@(Model.Input.Id.HasValue ? "ویرایش قسط" : "افزودن قسط")</h3>
        <form method="post" asp-page-handler="Save" class="mt-5 grid gap-4">
            <input asp-for="Input.Id" type="hidden" />
            <div>
                <label asp-for="Input.Title" class="label">عنوان</label>
                <input asp-for="Input.Title" class="input" placeholder="مثلاً وام خرید لپ‌تاپ" />
                <span asp-validation-for="Input.Title" class="field-error"></span>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label asp-for="Input.TotalAmount" class="label">مبلغ کل</label>
                    <input asp-for="Input.TotalAmount" type="text" inputmode="numeric" data-money class="input ltr-input" />
                    <span asp-validation-for="Input.TotalAmount" class="field-error"></span>
                </div>
                <div>
                    <label asp-for="Input.InstallmentAmount" class="label">مبلغ هر قسط</label>
                    <input asp-for="Input.InstallmentAmount" type="text" inputmode="numeric" data-money class="input ltr-input" />
                    <span asp-validation-for="Input.InstallmentAmount" class="field-error"></span>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label asp-for="Input.InstallmentCount" class="label">تعداد کل</label>
                    <input asp-for="Input.InstallmentCount" type="number" min="1" max="600" class="input ltr-input" />
                    <span asp-validation-for="Input.InstallmentCount" class="field-error"></span>
                </div>
                <div>
                    <label asp-for="Input.PaidInstallments" class="label">پرداخت‌شده</label>
                    <input asp-for="Input.PaidInstallments" type="number" min="0" max="600" class="input ltr-input" />
                    <span asp-validation-for="Input.PaidInstallments" class="field-error"></span>
                </div>
            </div>
            <div>
                <label asp-for="Input.FirstDueDate" class="label">اولین سررسید</label>
                <input id="Input_FirstDueDate" name="Input.FirstDueDate" value="@dueDateValue" type="text" inputmode="numeric" autocomplete="off" data-persian-date class="input ltr-input" placeholder="۱۴۰۵/۰۶/۰۱" />
                <span asp-validation-for="Input.FirstDueDate" class="field-error"></span>
            </div>
            <div>
                <label asp-for="Input.Notes" class="label">توضیحات اختیاری</label>
                <textarea asp-for="Input.Notes" rows="3" class="input" placeholder="بانک، شماره قرارداد یا نکته مهم"></textarea>
                <span asp-validation-for="Input.Notes" class="field-error"></span>
            </div>
            <label class="flex items-center gap-2 text-sm font-bold">
                <input asp-for="Input.IsCompleted" class="size-4 accent-indigo-600" />
                تسویه شده است
            </label>
            <div class="flex gap-2">
                <button type="submit" class="btn-primary flex-1">ذخیره قسط</button>
                @if (Model.Input.Id.HasValue)
                {
                    <a asp-page="./Index" class="btn-secondary">انصراف</a>
                }
            </div>
        </form>
    </section>

    <section>
        @if (Model.Items.Count == 0)
        {
            <div class="empty">
                <div class="text-4xl">◷</div>
                <h3 class="mt-3 font-black">هنوز قسطی ثبت نشده است</h3>
                <p class="mt-1 text-sm text-slate-500">اولین تعهد قسطی را از فرم کنار صفحه اضافه کنید.</p>
            </div>
        }
        else
        {
            <div class="grid gap-4 lg:grid-cols-2">
                @foreach (var item in Model.Items)
                {
                    var percent = item.InstallmentCount <= 0 ? 0 : Math.Round((decimal)item.PaidInstallments / item.InstallmentCount * 100, 1);
                    var remaining = Math.Max(item.TotalAmount - item.InstallmentAmount * item.PaidInstallments, 0);
                    <article class="card @(item.IsCompleted ? "opacity-70" : "")">
                        <div class="flex items-start justify-between gap-3">
                            <div>
                                <h3 class="font-black">@item.Title</h3>
                                <p class="mt-1 text-xs text-slate-500">اولین سررسید: @Formatters.PersianDate(item.FirstDueDate)</p>
                            </div>
                            <span class="badge">@(item.IsCompleted ? "تسویه‌شده" : $"{item.PaidInstallments} از {item.InstallmentCount}")</span>
                        </div>
                        <div class="mt-5 grid grid-cols-2 gap-3 text-sm">
                            <div class="rounded-2xl bg-slate-50 p-3"><span class="block text-xs text-slate-500">هر قسط</span><strong class="mt-1 block">@Formatters.Money(item.InstallmentAmount)</strong></div>
                            <div class="rounded-2xl bg-indigo-50 p-3"><span class="block text-xs text-indigo-600">مانده تقریبی</span><strong class="mt-1 block text-indigo-800">@Formatters.Money(remaining)</strong></div>
                        </div>
                        <div class="progress mt-4"><div class="progress-bar bg-indigo-600" style="width: @(Math.Min(percent, 100))%"></div></div>
                        @if (!string.IsNullOrWhiteSpace(item.Notes))
                        {
                            <p class="mt-3 text-xs leading-6 text-slate-500">@item.Notes</p>
                        }
                        <div class="mt-4 flex gap-2 border-t border-slate-100 pt-4">
                            <a asp-page="./Index" asp-route-edit="@item.Id" class="btn-secondary flex-1">ویرایش</a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" onsubmit="return confirm('این قسط حذف شود؟');">
                                <button type="submit" class="btn-danger">حذف</button>
                            </form>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>
