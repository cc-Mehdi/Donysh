@page
@model AcceptModel
@{
    ViewData["Title"] = "پذیرش دعوت";
}
<div class="mx-auto mt-12 max-w-xl">
    <section class="card text-center">
        <div class="mx-auto grid size-16 place-items-center rounded-3xl bg-violet-100 text-3xl">♧</div>
        <h2 class="mt-5 text-2xl font-black">دعوت به فضای مالی مشترک</h2>
        <p class="mt-3 leading-7 text-slate-600">شما برای عضویت در فضای <strong>«@Model.Invitation.Workspace.Name»</strong> دعوت شده‌اید. پس از پذیرش، خرج‌ها، بودجه‌ها و هدف‌های پس‌انداز این فضا را با اعضا مدیریت می‌کنید.</p>
        <form method="post" class="mt-6">
            <input asp-for="Token" type="hidden" />
            <button type="submit" class="btn-primary w-full">پذیرش و ورود به فضای مشترک</button>
        </form>
        <a asp-page="/Workspaces/Index" class="btn-secondary mt-3 w-full">انصراف</a>
    </section>
</div>
