@page
@model IndexModel
@{
    ViewData["Title"] = "فضاهای مالی";
}

<div class="mb-6">
    <h2 class="text-2xl font-black">فضاهای مالی</h2>
    <p class="mt-1 text-sm text-slate-500">اطلاعات فضای شخصی جداست؛ در فضای مشترک اعضا خرج، بودجه و هدف پس‌انداز یکسان را می‌بینند.</p>
</div>

<section class="mb-6 rounded-3xl border border-emerald-200 bg-emerald-50 p-5 text-emerald-950">
    <div class="flex items-start gap-3">
        <span class="grid size-10 shrink-0 place-items-center rounded-2xl bg-emerald-600 text-xl text-white">۲</span>
        <div>
            <h3 class="font-black">استفاده دونفره چگونه است؟</h3>
            <p class="mt-1 text-sm leading-7 text-emerald-800">هر نفر با ایمیل خودش یک حساب جدا می‌سازد. نفر اول یک فضای مشترک ایجاد می‌کند و لینک دعوت را برای نفر دوم می‌فرستد. پس از پذیرش دعوت، هر دو نفر اطلاعات همان فضای مشترک را می‌بینند؛ بدون اینکه رمز عبورشان را با هم به اشتراک بگذارند.</p>
        </div>
    </div>
</section>

@if (Model.InviteLink is string inviteLink)
{
    <section class="mb-6 rounded-3xl border border-indigo-200 bg-indigo-50 p-5">
        <h3 class="font-black text-indigo-900">لینک دعوت آماده است</h3>
        <p class="mt-1 text-sm text-indigo-700">این لینک را فقط برای شخص موردنظر بفرستید؛ لینک ۷ روز اعتبار دارد.</p>
        <div class="mt-4 flex flex-col gap-2 sm:flex-row">
            <input id="invite-link" readonly value="@inviteLink" class="input direction-ltr flex-1 text-left" dir="ltr" />
            <button type="button" class="btn-primary" onclick="navigator.clipboard.writeText(document.getElementById('invite-link').value); this.textContent='کپی شد'">کپی لینک</button>
        </div>
    </section>
}

<div class="grid gap-6 xl:grid-cols-[23rem_1fr]">
    <section class="card h-fit">
        <h3 class="card-title">ساخت فضای مشترک</h3>
        <p class="muted mt-1">برای مدیریت مالی دو نفره یا خانوادگی</p>

        <form method="post" asp-page-handler="Create" class="mt-5 space-y-4">
            <div asp-validation-summary="ModelOnly"></div>
            <div>
                <label asp-for="CreateWorkspace.Name" class="label">نام فضا</label>
                <input asp-for="CreateWorkspace.Name" class="input" placeholder="مثلاً هزینه‌های خانه" />
                <span asp-validation-for="CreateWorkspace.Name" class="field-error"></span>
            </div>
            <div>
                <label asp-for="CreateWorkspace.MonthlySpendingLimit" class="label">مبلغ قابل خرج ماهانه (اختیاری)</label>
                <input asp-for="CreateWorkspace.MonthlySpendingLimit" type="text" inputmode="numeric" autocomplete="off" data-money class="input ltr-input" placeholder="مثلاً ۲۰,۰۰۰,۰۰۰" />
                <span asp-validation-for="CreateWorkspace.MonthlySpendingLimit" class="field-error"></span>
            </div>
            <button type="submit" class="btn-primary w-full">ساخت فضای مشترک</button>
        </form>

        <div class="mt-5 rounded-2xl bg-slate-50 p-4 text-sm leading-7 text-slate-600">
            هر کاربر فقط فضاهایی را می‌بیند که عضو آن‌هاست. اطلاعات شخصی با اطلاعات مشترک ترکیب نمی‌شود.
        </div>
    </section>

    <section class="space-y-5">
        @foreach (var card in Model.Workspaces)
        {
            <article class="card @(card.Workspace.Id == Model.CurrentWorkspaceId ? "ring-2 ring-indigo-500" : "")">
                <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
                    <div class="flex items-center gap-3">
                        <span class="grid size-12 place-items-center rounded-2xl @(card.Workspace.Type == WorkspaceType.Shared ? "bg-violet-100" : "bg-indigo-100") text-2xl">
                            @(card.Workspace.Type == WorkspaceType.Shared ? "♧" : "⌂")
                        </span>

                        <div>
                            <div class="flex flex-wrap items-center gap-2">
                                <h3 class="text-lg font-black">@card.Workspace.Name</h3>
                                @if (card.Workspace.Id == Model.CurrentWorkspaceId)
                                {
                                    <span class="badge">فعال</span>
                                }
                            </div>
                            <p class="mt-1 text-xs text-slate-500">
                                @(card.Workspace.Type == WorkspaceType.Shared ? "فضای مشترک" : "فضای شخصی")
                                · نقش شما: @(card.MyRole == WorkspaceRole.Owner ? "مالک" : "عضو")
                            </p>
                        </div>
                    </div>

                    <div class="flex flex-wrap gap-2">
                        @if (card.Workspace.Id != Model.CurrentWorkspaceId)
                        {
                            <form method="post" asp-page="/Workspaces/Switch">
                                <input type="hidden" name="workspaceId" value="@card.Workspace.Id" />
                                <input type="hidden" name="returnUrl" value="/Workspaces" />
                                <button type="submit" class="btn-secondary">انتخاب این فضا</button>
                            </form>
                        }

                        @if (card.MyRole == WorkspaceRole.Owner)
                        {
                            <details class="relative">
                                <summary class="btn-secondary cursor-pointer">مدیریت فضا</summary>
                                <div class="mt-3 rounded-2xl border border-slate-200 bg-slate-50 p-4">
                                    <form method="post" asp-page-handler="EditWorkspace" class="space-y-3">
                                        <input type="hidden" name="EditWorkspace.Id" value="@card.Workspace.Id" />

                                        <div>
                                            <label class="label">نام فضای مالی</label>
                                            <input name="EditWorkspace.Name"
                                                   value="@card.Workspace.Name"
                                                   class="input"
                                                   maxlength="100"
                                                   required />
                                        </div>

                                        <div>
                                            <label class="label">مبلغ قابل خرج ماهانه</label>
                                            <input name="EditWorkspace.MonthlySpendingLimit"
                                                   value="@card.Workspace.MonthlySpendingLimit"
                                                   type="text"
                                                   inputmode="numeric"
                                                   autocomplete="off"
                                                   data-money
                                                   class="input ltr-input"
                                                   placeholder="برای نامشخص خالی بگذارید" />
                                            <p class="mt-1 text-xs text-slate-500">سقف کلی هزینه ماهانه این فضا؛ مستقل از بودجه دسته‌ها</p>
                                        </div>

                                        <button type="submit" class="btn-primary w-full">ذخیره تنظیمات</button>
                                    </form>

                                    <div class="my-4 border-t border-slate-200"></div>

                                    <form method="post"
                                          asp-page-handler="DeleteWorkspace"
                                          asp-route-id="@card.Workspace.Id">
                                        <button type="submit"
                                                class="btn-secondary w-full text-rose-700"
                                                data-confirm="این فضای مالی و تمام مخارج، بودجه‌ها، دسته‌بندی‌ها و هدف‌های پس‌انداز آن برای همیشه حذف شود؟">
                                            حذف فضای مالی
                                        </button>
                                    </form>

                                    <p class="mt-2 text-xs leading-6 text-slate-500">
                                        حذف فضای مالی غیرقابل بازگشت است. آخرین فضای قابل‌دسترسی حساب حذف نمی‌شود.
                                    </p>
                                </div>
                            </details>
                        }
                    </div>
                </div>

                <div class="mt-5 grid gap-3 border-t border-slate-100 pt-5 sm:grid-cols-3">
                    <div class="rounded-2xl bg-emerald-50 p-4">
                        <span class="block text-xs font-bold text-emerald-700">مبلغ قابل خرج ماهانه</span>
                        <strong class="mt-2 block text-lg font-black text-emerald-900">
                            @(card.Workspace.MonthlySpendingLimit.HasValue ? Formatters.Money(card.Workspace.MonthlySpendingLimit.Value) : "تعیین نشده")
                        </strong>
                    </div>
                    <div class="rounded-2xl bg-indigo-50 p-4">
                        <span class="block text-xs font-bold text-indigo-700">مجموع بودجه‌های @Model.CurrentBudgetPeriodTitle</span>
                        <strong class="mt-2 block text-lg font-black text-indigo-900">@Formatters.Money(card.CurrentMonthBudgetTotal)</strong>
                    </div>
                    <div class="rounded-2xl bg-slate-50 p-4">
                        <span class="block text-xs text-slate-500">بودجه‌های ثبت‌شده</span>
                        <strong class="mt-2 block text-lg font-black">@card.CurrentMonthBudgetCount مورد</strong>
                    </div>
                </div>

                @if (card.Workspace.Type == WorkspaceType.Shared)
                {
                    <div class="mt-5 border-t border-slate-100 pt-5">
                        <h4 class="text-sm font-black">اعضا (@card.Members.Count)</h4>

                        <div class="mt-3 grid gap-2 sm:grid-cols-2">
                            @foreach (var member in card.Members)
                            {
                                <div class="flex items-center justify-between gap-2 rounded-2xl bg-slate-50 p-3">
                                    <div class="min-w-0">
                                        <p class="truncate text-sm font-bold">@member.DisplayName</p>
                                        <p class="truncate text-xs text-slate-500">
                                            @member.Email · @(member.Role == WorkspaceRole.Owner ? "مالک" : "عضو")
                                        </p>
                                    </div>

                                    @if (card.MyRole == WorkspaceRole.Owner && member.Role != WorkspaceRole.Owner)
                                    {
                                        <form method="post"
                                              asp-page-handler="RemoveMember"
                                              asp-route-workspaceId="@card.Workspace.Id"
                                              asp-route-userId="@member.UserId">
                                            <button type="submit"
                                                    class="text-xs font-bold text-rose-600"
                                                    data-confirm="این عضو از فضای مشترک حذف شود؟">
                                                حذف
                                            </button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>

                        @if (card.MyRole == WorkspaceRole.Owner)
                        {
                            <details class="mt-4 rounded-2xl border border-violet-100 bg-violet-50 p-4">
                                <summary class="cursor-pointer font-bold text-violet-800">＋ دعوت عضو جدید</summary>

                                <form method="post" asp-page-handler="Invite" class="mt-4 flex flex-col gap-3 sm:flex-row">
                                    <input type="hidden" name="Invite.WorkspaceId" value="@card.Workspace.Id" />

                                    <div class="flex-1">
                                        <input name="Invite.Email"
                                               value="@(Model.Invite.WorkspaceId == card.Workspace.Id ? Model.Invite.Email : "")"
                                               type="email"
                                               class="input"
                                               placeholder="email@example.com"
                                               dir="ltr" />
                                        <span asp-validation-for="Invite.Email" class="field-error"></span>
                                    </div>

                                    <button type="submit" class="btn-primary">ساخت لینک دعوت</button>
                                </form>
                            </details>
                        }
                    </div>
                }
            </article>
        }
    </section>
</div>
