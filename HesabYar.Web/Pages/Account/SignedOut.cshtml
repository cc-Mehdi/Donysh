@page
@{
    Layout = null;
}
<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>خروج انجام شد</title>
    <link rel="icon" type="image/png" href="~/images/donysh-mark.png" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="min-h-screen overflow-x-hidden bg-slate-50 text-slate-900">
    <main class="relative isolate flex min-h-screen items-center justify-center overflow-hidden px-5 py-10">
        <div class="absolute inset-x-0 top-0 -z-10 h-72 bg-gradient-to-b from-indigo-100 via-violet-50 to-transparent" aria-hidden="true"></div>
        <div class="absolute -right-24 top-16 -z-10 size-72 rounded-full bg-indigo-200/40 blur-3xl" aria-hidden="true"></div>
        <div class="absolute -left-24 bottom-12 -z-10 size-72 rounded-full bg-violet-200/40 blur-3xl" aria-hidden="true"></div>

        <section class="w-full max-w-lg rounded-3xl border border-white/80 bg-white/95 p-7 text-center shadow-2xl shadow-indigo-950/10 backdrop-blur sm:p-10">
            <div class="mb-8 flex justify-center">
                <partial name="_Brand" />
            </div>
            <div class="mx-auto mb-5 grid size-16 place-items-center rounded-2xl bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200 ring-inset" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="size-8" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m5 12 4 4L19 6" />
                </svg>
            </div>
            <p class="mx-auto mb-3 w-max rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">خروج امن انجام شد</p>
            <h1 class="text-2xl font-black tracking-tight sm:text-3xl">با موفقیت خارج شدید</h1>
            <p class="mx-auto mt-4 max-w-sm text-sm leading-8 text-slate-600">نشست شما در دُنیش مالی، دُنیش زندگی و حساب مرکزی بسته شد.</p>
            <a class="btn-primary mt-8 w-full" asp-page="/Account/Login">ورود دوباره به دُنیش</a>
            <p class="mt-5 text-xs leading-6 text-slate-400">برای حفظ امنیت حساب، پنجره‌های باز دُنیش نیز وضعیت خروج را دریافت می‌کنند.</p>
        </section>
    </main>
</body>
</html>
