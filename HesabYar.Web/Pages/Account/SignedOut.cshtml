@page
@{
    Layout = null;
}
<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>خروج انجام شد</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-slate-50 text-slate-900">
    <main class="mx-auto grid min-h-screen max-w-lg place-content-center px-5 text-center">
        <section class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
            <div class="mx-auto mb-4 grid size-14 place-items-center rounded-2xl bg-emerald-50 text-2xl text-emerald-700" aria-hidden="true">✓</div>
            <h1 class="text-2xl font-extrabold">با موفقیت خارج شدید</h1>
            <p class="mt-3 text-sm leading-7 text-slate-600">نشست شما در دونیش مالی، دونیش زندگی و حساب مرکزی بسته شد.</p>
            <a class="btn-primary mt-6 inline-flex" asp-page="/Account/Login">ورود دوباره</a>
        </section>
    </main>
</body>
</html>
