@page
@model IndexModel
@{
    ViewData["Title"] = "تنظیمات حساب";
}

<div class="mb-6">
    <h2 class="text-2xl font-black">تنظیمات حساب</h2>
    <p class="mt-1 text-sm text-slate-500">نامی که در Donysh و برای اعضای فضاهای مشترک نمایش داده می‌شود را ویرایش کنید.</p>
</div>

<div class="grid gap-6 xl:grid-cols-[23rem_1fr]">
    <section class="card max-w-2xl">
        <h3 class="card-title">ویرایش نام کاربری</h3>

        <form method="post" class="mt-5 space-y-4">
            <div asp-validation-summary="ModelOnly"></div>

            <div>
                <label asp-for="Input.DisplayName" class="label">نام کاربری</label>
                <input asp-for="Input.DisplayName" class="input" autocomplete="name" />
                <span asp-validation-for="Input.DisplayName" class="field-error"></span>
            </div>

            <button type="submit" class="btn-primary">ذخیره تغییرات</button>
        </form>
    </section>

    <aside class="card h-fit">
        <h3 class="card-title">اطلاعات ورود</h3>
        <p class="mt-3 text-xs text-slate-500">ایمیل حساب</p>
        <p class="mt-1 text-sm font-bold" dir="ltr">@Model.Email</p>
        <p class="mt-4 text-xs leading-6 text-slate-500">ورود به حساب همچنان با همین ایمیل انجام می‌شود و تغییر نام کاربری روی ورود شما اثری ندارد.</p>
    </aside>
</div>
