@page
@model IndexModel
@{
    ViewData["Title"] = "دسته‌بندی‌ها";
    var iconGroups = new[]
    {
        new { Name = "روزمره", Icons = new[] { "🍽️", "☕", "🛒", "🛍️", "🎁", "📦", "🧾", "💳" } },
        new { Name = "خانه و خانواده", Icons = new[] { "🏠", "🏡", "👨‍👩‍👧", "🧸", "🛋️", "🔧", "💡", "📱" } },
        new { Name = "رفت‌وآمد و سفر", Icons = new[] { "🚕", "🚗", "⛽", "🚌", "🚇", "✈️", "🏨", "🧳" } },
        new { Name = "سلامت و سبک زندگی", Icons = new[] { "💊", "🏥", "🩺", "🏋️", "⚽", "🎮", "🎬", "🎵" } },
        new { Name = "کار و پیشرفت", Icons = new[] { "🎓", "📚", "💻", "💼", "🛠️", "📈", "💰", "🏦" } }
    };
    var knownIcons = iconGroups.SelectMany(x => x.Icons).ToHashSet(StringComparer.Ordinal);
}
<div class="mb-6">
    <h2 class="text-2xl font-black">دسته‌بندی مخارج</h2>
    <p class="mt-1 text-sm text-slate-500">دسته‌ها مخصوص فضای مالی فعال هستند و در گزارش‌ها و بودجه‌ها استفاده می‌شوند.</p>
</div>

<div class="grid gap-6 xl:grid-cols-[22rem_1fr]">
    <section class="card h-fit">
        <h3 class="card-title">دسته جدید</h3>
        <form method="post" asp-page-handler="Save" class="mt-5 space-y-4" data-icon-picker>
            <div asp-validation-summary="ModelOnly"></div>
            <div>
                <label asp-for="Input.Name" class="label">نام دسته</label>
                <input asp-for="Input.Name" class="input" placeholder="مثلاً آموزش" />
                <span asp-validation-for="Input.Name" class="field-error"></span>
            </div>
            <div>
                <fieldset>
                    <legend class="label">انتخاب آیکن</legend>
                    <div class="max-h-72 space-y-4 overflow-y-auto rounded-2xl border border-slate-200 bg-slate-50 p-3">
                        @for (var groupIndex = 0; groupIndex < iconGroups.Length; groupIndex++)
                        {
                            var group = iconGroups[groupIndex];
                            <div>
                                <p class="mb-2 text-xs font-bold text-slate-500">@group.Name</p>
                                <div class="grid grid-cols-8 gap-1.5">
                                    @for (var iconIndex = 0; iconIndex < group.Icons.Length; iconIndex++)
                                    {
                                        var icon = group.Icons[iconIndex];
                                        var inputId = $"create-icon-{groupIndex}-{iconIndex}";
                                        <label for="@inputId" class="group grid aspect-square cursor-pointer place-items-center rounded-xl border border-slate-200 bg-white text-xl transition hover:border-indigo-300 hover:bg-indigo-50 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-100 has-[:checked]:ring-2 has-[:checked]:ring-indigo-200">
                                            <input id="@inputId" type="radio" name="Input.Icon" value="@icon" checked="@(Model.Input.Icon == icon)" class="sr-only" data-icon-choice />
                                            <span>@icon</span>
                                        </label>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </fieldset>
                <div class="mt-3">
                    <label asp-for="Input.CustomIcon" class="label">یا ایموجی دلخواه</label>
                    <input asp-for="Input.CustomIcon" class="input text-center text-xl" maxlength="16" placeholder="مثلاً 🐾" data-icon-custom />
                    <p class="mt-1 text-xs text-slate-500">فقط یک ایموجی یا کاراکتر نمایشی مجاز است.</p>
                    <span asp-validation-for="Input.Icon" class="field-error"></span>
                    <span asp-validation-for="Input.CustomIcon" class="field-error"></span>
                </div>
            </div>
            <button class="btn-primary w-full" type="submit">افزودن دسته</button>
        </form>
    </section>

    <section>
        @if (Model.Items.Count == 0)
        {
            <div class="empty"><div class="text-5xl">◫</div><h3 class="mt-4 font-bold">دسته‌ای وجود ندارد</h3></div>
        }
        else
        {
            <div class="grid gap-4 md:grid-cols-2">
                @foreach (var row in Model.Items)
                {
                    <article class="card @(row.Category.IsArchived ? "opacity-60" : "")">
                        <div class="mb-4 flex items-start justify-between gap-3">
                            <div class="flex items-center gap-3">
                                <span class="grid size-12 place-items-center rounded-2xl bg-slate-100 text-2xl">@row.Category.Icon</span>
                                <div><h3 class="font-black">@row.Category.Name</h3><p class="mt-1 text-xs text-slate-500">@row.ExpenseCount خرج · @Formatters.Money(row.TotalSpent)</p></div>
                            </div>
                            @if (row.Category.IsArchived) { <span class="rounded-full bg-slate-100 px-2 py-1 text-[11px] font-bold text-slate-600">بایگانی</span> }
                        </div>

                        @if (!row.Category.IsArchived)
                        {
                            <details class="group">
                                <summary class="cursor-pointer text-sm font-bold text-indigo-700">ویرایش دسته</summary>
                                <form method="post" asp-page-handler="Save" class="mt-4 space-y-3" data-icon-picker>
                                    <input type="hidden" name="Input.Id" value="@row.Category.Id" />
                                    <input name="Input.Name" value="@row.Category.Name" class="input" aria-label="نام دسته" />
                                    <fieldset>
                                        <legend class="mb-2 text-xs font-bold text-slate-500">انتخاب آیکن</legend>
                                        <div class="grid grid-cols-8 gap-1.5 rounded-2xl bg-slate-50 p-2">
                                            @for (var groupIndex = 0; groupIndex < iconGroups.Length; groupIndex++)
                                            {
                                                var group = iconGroups[groupIndex];
                                                @for (var iconIndex = 0; iconIndex < group.Icons.Length; iconIndex++)
                                                {
                                                    var icon = group.Icons[iconIndex];
                                                    var inputId = $"edit-{row.Category.Id}-icon-{groupIndex}-{iconIndex}";
                                                    <label for="@inputId" class="grid aspect-square cursor-pointer place-items-center rounded-xl border border-slate-200 bg-white text-lg transition hover:border-indigo-300 hover:bg-indigo-50 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-100 has-[:checked]:ring-2 has-[:checked]:ring-indigo-200">
                                                        <input id="@inputId" type="radio" name="Input.Icon" value="@icon" checked="@(row.Category.Icon == icon)" class="sr-only" data-icon-choice />
                                                        <span>@icon</span>
                                                    </label>
                                                }
                                            }
                                        </div>
                                    </fieldset>
                                    <input name="Input.CustomIcon" value="@(knownIcons.Contains(row.Category.Icon) ? "" : row.Category.Icon)" class="input text-center text-xl" maxlength="16" placeholder="ایموجی دلخواه" aria-label="ایموجی دلخواه" data-icon-custom />
                                    <p class="text-xs text-slate-500">فقط یک ایموجی یا کاراکتر نمایشی</p>
                                    <button type="submit" class="btn-soft w-full">ذخیره تغییرات</button>
                                </form>
                            </details>
                            <form method="post" asp-page-handler="Archive" asp-route-id="@row.Category.Id" class="mt-3">
                                <button type="submit" class="text-xs font-bold text-rose-600" data-confirm="این دسته بایگانی شود؟ مخارج قبلی حذف نمی‌شوند.">بایگانی دسته</button>
                            </form>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="Restore" asp-route-id="@row.Category.Id">
                                <button type="submit" class="btn-secondary w-full">فعال‌سازی دوباره</button>
                            </form>
                        }
                    </article>
                }
            </div>
        }
    </section>
</div>
