@page
@model HesabYar.Web.Pages.Obligations.IndexModel
@{
    ViewData["Title"] = "اقساط و هزینه‌های ثابت";
}

<div class="mb-6 flex flex-col justify-between gap-3 lg:flex-row lg:items-end">
    <div>
        <h2 class="text-2xl font-black">تعهدات ماهانه</h2>
        <p class="mt-1 text-sm text-slate-500">قسط‌ها و هزینه‌های ثابت را یک‌بار تعریف کنید؛ Donysh سررسید، پرداخت و مبلغ باقی‌مانده هر ماه را برایتان پیگیری می‌کند.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
        <button type="button" class="btn-primary" data-open-obligation="obligation-create-dialog">＋ تعریف تعهد</button>
        <a asp-page="Index" asp-route-year="@Model.PreviousPeriod.Year" asp-route-month="@Model.PreviousPeriod.Month" class="btn-secondary px-3">→</a>
        <span class="min-w-36 text-center font-black">@Model.PeriodTitle</span>
        <a asp-page="Index" asp-route-year="@Model.NextPeriod.Year" asp-route-month="@Model.NextPeriod.Month" class="btn-secondary px-3">←</a>
    </div>
</div>

<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <section class="stat">
        <span class="stat-label">تعهد این ماه</span>
        <div class="stat-value">@Formatters.Money(Model.MonthExpectedTotal)</div>
        <p class="mt-2 text-xs text-slate-500">مجموع قسط‌ها و هزینه‌های ثابت برنامه‌ریزی‌شده</p>
    </section>
    <section class="stat">
        <span class="stat-label">پرداخت‌شده</span>
        <div class="stat-value text-emerald-700">@Formatters.Money(Model.MonthPaidTotal)</div>
        <p class="mt-2 text-xs text-slate-500">پرداخت‌های ثبت‌شده به‌صورت خودکار وارد مخارج می‌شوند</p>
    </section>
    <section class="stat">
        <span class="stat-label">باقی‌مانده پرداخت</span>
        <div class="stat-value @(Model.MonthUnpaidTotal > 0 ? "text-amber-700" : "text-emerald-700")">@Formatters.Money(Model.MonthUnpaidTotal)</div>
        <p class="mt-2 text-xs text-slate-500">@Model.UnpaidCount مورد هنوز پرداخت نشده</p>
    </section>
    <section class="stat">
        <span class="stat-label">اعلان‌های مهم</span>
        <div class="stat-value @(Model.AlertCount > 0 ? "text-rose-700" : "text-emerald-700")">@Model.AlertCount مورد</div>
        <p class="mt-2 text-xs text-slate-500">سررسید نزدیک یا پرداخت عقب‌افتاده</p>
    </section>
</div>

<dialog id="obligation-create-dialog" class="obligation-dialog" aria-labelledby="obligation-create-title" data-obligation-error="@(!ViewData.ModelState.IsValid && !Model.Input.Id.HasValue ? "true" : null)">
    <section class="obligation-dialog-content">
        <div class="obligation-dialog-heading"><div><h3 id="obligation-create-title" class="card-title">تعریف تعهد جدید</h3><p class="muted mt-1">قسط یا هزینهٔ ثابت را برای پیگیری ماهانه تعریف کنید.</p></div><button type="button" class="obligation-dialog-close" data-close-obligation aria-label="بستن پنجره">×</button></div>
        <p class="muted mt-1">برای قسط مدت مشخص کنید؛ هزینه ثابت تا زمانی که متوقفش کنید هر ماه تکرار می‌شود.</p>
        <form method="post" asp-page-handler="Save" class="mt-5 space-y-4" data-obligation-form>
            <div asp-validation-summary="ModelOnly"></div>
            <div>
                <label asp-for="Input.Title" class="label">عنوان</label>
                <input asp-for="Input.Title" class="input" placeholder="مثلاً بیمه خودرو یا اینترنت مودم" />
                <span asp-validation-for="Input.Title" class="field-error"></span>
            </div>
            <div>
                <label asp-for="Input.Type" class="label">نوع</label>
                <select asp-for="Input.Type" class="input" data-obligation-type>
                    <option value="1">قسط با مدت مشخص</option>
                    <option value="2">هزینه ثابت ماهانه</option>
                </select>
            </div>
            <div>
                <label asp-for="Input.CategoryId" class="label">دسته هزینه</label>
                <select asp-for="Input.CategoryId" class="input">
                    <option value="">انتخاب دسته</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id">@category.Icon @category.Name</option>
                    }
                </select>
                <span asp-validation-for="Input.CategoryId" class="field-error"></span>
            </div>
            <div>
                <label asp-for="Input.Amount" class="label">مبلغ ماهانه (تومان)</label>
                <input asp-for="Input.Amount" type="text" inputmode="numeric" autocomplete="off" data-money class="input ltr-input" />
                <span asp-validation-for="Input.Amount" class="field-error"></span>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label asp-for="Input.StartYear" class="label">سال شروع</label>
                    <input asp-for="Input.StartYear" type="number" class="input" />
                </div>
                <div>
                    <label asp-for="Input.StartMonth" class="label">ماه شروع</label>
                    <input asp-for="Input.StartMonth" type="number" min="1" max="12" class="input" />
                </div>
            </div>
            <div data-obligation-duration>
                <label asp-for="Input.DurationMonths" class="label">تعداد ماه برای قسط</label>
                <input asp-for="Input.DurationMonths" type="number" min="1" class="input" placeholder="مثلاً ۱۰" data-obligation-duration-input />
                <span asp-validation-for="Input.DurationMonths" class="field-error"></span>
                <p class="mt-1 text-xs text-slate-500">برای هزینه ثابت خالی بگذارید.</p>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label asp-for="Input.DueDay" class="label">روز سررسید</label>
                    <input asp-for="Input.DueDay" type="number" min="1" max="31" class="input" />
                </div>
                <div>
                    <label asp-for="Input.ReminderDaysBefore" class="label">یادآوری چند روز قبل</label>
                    <input asp-for="Input.ReminderDaysBefore" type="number" min="0" max="30" class="input" />
                </div>
            </div>
            <div>
                <label asp-for="Input.Note" class="label">توضیحات (اختیاری)</label>
                <textarea asp-for="Input.Note" rows="3" class="input" placeholder="شماره قرارداد، توضیح پرداخت و ..."></textarea>
            </div>
            <div class="flex gap-2"><button type="button" class="btn-secondary" data-close-obligation>انصراف</button><button type="submit" class="btn-primary flex-1">ذخیرهٔ تعهد</button></div>
        </form>
    </section>
</dialog>

<div class="mt-6">
    <section class="space-y-4">
        @if (Model.Items.Count == 0)
        {
            <div class="empty">
                <div class="text-5xl">◷</div>
                <h3 class="mt-4 text-lg font-bold">برای @Model.PeriodTitle تعهدی ندارید</h3>
                <p class="mt-1 text-sm text-slate-500">با دکمهٔ «تعریف تعهد» اولین قسط یا هزینهٔ ثابت را اضافه کنید.</p>
            </div>
        }
        else
        {
            @foreach (var row in Model.Items)
            {
                <article class="card @(row.IsOverdue ? "border-rose-200" : row.IsDueSoon ? "border-amber-200" : "")">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div class="flex items-start gap-3">
                            <span class="grid size-12 place-items-center rounded-2xl bg-slate-100 text-2xl">@row.Obligation.Category.Icon</span>
                            <div>
                                <div class="flex flex-wrap items-center gap-2">
                                    <h3 class="font-black">@row.Obligation.Title</h3>
                                    <span class="rounded-full px-2 py-1 text-[11px] font-black @row.StatusClass">@row.StatusText</span>
                                </div>
                                <p class="mt-1 text-xs text-slate-500">
                                    @(row.Obligation.Type == RecurringObligationType.Installment ? "قسط" : "هزینه ثابت") · @row.Obligation.Category.Name · سررسید @Formatters.PersianDate(row.DueDate)
                                </p>
                                @if (row.InstallmentNumber.HasValue)
                                {
                                    <p class="mt-1 text-xs text-indigo-700">قسط @row.InstallmentNumber از @row.Obligation.DurationMonths · @(row.RemainingInstallments ?? 0) قسط بعد از این ماه باقی می‌ماند</p>
                                }
                            </div>
                        </div>
                        <strong class="text-lg">@Formatters.Money(row.ExpectedAmount)</strong>
                    </div>

                    <div class="mt-4 grid grid-cols-3 gap-2 rounded-2xl bg-slate-50 p-3 text-center">
                        <div><span class="block text-[11px] text-slate-500">مورد انتظار</span><strong class="text-sm">@Formatters.Money(row.ExpectedAmount)</strong></div>
                        <div><span class="block text-[11px] text-slate-500">پرداخت‌شده</span><strong class="text-sm text-emerald-700">@Formatters.Money(row.PaidAmount)</strong></div>
                        <div><span class="block text-[11px] text-slate-500">باقی‌مانده</span><strong class="text-sm @(row.RemainingAmount > 0 ? "text-amber-700" : "text-emerald-700")">@Formatters.Money(row.RemainingAmount)</strong></div>
                        <div class="col-span-3 mt-1 h-2 overflow-hidden rounded-full bg-slate-200" role="progressbar" aria-label="درصد پرداخت" aria-valuenow="@row.ProgressPercent" aria-valuemin="0" aria-valuemax="100">
                            <div class="h-full rounded-full @(row.IsOverpaid ? "bg-violet-500" : "bg-emerald-500")" style="width: @row.ProgressPercent.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        </div>
                    </div>

                    @if (!row.IsPaid || row.Obligation.Type == RecurringObligationType.FixedMonthlyExpense)
                    {
                        <div class="finance-obligation-payment mt-3 rounded-2xl @(row.IsOverdue ? "bg-rose-50" : row.IsDueSoon ? "bg-amber-50" : "bg-indigo-50/60") p-4">
                            @if (row.IsOverdue)
                            {
                                <p class="mb-3 text-sm font-bold text-rose-700">این پرداخت از سررسید گذشته و هنوز ثبت نشده است.</p>
                            }
                            else if (row.IsDueSoon)
                            {
                                <p class="mb-3 text-sm font-bold text-amber-700">@row.DaysUntilDue روز تا سررسید باقی مانده است.</p>
                            }
                            <form method="post" asp-page-handler="Pay" class="grid gap-3 md:grid-cols-[1fr_1fr_1.2fr_auto] md:items-end" data-payment-form>
                                <input type="hidden" name="Payment.ObligationId" value="@row.Obligation.Id" />
                                <input type="hidden" name="Payment.SubmissionKey" value="@Guid.NewGuid()" />
                                <input type="hidden" name="Payment.Year" value="@Model.Year" />
                                <input type="hidden" name="Payment.Month" value="@Model.Month" />
                                <div>
                                    <label class="label">مبلغ این پرداخت</label>
                                    <input name="Payment.Amount" value="@(row.RemainingAmount > 0 ? row.RemainingAmount.ToString("0") : "")" data-money inputmode="numeric" class="input ltr-input" placeholder="مبلغ را وارد کنید" required />
                                </div>
                                <div>
                                    <label class="label">تاریخ پرداخت</label>
                                    <input name="Payment.PaidDate" value="@Model.DefaultPaidDate" data-persian-date inputmode="numeric" class="input ltr-input" required />
                                </div>
                                <div>
                                    <label class="label">توضیح (اختیاری)</label>
                                    <input name="Payment.Note" maxlength="200" class="input" placeholder="مثلاً پرداخت از کارت ..." />
                                </div>
                                <button type="submit" class="btn-primary" data-payment-submit>ثبت این پرداخت</button>
                            </form>
                            @if (row.Obligation.Type == RecurringObligationType.Installment)
                            {
                                <p class="mt-2 text-[11px] text-indigo-700">می‌توانید مانده @Formatters.Money(row.RemainingAmount) را در چند پرداخت ثبت کنید؛ مجموع پرداخت‌ها از مانده بیشتر نمی‌شود.</p>
                            }
                            else
                            {
                                <p class="mt-2 text-[11px] text-indigo-700">مبلغ این هزینه یک برآورد ماهانه است؛ در صورت نیاز می‌توانید چند پرداخت یا مبلغ بیشتر ثبت کنید.</p>
                            }
                            <p class="mt-2 text-[11px] text-slate-500">با ثبت پرداخت، یک خرج واقعی در دسته «@row.Obligation.Category.Name» هم ایجاد می‌شود تا بودجه و گزارش‌ها دقیق بمانند.</p>
                        </div>
                    }

                    @if (row.Payments.Count > 0)
                    {
                        <details class="mt-3 rounded-2xl border border-slate-200 bg-white p-4" open="@(row.IsPartiallyPaid ? "open" : null)">
                            <summary class="cursor-pointer text-sm font-black text-slate-700">سابقه پرداخت‌های این ماه (@row.Payments.Count مورد)</summary>
                            <div class="mt-3 divide-y divide-slate-100">
                                @foreach (var payment in row.Payments)
                                {
                                    <div class="flex flex-wrap items-center justify-between gap-3 py-3">
                                        <div>
                                            <strong class="text-sm text-emerald-700">@Formatters.Money(payment.Amount)</strong>
                                            <p class="mt-1 text-xs text-slate-500">@Formatters.PersianDate(payment.PaidDate) · ثبت‌کننده: @payment.PaidBy</p>
                                            @if (!string.IsNullOrWhiteSpace(payment.Note))
                                            {
                                                <p class="mt-1 text-xs text-slate-600">@payment.Note</p>
                                            }
                                        </div>
                                        <form method="post" asp-page-handler="UndoPayment" asp-route-paymentId="@payment.Id" asp-route-year="@Model.Year" asp-route-month="@Model.Month">
                                            <button type="submit" class="text-xs font-bold text-rose-600" data-confirm="این پرداخت و خرج مرتبط با آن حذف شود؟">حذف این پرداخت</button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </details>
                    }
                </article>
            }
        }
    </section>
</div>

<section class="card mt-6">
    <div class="mb-5 flex flex-col justify-between gap-2 sm:flex-row sm:items-end">
        <div>
            <h3 class="card-title">مدیریت قسط‌ها و هزینه‌های ثابت</h3>
            <p class="muted mt-1">قوانین تکرارشونده را ویرایش یا متوقف کنید. موارد دارای سابقه پرداخت حذف نمی‌شوند تا گزارش مالی سالم بماند.</p>
        </div>
        <span class="badge">@Model.Definitions.Count مورد</span>
    </div>

    @if (Model.Definitions.Count == 0)
    {
        <p class="rounded-2xl bg-slate-50 p-5 text-center text-sm text-slate-500">تعهدی تعریف نشده است.</p>
    }
    else
    {
        <div class="grid gap-4 lg:grid-cols-2">
            @foreach (var item in Model.Definitions)
            {
                var editInput = !ViewData.ModelState.IsValid && Model.Input.Id == item.Id ? Model.Input : null;
                <article class="rounded-2xl border border-slate-200 p-4 @(item.IsActive ? "bg-white" : "bg-slate-50")">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <div class="flex flex-wrap items-center gap-2">
                                <strong>@item.Category.Icon @item.Title</strong>
                                <span class="badge">@(item.Type == RecurringObligationType.Installment ? $"قسط {item.DurationMonths} ماهه" : "هزینه ثابت")</span>
                                @if (!item.IsActive)
                                {
                                    <span class="rounded-full bg-slate-200 px-2 py-1 text-[11px] font-bold text-slate-600">متوقف</span>
                                }
                            </div>
                            <p class="mt-2 text-xs text-slate-500">@Formatters.Money(item.Amount) · سررسید روز @item.DueDay · یادآوری @item.ReminderDaysBefore روز قبل</p>
                        </div>
                        <form method="post" asp-page-handler="Toggle" asp-route-id="@item.Id" asp-route-year="@Model.Year" asp-route-month="@Model.Month">
                            <button type="submit" class="text-xs font-bold @(item.IsActive ? "text-amber-700" : "text-emerald-700")">@(item.IsActive ? "توقف" : "فعال‌سازی")</button>
                        </form>
                    </div>

                    <button type="button" class="btn-soft mt-4" data-open-obligation="obligation-edit-@item.Id" aria-label="ویرایش @item.Title">ویرایش تعهد</button>
                    <dialog id="obligation-edit-@item.Id" class="obligation-dialog" aria-labelledby="obligation-edit-title-@item.Id" data-obligation-error="@(!ViewData.ModelState.IsValid && Model.Input.Id == item.Id ? "true" : null)">
                        <div class="obligation-dialog-content">
                        <div class="obligation-dialog-heading"><div><h3 id="obligation-edit-title-@item.Id" class="card-title">ویرایش @item.Title</h3><p class="muted mt-1">تغییرها روی تعهدهای آینده اعمال می‌شوند.</p></div><button type="button" class="obligation-dialog-close" data-close-obligation aria-label="بستن پنجره">×</button></div>
                        <form method="post" asp-page-handler="Save" class="mt-4 grid gap-3 sm:grid-cols-2" data-obligation-form>
                            <input type="hidden" name="Input.Id" value="@item.Id" />
                            @if (!ViewData.ModelState.IsValid && Model.Input.Id == item.Id) { <div class="sm:col-span-2" asp-validation-summary="All"></div> }
                            <div class="sm:col-span-2">
                                <label class="label">عنوان</label>
                                <input name="Input.Title" value="@(editInput?.Title ?? item.Title)" class="input" />
                            </div>
                            <div>
                                <label class="label">نوع</label>
                                <select name="Input.Type" class="input" data-obligation-type>
                                    <option value="1" selected="@((editInput?.Type ?? item.Type) == RecurringObligationType.Installment)">قسط</option>
                                    <option value="2" selected="@((editInput?.Type ?? item.Type) == RecurringObligationType.FixedMonthlyExpense)">هزینه ثابت</option>
                                </select>
                            </div>
                            <div>
                                <label class="label">دسته</label>
                                <select name="Input.CategoryId" class="input">
                                    @foreach (var category in Model.Categories)
                                    {
                                        <option value="@category.Id" selected="@(category.Id == (editInput?.CategoryId ?? item.CategoryId))">@category.Icon @category.Name</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="label">مبلغ</label>
                                <input name="Input.Amount" value="@((editInput?.Amount ?? item.Amount).ToString("0"))" data-money class="input ltr-input" />
                            </div>
                            <div class="rounded-2xl bg-indigo-50 p-3" data-obligation-duration>
                                <label class="label">تعداد اقساط (ماه)</label>
                                <input name="Input.DurationMonths" value="@(editInput?.DurationMonths ?? item.DurationMonths)" type="number" min="1" class="input" data-obligation-duration-input />
                                <p class="mt-1 text-xs text-indigo-700">تعداد کل ماه‌های این قسط را وارد کنید.</p>
                            </div>
                            <div>
                                <label class="label">سال شروع</label>
                                <input name="Input.StartYear" value="@(editInput?.StartYear ?? item.StartYear)" type="number" class="input" />
                            </div>
                            <div>
                                <label class="label">ماه شروع</label>
                                <input name="Input.StartMonth" value="@(editInput?.StartMonth ?? item.StartMonth)" type="number" min="1" max="12" class="input" />
                            </div>
                            <div>
                                <label class="label">روز سررسید</label>
                                <input name="Input.DueDay" value="@(editInput?.DueDay ?? item.DueDay)" type="number" min="1" max="31" class="input" />
                            </div>
                            <div>
                                <label class="label">یادآوری قبل از سررسید</label>
                                <input name="Input.ReminderDaysBefore" value="@(editInput?.ReminderDaysBefore ?? item.ReminderDaysBefore)" type="number" min="0" max="30" class="input" />
                            </div>
                            <div class="sm:col-span-2">
                                <label class="label">توضیحات</label>
                                <textarea name="Input.Note" rows="2" class="input">@(editInput?.Note ?? item.Note)</textarea>
                            </div>
                            <div class="flex gap-2 sm:col-span-2"><button type="button" class="btn-secondary" data-close-obligation>انصراف</button><button type="submit" class="btn-primary flex-1">ذخیرهٔ تغییرات</button></div>
                        </form>
                        </div>
                    </dialog>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="mt-3">
                        <button type="submit" class="text-xs font-bold text-rose-600" data-confirm="این تعهد حذف شود؟">حذف</button>
                    </form>
                </article>
            }
        </div>
    }
</section>
