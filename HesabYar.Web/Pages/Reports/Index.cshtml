@page
@model IndexModel
@{
    ViewData["Title"] = "گزارش‌ها";
    var anchorValue = FormValueHelper.RawOrPersianDate(ViewData, "Anchor", Model.Anchor ?? DateOnly.FromDateTime(DateTime.Now));
}
<div class="mb-6 flex flex-col justify-between gap-4 lg:flex-row lg:items-end">
    <div><h2 class="text-2xl font-black">گزارش مالی</h2><p class="mt-1 text-sm text-slate-500">تحلیل مخارج و مشاهده سهم هزینه و پس‌انداز اعضای فضای فعال</p></div>
    <div class="flex flex-wrap items-end gap-2">
        <form method="get" class="flex flex-wrap items-end gap-2">
            <div><label asp-for="Period" class="label">نوع گزارش</label><select asp-for="Period" class="input min-w-32"><option value="daily">روزانه</option><option value="weekly">هفتگی</option><option value="monthly">ماهانه</option><option value="yearly">سالانه</option></select></div>
            <div><label asp-for="Anchor" class="label">تاریخ مبنا</label><input id="Anchor" name="Anchor" value="@anchorValue" type="text" inputmode="numeric" autocomplete="off" data-persian-date class="input ltr-input" placeholder="۱۴۰۵/۰۵/۰۸" /></div>
            <button type="submit" class="btn-primary">نمایش</button>
        </form>
    </div>
</div>

<div class="mb-5 flex items-center justify-between rounded-2xl border border-slate-200 bg-white p-3">
    <a asp-page="Index" asp-route-period="@Model.Period" asp-route-anchor="@Model.PreviousAnchor.ToString("yyyy-MM-dd")" class="btn-secondary px-3">→ قبلی</a>
    <strong class="px-3 text-center">@Model.PeriodTitle</strong>
    <a asp-page="Index" asp-route-period="@Model.Period" asp-route-anchor="@Model.NextAnchor.ToString("yyyy-MM-dd")" class="btn-secondary px-3">بعدی ←</a>
</div>

<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <section class="stat"><span class="stat-label">مجموع مخارج</span><div class="stat-value">@Formatters.Money(Model.Total)</div></section>
    <section class="stat"><span class="stat-label">تعداد مخارج</span><div class="stat-value">@Model.ExpenseCount</div><p class="mt-2 text-xs text-slate-500">تراکنش در این بازه</p></section>
    <section class="stat"><span class="stat-label">میانگین روزانه</span><div class="stat-value">@Formatters.Money(Model.AveragePerDay)</div></section>
    <section class="stat"><span class="stat-label">بیشترین دسته</span><div class="stat-value text-xl">@(Model.TopCategory is null ? "—" : $"{Model.TopCategory.Icon} {Model.TopCategory.Name}")</div>@if(Model.TopCategory is not null){<p class="mt-2 text-xs text-slate-500">@Formatters.Money(Model.TopCategory.Amount)</p>}</section>
</div>

<div class="mt-6 grid gap-6 xl:grid-cols-[1.25fr_.75fr]">
    <section class="card overflow-hidden">
        <div class="mb-6"><h3 class="card-title">روند هزینه</h3><p class="muted mt-1">مقایسه مبلغ خرج در طول بازه انتخابی</p></div>
        @if (Model.Total == 0)
        {
            <div class="empty border-0 bg-slate-50"><p class="text-sm text-slate-500">داده‌ای برای نمایش وجود ندارد.</p></div>
        }
        else
        {
            <div class="flex h-72 items-end gap-1 overflow-x-auto border-b border-slate-200 pb-2">
                @foreach (var point in Model.Trend)
                {
                    var height = Model.MaxTrendAmount <= 0 ? 0 : Math.Max(point.Amount / Model.MaxTrendAmount * 100, point.Amount > 0 ? 4 : 0);
                    <div class="group flex min-w-8 flex-1 flex-col items-center justify-end gap-2" title="@point.Label: @Formatters.Money(point.Amount)">
                        <div class="hidden text-[10px] font-bold text-slate-600 group-hover:block">@point.Amount.ToString("N0")</div>
                        <div class="w-full max-w-12 rounded-t-lg bg-indigo-500 transition hover:bg-indigo-700" style="height: @(height)%"></div>
                        <span class="text-[10px] text-slate-500">@point.Label</span>
                    </div>
                }
            </div>
        }
    </section>

    <section class="card">
        <div class="mb-5"><h3 class="card-title">سهم دسته‌ها</h3><p class="muted mt-1">مخارج به تفکیک دسته‌بندی</p></div>
        @if (Model.Categories.Count == 0)
        {
            <p class="rounded-2xl bg-slate-50 p-6 text-center text-sm text-slate-500">دسته‌ای برای نمایش نیست.</p>
        }
        else
        {
            <div class="space-y-5">
                @foreach (var category in Model.Categories)
                {
                    <div>
                        <div class="mb-2 flex items-center justify-between gap-3"><div class="flex items-center gap-2"><span>@category.Icon</span><strong class="text-sm">@category.Name</strong></div><span class="text-xs font-bold text-indigo-700">@Formatters.Percent(category.Percent)</span></div>
                        <div class="progress"><div class="progress-bar" style="width: @(category.Percent)%"></div></div>
                        <div class="mt-2 flex justify-between text-xs text-slate-500"><span>@category.Count مورد</span><span>@Formatters.Money(category.Amount)</span></div>
                    </div>
                }
            </div>
        }
    </section>
</div>

<section class="card mt-6">
    <div class="mb-5 flex flex-col justify-between gap-2 sm:flex-row sm:items-end">
        <div>
            <h3 class="card-title">اقساط و هزینه‌های ثابت @Model.MemberMonthTitle</h3>
            <p class="muted mt-1">وضعیت تعهدات ماهانه برای تشخیص پرداخت‌های انجام‌شده، باقی‌مانده و موارد عقب‌افتاده</p>
        </div>
        <div class="flex flex-wrap gap-2 text-xs">
            <span class="badge">تعهد @Formatters.Money(Model.MonthlyObligationExpected)</span>
            <span class="badge">پرداخت @Formatters.Money(Model.MonthlyObligationPaid)</span>
            <span class="badge">باقی‌مانده @Formatters.Money(Model.MonthlyObligationUnpaid)</span>
        </div>
    </div>
    @if (Model.MonthlyObligations.Count == 0)
    {
        <p class="rounded-2xl bg-slate-50 p-5 text-center text-sm text-slate-500">برای این ماه قسط یا هزینه ثابت فعالی وجود ندارد.</p>
    }
    else
    {
        <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
            @foreach (var item in Model.MonthlyObligations)
            {
                <article class="rounded-2xl border @(item.IsPaid ? "border-emerald-200 bg-emerald-50" : item.Status == "عقب‌افتاده" ? "border-rose-200 bg-rose-50" : "border-slate-200 bg-slate-50") p-4">
                    <div class="flex items-start justify-between gap-3">
                        <div><strong>@item.CategoryIcon @item.Title</strong><p class="mt-1 text-xs text-slate-500">@item.CategoryName · سررسید @Formatters.PersianDate(item.DueDate)</p></div>
                        <span class="badge">@item.Status</span>
                    </div>
                    <div class="mt-3 flex items-center justify-between text-sm"><span>مبلغ برنامه‌ریزی‌شده</span><strong>@Formatters.Money(item.ExpectedAmount)</strong></div>
                    @if (item.IsPaid)
                    {
                        <div class="mt-2 flex items-center justify-between text-xs text-emerald-800"><span>پرداخت واقعی @Formatters.PersianDate(item.PaidDate!.Value)</span><strong>@Formatters.Money(item.PaidAmount)</strong></div>
                    }
                </article>
            }
        </div>
    }
</section>

<section class="card mt-6">
    <div class="mb-5 flex flex-col justify-between gap-2 sm:flex-row sm:items-end">
        <div>
            <h3 class="card-title">تاریخچه انتقال بودجه</h3>
            <p class="muted mt-1">تمام قرض‌ها و جابه‌جایی‌های بودجه در بازه انتخابی، با تاریخ، مبلغ، مبدا، مقصد و ثبت‌کننده</p>
        </div>
        <span class="badge">@Model.BudgetTransfers.Count انتقال</span>
    </div>

    @if (Model.BudgetTransfers.Count == 0)
    {
        <p class="rounded-2xl bg-slate-50 p-5 text-center text-sm text-slate-500">در این بازه انتقال بودجه‌ای ثبت نشده است.</p>
    }
    else
    {
        <div class="hidden md:block table-wrap">
            <table class="table">
                <thead><tr><th>تاریخ</th><th>بودجه مبدا</th><th>بودجه مقصد</th><th>مبلغ</th><th>ثبت‌کننده</th><th>توضیح</th></tr></thead>
                <tbody>
                @foreach (var item in Model.BudgetTransfers)
                {
                    <tr>
                        <td class="text-slate-500">@Formatters.PersianDate(item.TransferDate)</td>
                        <td class="font-bold">@item.SourceIcon @item.SourceName</td>
                        <td class="font-bold">@item.DestinationIcon @item.DestinationName</td>
                        <td class="font-black text-indigo-700">@Formatters.Money(item.Amount)</td>
                        <td class="text-slate-500">@item.CreatedBy</td>
                        <td class="text-slate-500">@(string.IsNullOrWhiteSpace(item.Note) ? "—" : item.Note)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="space-y-3 md:hidden">
            @foreach (var item in Model.BudgetTransfers)
            {
                <article class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                    <div class="flex items-center justify-between gap-3">
                        <strong class="text-indigo-700">@Formatters.Money(item.Amount)</strong>
                        <span class="text-xs text-slate-500">@Formatters.PersianDate(item.TransferDate)</span>
                    </div>
                    <p class="mt-3 text-sm font-bold">@item.SourceIcon @item.SourceName ← @item.DestinationIcon @item.DestinationName</p>
                    <p class="mt-2 text-xs text-slate-500">ثبت توسط @item.CreatedBy@(string.IsNullOrWhiteSpace(item.Note) ? "" : $" · {item.Note}")</p>
                </article>
            }
        </div>
    }
</section>

<section class="card mt-6">
    <div class="mb-5 flex flex-col justify-between gap-2 sm:flex-row sm:items-end">
        <div>
            <h3 class="card-title">عملکرد اعضا در این ماه</h3>
            <p class="muted mt-1">خرج‌ها، دسته‌بندی هزینه و واریزی‌های پس‌انداز هر شخص در @Model.MemberMonthTitle</p>
        </div>
        <span class="badge">@Model.Members.Count نفر</span>
    </div>

    @if (Model.Members.Count == 0)
    {
        <div class="empty border-0 bg-slate-50">
            <p class="text-sm text-slate-500">عضوی برای نمایش وجود ندارد.</p>
        </div>
    }
    else
    {
        <div class="grid gap-4 lg:grid-cols-2">
            @foreach (var member in Model.Members)
            {
                <article class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div class="min-w-0">
                            <h4 class="truncate font-black">@member.DisplayName</h4>
                            @if (!string.IsNullOrWhiteSpace(member.Email))
                            {
                                <p class="mt-1 truncate text-xs text-slate-500" dir="ltr">@member.Email</p>
                            }
                        </div>
                        <div class="grid grid-cols-2 gap-2 text-center text-xs">
                            <div class="rounded-xl bg-rose-50 px-3 py-2 text-rose-700">
                                <span class="block text-[11px]">خرج ماه</span>
                                <strong class="mt-1 block">@Formatters.Money(member.ExpenseAmount)</strong>
                            </div>
                            <div class="rounded-xl bg-emerald-50 px-3 py-2 text-emerald-700">
                                <span class="block text-[11px]">پس‌انداز ماه</span>
                                <strong class="mt-1 block">@Formatters.Money(member.SavingsAmount)</strong>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 grid gap-4 md:grid-cols-2">
                        <div>
                            <div class="mb-2 flex items-center justify-between gap-2">
                                <strong class="text-sm">دسته‌های هزینه</strong>
                                <span class="text-xs text-slate-500">@member.ExpenseCount تراکنش</span>
                            </div>
                            @if (member.Categories.Count == 0)
                            {
                                <p class="rounded-xl bg-white p-3 text-xs text-slate-500">خرجی ثبت نشده است.</p>
                            }
                            else
                            {
                                <div class="grid gap-2">
                                    @foreach (var category in member.Categories)
                                    {
                                        <div class="rounded-xl bg-white p-3">
                                            <div class="flex items-center justify-between gap-2 text-xs">
                                                <span class="font-bold">@category.Icon @category.Name</span>
                                                <span>@Formatters.Money(category.Amount)</span>
                                            </div>
                                            <div class="progress mt-2">
                                                <div class="progress-bar bg-rose-600" style="width: @(Math.Min(category.Percent, 100))%"></div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <div>
                            <div class="mb-2 flex items-center justify-between gap-2">
                                <strong class="text-sm">پس‌انداز در هدف‌ها</strong>
                                <span class="text-xs text-slate-500">@member.SavingsCount واریزی</span>
                            </div>
                            @if (member.SavingsGoals.Count == 0)
                            {
                                <p class="rounded-xl bg-white p-3 text-xs text-slate-500">واریزی پس‌انداز ثبت نشده است.</p>
                            }
                            else
                            {
                                <div class="grid gap-2">
                                    @foreach (var goal in member.SavingsGoals)
                                    {
                                        <div class="flex items-center justify-between gap-3 rounded-xl bg-white p-3 text-xs">
                                            <div class="min-w-0">
                                                <p class="truncate font-bold">🎯 @goal.GoalName</p>
                                                <p class="mt-1 text-[11px] text-slate-500">@goal.Count واریزی</p>
                                            </div>
                                            <strong class="shrink-0 text-emerald-700">@Formatters.Money(goal.Amount)</strong>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>
