<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RootNamespace>Donysh.Life</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../HesabYar.Web/wwwroot/images/donysh-mark.png" Link="wwwroot/images/donysh-mark.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../HesabYar.Web/wwwroot/images/donysh-life-logo.png" Link="wwwroot/images/donysh-life-logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../HesabYar.Web/wwwroot/fonts/YekanBakh-Regular.woff2" Link="wwwroot/fonts/YekanBakh-Regular.woff2" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../HesabYar.Web/wwwroot/fonts/YekanBakh-SemiBold.woff2" Link="wwwroot/fonts/YekanBakh-SemiBold.woff2" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../HesabYar.Web/wwwroot/fonts/YekanBakh-ExtraBold.woff2" Link="wwwroot/fonts/YekanBakh-ExtraBold.woff2" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
