@page
@model SetupModel
@using Donysh.Life.Features.Activities
@{
    ViewData["Title"] = "راه‌اندازی";
}

<section class="setup-shell">
    <ol class="stepper" aria-label="مراحل راه‌اندازی">
        <li class="@(Model.Step == 1 ? "active" : "complete")" aria-current="@(Model.Step == 1 ? "step" : null)"><span>@(Model.Step > 1 ? "✓" : "۱")</span>آشنایی</li>
        <li class="@(Model.Step == 2 ? "active" : "")" aria-current="@(Model.Step == 2 ? "step" : null)"><span>۲</span>فعالیت‌ها و هدف‌ها</li>
    </ol>

    @if (Model.HasActivities && Model.Step == 1)
    {
        <article class="panel setup-card"><span class="setup-hero-icon">✓</span><p class="eyebrow">راه‌اندازی انجام شده</p><h1>همه‌چیز برای ادامه آماده است.</h1><p>می‌توانی فعالیت تازه بسازی یا هدف‌های هفتگی را ویرایش کنی.</p><a class="button primary" asp-page="/Activities">رفتن به فعالیت‌ها</a></article>
    }
    else if (Model.Step == 1)
    {
        <article class="panel setup-card">
            <span class="setup-hero-icon">◎</span><p class="eyebrow">دو دقیقه تا یک برنامهٔ روشن</p><h1>از چیزهایی شروع کن که واقعاً برایت مهم‌اند.</h1>
            <p>در قدم بعد چند فعالیت را انتخاب می‌کنی و می‌گویی در هر هفته چقدر زمان برایشان می‌خواهی. همهٔ این موارد بعداً قابل تغییرند.</p>
            <ul class="setup-benefits"><li><span>✓</span>بدون دادهٔ پیش‌فرض اجباری</li><li><span>✓</span>شروع هفته از شنبه</li><li><span>✓</span>قابل ویرایش در هر زمان</li></ul>
            <form method="post" asp-page-handler="Begin"><button class="button primary" type="submit" data-busy-text="در حال آماده‌سازی…">انتخاب فعالیت‌ها</button></form>
        </article>
    }
    else
    {
        var selectedCount = Model.Suggestions.Count(item => item.IsSelected);
        var selectedHours = Model.Suggestions.Where(item => item.IsSelected).Sum(item => item.WeeklyHours);
        <form method="post" asp-page-handler="Complete" class="setup-form" data-setup-form>
            <header class="setup-list-head"><div><p class="eyebrow">قدم دوم از دو</p><h1>چه چیزهایی برایت مهم‌اند؟</h1><p>چند مورد را انتخاب کن؛ فقط برای موارد انتخاب‌شده هدف هفتگی تعیین می‌کنی.</p></div><button class="button primary desktop-submit" type="submit" data-busy-text="در حال ساخت برنامه…">ذخیره و شروع</button></header>
            @if (!string.IsNullOrWhiteSpace(Model.CommandError)) { <div class="notice error" role="alert">@Model.CommandError</div> }
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="validation-summary" role="alert"><ul>@foreach (var error in ViewData.ModelState.Values.SelectMany(entry => entry.Errors)) { <li>@error.ErrorMessage</li> }</ul></div>
            }
            <section class="setup-selection-bar" aria-label="خلاصهٔ انتخاب‌ها">
                <p role="status" aria-live="polite"><strong data-selected-count>@selectedCount</strong> فعالیت، در مجموع <strong data-selected-hours>@selectedHours.ToString("0.#")</strong> ساعت در هفته</p>
                <div><button class="selection-action" type="button" data-select-all>انتخاب همه</button><button class="selection-action" type="button" data-clear-all>پاک‌کردن انتخاب‌ها</button></div>
            </section>
            <div class="template-grid">
                @for (var index = 0; index < Model.Suggestions.Count; index++)
                {
                    var suggestion = Model.Suggestions[index];
                    var template = ActivityCatalog.FindTemplate(suggestion.TemplateKey);
                    if (template is null) { continue; }
                    <article class="template-card @(suggestion.IsSelected ? "selected" : "") @ActivityCatalog.ColorClass(template.ColorHex)" data-template-card>
                        <input type="hidden" asp-for="Suggestions[index].TemplateKey" />
                        <label class="template-choice"><input asp-for="Suggestions[index].IsSelected" data-template-toggle /><span class="template-check" aria-hidden="true">✓</span><span class="activity-icon">@ActivityCatalog.IconGlyph(template.IconKey)</span><span><strong>@template.Title</strong><small>@template.Category</small></span></label>
                        <label class="goal-input" hidden="@(!suggestion.IsSelected ? "hidden" : null)"><span>هدف در هفته</span><span><input asp-for="Suggestions[index].WeeklyHours" data-weekly-hours type="number" min="0.5" max="168" step="0.5" inputmode="decimal" /> ساعت</span></label>
                        <span asp-validation-for="Suggestions[index].WeeklyHours" class="field-error"></span>
                    </article>
                }
            </div>
            <footer class="setup-footer"><a class="text-link" asp-page="/Setup">بازگشت به توضیحات</a><button class="button primary mobile-submit" type="submit" data-busy-text="در حال ساخت برنامه…">ذخیره و شروع</button></footer>
        </form>
    }
</section>

@section Scripts {
    @if (Model.Step == 2) { <script src="~/js/setup-wizard.js" asp-append-version="true" defer></script> }
}
