@page
@model WeekModel
@using Donysh.Life.Features.Activities
@using Donysh.Life.Features.Scheduling
@{
    ViewData["Title"] = "برنامهٔ هفته";
    ViewData["ContentClass"] = "calendar-content";
    var selectedDay = Model.View.Days.Single(day => day.IsSelected);
    var visibleDays = Model.DisplayMode == "day" ? new[] { selectedDay } : Model.View.Days;
}

<section class="calendar-toolbar" aria-label="ابزارهای برنامه‌ریزی">
    <div class="calendar-title"><p class="eyebrow">برنامه‌ریزی تعاملی</p><h1>برنامهٔ هفته</h1></div>
    <div class="calendar-navigation">
        <a class="calendar-today" asp-page="/Week" asp-route-view="@Model.DisplayMode">امروز</a>
        <a class="calendar-arrow" aria-label="هفتهٔ قبل" asp-page="/Week" asp-route-day="@Model.SelectedDay" asp-route-view="@Model.DisplayMode" asp-route-week="@Model.View.WeekStart.AddDays(-7).ToString("yyyy-MM-dd")">‹</a>
        <span class="calendar-range">@Model.View.Days[0].PersianDate تا @Model.View.Days[6].PersianDate</span>
        <a class="calendar-arrow" aria-label="هفتهٔ بعد" asp-page="/Week" asp-route-day="@Model.SelectedDay" asp-route-view="@Model.DisplayMode" asp-route-week="@Model.View.WeekStart.AddDays(7).ToString("yyyy-MM-dd")">›</a>
    </div>
    <div class="calendar-toolbar-actions">
        <nav class="view-switcher" aria-label="نوع نمایش">
            <a class="@(Model.DisplayMode == "day" ? "active" : "")" aria-current="@(Model.DisplayMode == "day" ? "page" : null)" asp-page="/Week" asp-route-day="@Model.SelectedDay" asp-route-week="@Model.View.WeekStart.ToString("yyyy-MM-dd")" asp-route-view="day">روز</a>
            <a class="@(Model.DisplayMode == "week" ? "active" : "")" aria-current="@(Model.DisplayMode == "week" ? "page" : null)" asp-page="/Week" asp-route-day="@Model.SelectedDay" asp-route-week="@Model.View.WeekStart.ToString("yyyy-MM-dd")" asp-route-view="week">هفته</a>
        </nav>
        @if (Model.View.Activities.Count > 0) { <button type="button" class="button primary calendar-create-button" data-open-create>＋ افزودن برنامه</button> }
    </div>
</section>

@if (TempData["ScheduleMessage"] is string message) { <div class="notice success" role="status">@message</div> }
@if (TempData["ScheduleError"] is string scheduleError) { <div class="notice error" role="alert">@scheduleError</div> }
@if (!string.IsNullOrWhiteSpace(Model.CommandError)) { <div class="notice error" role="alert">@Model.CommandError</div> }

<details class="calendar-insights">
    <summary><span><strong>@Model.View.PlannedHours.ToString("0.#") ساعت</strong> برای این هفته برنامه داری</span><small>نمایش خلاصهٔ هدف‌ها</small></summary>
    <div class="week-summary" aria-label="خلاصهٔ برنامه">
        @foreach (var summary in Model.View.Summaries.Take(4))
        {
            <article class="plan-summary @summary.ColorClass"><div><span>@summary.Title</span><strong>@summary.PlannedHours.ToString("0.#") از @summary.GoalHours.ToString("0.#") ساعت</strong></div><span class="coverage-badge">@summary.CoveragePercent٪</span><progress max="100" value="@summary.CoveragePercent">@summary.CoveragePercent٪</progress></article>
        }
    </div>
</details>

@if (Model.View.Activities.Count == 0)
{
    <article class="panel schedule-prerequisite"><span class="empty-mark">◎</span><h2>اول یک فعالیت بساز</h2><p>هر بازهٔ زمانی باید به یکی از فعالیت‌های فعال متصل باشد.</p><a class="button secondary" asp-page="/Activities">مدیریت فعالیت‌ها</a></article>
}
else
{
    <nav class="calendar-day-tabs" aria-label="انتخاب روز">
        @foreach (var day in Model.View.Days)
        {
            <a class="@(day.IsSelected ? "active" : "")" asp-page="/Week" asp-route-day="@day.DayOfWeek" asp-route-week="@Model.View.WeekStart.ToString("yyyy-MM-dd")" asp-route-view="day"><strong>@day.Name</strong><small>@day.PersianDate[5..]</small></a>
        }
    </nav>

    <section class="calendar-board @(Model.DisplayMode == "day" ? "day-view" : "week-view")" data-calendar-board aria-label="تقویم برنامه‌ها">
        <div class="calendar-corner" aria-hidden="true"></div>
        <div class="calendar-days-header" data-column-count="@visibleDays.Count">
            @foreach (var day in visibleDays)
            {
                <a class="@(day.IsSelected ? "selected" : "") @(day.DayOfWeek == DayOfWeek.Friday ? "friday" : "")" asp-page="/Week" asp-route-day="@day.DayOfWeek" asp-route-week="@Model.View.WeekStart.ToString("yyyy-MM-dd")" asp-route-view="day"><strong>@day.Name</strong><span>@day.PersianDate[8..]</span><small>@day.Blocks.Count برنامه</small></a>
            }
        </div>
        <div class="calendar-time-gutter" aria-hidden="true">
            @for (var hour = 0; hour < 24; hour++) { <span>@hour.ToString("00"):00</span> }
        </div>
        <div class="calendar-days-grid" data-column-count="@visibleDays.Count">
            @foreach (var day in visibleDays)
            {
                <article class="calendar-day-column @(day.DayOfWeek == DayOfWeek.Friday ? "friday" : "")" data-date="@day.Date.ToString("yyyy-MM-dd")" aria-label="@day.Name @day.PersianDate">
                    @for (var slot = 0; slot < 48; slot++)
                    {
                        var minute = slot * 30;
                        var slotBlocks = day.Blocks.Where(block => block.StartMinute == minute);
                        <div class="calendar-slot @(slot % 2 == 0 ? "full-hour" : "half-hour")" data-minute="@minute">
                            <button type="button" class="time-slot" aria-label="افزودن برنامه در @day.Name ساعت @(minute / 60):@(minute % 60 == 0 ? "00" : "30")"></button>
                            @foreach (var block in slotBlocks) { <partial name="Shared/_ScheduleBlock" model="new ScheduleBlockCardModel(block, Model.View.Activities, Model.View.WeekStart)" /> }
                        </div>
                    }
                </article>
            }
        </div>
    </section>

    <dialog id="schedule-create-dialog" class="calendar-dialog" aria-labelledby="create-dialog-title">
        <div class="dialog-heading"><div><span class="section-icon">＋</span><div><h2 id="create-dialog-title">برنامهٔ تازه</h2><p>این بازه هر هفته تکرار می‌شود.</p></div></div><button type="button" class="dialog-close" data-close-create aria-label="بستن">×</button></div>
        <form method="post" asp-page-handler="Save" class="schedule-form">
            <input type="hidden" name="WeekStart" value="@Model.View.WeekStart.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="view" value="@Model.DisplayMode" />
            @if (!ViewData.ModelState.IsValid) { <div class="validation-summary" role="alert"><ul>@foreach (var error in ViewData.ModelState.Values.SelectMany(entry => entry.Errors)) { <li>@error.ErrorMessage</li> }</ul></div> }
            <label class="field"><span>فعالیت</span><select name="Input.ActivityId" required><option value="">انتخاب فعالیت</option>@foreach (var activity in Model.View.Activities) { <option value="@activity.Id" selected="@(activity.Id == Model.Input.ActivityId ? "selected" : null)">@activity.IconGlyph @activity.Title</option> }</select></label>
            <label class="field"><span>روز هفته</span><select name="Input.DayOfWeek">@foreach (var day in WeekCalendar.Days) { <option value="@day" selected="@(day == Model.Input.DayOfWeek ? "selected" : null)">@WeekCalendar.DayName(day)</option> }</select></label>
            <div class="field-grid"><label class="field"><span>ساعت شروع</span><input name="Input.StartTime" value="@Model.Input.StartTime" type="time" step="1800" required /></label><label class="field"><span>مدت</span><select name="Input.DurationMinutes">@foreach (var duration in WeekCalendar.DurationOptions) { <option value="@duration" selected="@(duration == Model.Input.DurationMinutes ? "selected" : null)">@WeekCalendar.DurationName(duration)</option> }</select></label></div>
            <label class="field"><span>یادداشت <small>اختیاری</small></span><input name="Input.Note" value="@Model.Input.Note" maxlength="160" placeholder="مثلاً جلسهٔ هفتگی" /></label>
            <button class="button primary" type="submit">افزودن به هفته</button>
        </form>
    </dialog>

    <form method="post" asp-page-handler="Interact" id="schedule-interaction-form" class="hidden">
        <input type="hidden" name="WeekStart" value="@Model.View.WeekStart.ToString("yyyy-MM-dd")" /><input type="hidden" name="view" value="@Model.DisplayMode" />
        <input type="hidden" name="Interaction.PatternId" /><input type="hidden" name="Interaction.OriginalDate" /><input type="hidden" name="Interaction.TargetDate" /><input type="hidden" name="Interaction.StartMinute" /><input type="hidden" name="Interaction.DurationMinutes" /><input type="hidden" name="Interaction.Scope" />
    </form>
    <dialog id="schedule-scope-dialog" class="scope-dialog" aria-labelledby="scope-dialog-title"><form method="dialog"><button class="dialog-close" value="cancel" aria-label="بستن">×</button></form><span class="dialog-icon">↔</span><h2 id="scope-dialog-title">این تغییر کجا اعمال شود؟</h2><p>فقط برنامهٔ همین هفته را تغییر بده یا الگوی تکرارشوندهٔ همهٔ هفته‌ها را ویرایش کن.</p><div class="scope-actions"><button type="button" class="button primary" data-scope="occurrence">فقط همین هفته</button><button type="button" class="button secondary" data-scope="series">همهٔ هفته‌ها</button></div></dialog>
}

@section Scripts { <script src="~/js/week-planner.js" asp-append-version="true" defer></script> }
