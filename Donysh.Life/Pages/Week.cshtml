@page
@model WeekModel
@using Donysh.Life.Features.Activities
@using Donysh.Life.Features.Scheduling
@{
    ViewData["Title"] = "برنامهٔ هفته";
}

<section class="page-head compact">
    <div><p class="eyebrow">برنامه‌ریزی تعاملی</p><h1>برنامهٔ هفته</h1><p>خانه‌های نیم‌ساعته را انتخاب کن یا یک برنامه را بکش و روی زمان تازه رها کن. هنگام تغییر، می‌توانی فقط همین هفته یا همهٔ هفته‌ها را انتخاب کنی.</p></div>
    <div class="week-navigation"><a class="week-nav-button" asp-page="/Week" asp-route-week="@Model.View.WeekStart.AddDays(-7).ToString("yyyy-MM-dd")">هفتهٔ قبل</a><span class="week-chip">@Model.View.Days[0].PersianDate تا @Model.View.Days[6].PersianDate</span><a class="week-nav-button" asp-page="/Week" asp-route-week="@Model.View.WeekStart.AddDays(7).ToString("yyyy-MM-dd")">هفتهٔ بعد</a></div>
</section>

@if (TempData["ScheduleMessage"] is string message) { <div class="notice success" role="status">@message</div> }
@if (TempData["ScheduleError"] is string scheduleError) { <div class="notice error" role="alert">@scheduleError</div> }
@if (!string.IsNullOrWhiteSpace(Model.CommandError)) { <div class="notice error" role="alert">@Model.CommandError</div> }

<section class="week-summary" aria-label="خلاصهٔ برنامه">
    <article class="metric-card primary"><span>کل زمان برنامه‌ریزی‌شده</span><strong>@Model.View.PlannedHours.ToString("0.#") ساعت</strong><small>در یک هفتهٔ تکرارشونده</small></article>
    @foreach (var summary in Model.View.Summaries.Take(3))
    {
        <article class="plan-summary @summary.ColorClass"><div><span>@summary.Title</span><strong>@summary.PlannedHours.ToString("0.#") از @summary.GoalHours.ToString("0.#") ساعت</strong></div><span class="coverage-badge">@summary.CoveragePercent٪</span><progress max="100" value="@summary.CoveragePercent">@summary.CoveragePercent٪</progress></article>
    }
</section>

@if (Model.View.Activities.Count == 0)
{
    <article class="panel schedule-prerequisite"><span class="empty-mark">◎</span><h2>اول یک فعالیت بساز</h2><p>هر بازهٔ زمانی باید به یکی از فعالیت‌های فعال متصل باشد.</p><a class="button secondary" asp-page="/Activities">مدیریت فعالیت‌ها</a></article>
}
else
{
    <section class="schedule-builder">
        <aside class="panel schedule-form-panel">
            <div class="panel-head"><div><span class="section-icon">＋</span><h2>زمان ثابت تازه</h2></div></div>
            <p class="form-hint">این بازه در هر هفته تکرار می‌شود.</p>
            <form method="post" asp-page-handler="Save" class="schedule-form">
                <input type="hidden" name="WeekStart" value="@Model.View.WeekStart.ToString("yyyy-MM-dd")" />
                @if (!ViewData.ModelState.IsValid) { <div class="validation-summary" role="alert"><ul>@foreach (var error in ViewData.ModelState.Values.SelectMany(entry => entry.Errors)) { <li>@error.ErrorMessage</li> }</ul></div> }
                <label class="field"><span>فعالیت</span><select name="Input.ActivityId" required><option value="">انتخاب فعالیت</option>@foreach (var activity in Model.View.Activities) { <option value="@activity.Id" selected="@(activity.Id == Model.Input.ActivityId ? "selected" : null)">@activity.IconGlyph @activity.Title</option> }</select></label>
                <label class="field"><span>روز هفته</span><select name="Input.DayOfWeek">@foreach (var day in WeekCalendar.Days) { <option value="@day" selected="@(day == Model.Input.DayOfWeek ? "selected" : null)">@WeekCalendar.DayName(day)</option> }</select></label>
                <div class="field-grid">
                    <label class="field"><span>ساعت شروع</span><input name="Input.StartTime" value="@Model.Input.StartTime" type="time" step="1800" required /></label>
                    <label class="field"><span>مدت</span><select name="Input.DurationMinutes">@foreach (var duration in WeekCalendar.DurationOptions) { <option value="@duration" selected="@(duration == Model.Input.DurationMinutes ? "selected" : null)">@WeekCalendar.DurationName(duration)</option> }</select></label>
                </div>
                <label class="field"><span>یادداشت <small>اختیاری</small></span><input name="Input.Note" value="@Model.Input.Note" maxlength="160" placeholder="مثلاً جلسهٔ هفتگی" /></label>
                <button class="button primary" type="submit">افزودن به هفته</button>
            </form>
        </aside>

        <div class="schedule-board-wrap">
            <nav class="mobile-day-tabs" aria-label="انتخاب روز">
                @foreach (var day in Model.View.Days)
                {
                    <a class="@(day.IsSelected ? "active" : "")" asp-page="/Week" asp-route-day="@day.DayOfWeek" asp-route-week="@Model.View.WeekStart.ToString("yyyy-MM-dd")"><strong>@day.Name</strong><small>@day.PersianDate[5..]</small></a>
                }
            </nav>

            <section class="desktop-week-board" aria-label="جدول برنامهٔ هفتگی">
                @foreach (var day in Model.View.Days)
                {
                    <article class="week-day-column @(day.DayOfWeek == DayOfWeek.Friday ? "friday" : "")">
                        <header><strong>@day.Name</strong><small>@day.PersianDate</small></header>
                        <div class="day-blocks">
                            @foreach (var block in day.Blocks) { <partial name="Shared/_ScheduleBlock" model="new ScheduleBlockCardModel(block, Model.View.Activities, Model.View.WeekStart)" /> }
                        </div>
                        <div class="drop-grid" data-date="@day.Date.ToString("yyyy-MM-dd")" aria-label="زمان‌های @day.Name">
                            @for (var slot = 0; slot < 48; slot++)
                            {
                                var minute = slot * 30;
                                <button type="button" class="time-slot" data-minute="@minute" aria-label="@day.Name ساعت @(minute / 60):@(minute % 60 == 0 ? "00" : "30")"><span>@(slot % 2 == 0 ? $"{minute / 60:00}:00" : "")</span></button>
                            }
                        </div>
                    </article>
                }
            </section>

            <section class="mobile-day-timeline" aria-label="برنامهٔ روز انتخاب‌شده">
                @{ var selectedDay = Model.View.Days.Single(day => day.IsSelected); }
                <header class="selected-day-head"><div><strong>@selectedDay.Name</strong><small>@selectedDay.PersianDate</small></div><span>@selectedDay.Blocks.Count بازه</span></header>
                <div class="timeline-list">
                    @if (selectedDay.Blocks.Count == 0) { <div class="mobile-empty"><span>＋</span><p>برای این روز هنوز زمانی ثبت نشده است.</p></div> }
                    @foreach (var block in selectedDay.Blocks) { <partial name="Shared/_ScheduleBlock" model="new ScheduleBlockCardModel(block, Model.View.Activities, Model.View.WeekStart)" /> }
                </div>
            </section>
        </div>
    </section>

    <form method="post" asp-page-handler="Interact" id="schedule-interaction-form" class="hidden">
        <input type="hidden" name="WeekStart" value="@Model.View.WeekStart.ToString("yyyy-MM-dd")" />
        <input type="hidden" name="Interaction.PatternId" />
        <input type="hidden" name="Interaction.OriginalDate" />
        <input type="hidden" name="Interaction.TargetDate" />
        <input type="hidden" name="Interaction.StartMinute" />
        <input type="hidden" name="Interaction.DurationMinutes" />
        <input type="hidden" name="Interaction.Scope" />
    </form>
    <dialog id="schedule-scope-dialog" class="scope-dialog" aria-labelledby="scope-dialog-title">
        <form method="dialog"><button class="dialog-close" value="cancel" aria-label="بستن">×</button></form>
        <span class="dialog-icon">↔</span><h2 id="scope-dialog-title">این تغییر کجا اعمال شود؟</h2>
        <p>می‌توانی فقط برنامهٔ همین هفته را تغییر بدهی یا الگوی تکرارشوندهٔ همهٔ هفته‌ها را ویرایش کنی.</p>
        <div class="scope-actions"><button type="button" class="button primary" data-scope="occurrence">فقط همین هفته</button><button type="button" class="button secondary" data-scope="series">همهٔ هفته‌ها</button></div>
    </dialog>
}

@section Scripts { <script src="~/js/week-planner.js" asp-append-version="true" defer></script> }
