@page
@model Donysh.Life.Pages.Account.LoginModel
@{
    Layout = null;
}
<!doctype html>
<html lang="fa" dir="rtl"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="theme-color" content="#0d9488" /><title>ورود به دُنیش زندگی</title><link rel="icon" type="image/png" href="~/images/donysh-life-icon.png" /><link rel="apple-touch-icon" href="~/images/donysh-life-icon.png" /><link rel="preload" href="~/fonts/YekanBakh-Regular.woff2" as="font" type="font/woff2" crossorigin /><script src="~/js/life-theme.js" asp-append-version="true"></script><link rel="stylesheet" href="~/css/app.css" /></head>
<body class="auth-body"><button type="button" class="theme-toggle auth-theme-toggle" data-life-theme-toggle aria-label="فعال کردن حالت تیره" aria-pressed="false" title="حالت تیره"><svg class="theme-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.3A8.5 8.5 0 0 1 9.7 3.5 8.5 8.5 0 1 0 20.5 14.3Z"/></svg><svg class="theme-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg><span class="theme-toggle-label">حالت تیره</span></button><main class="auth-card"><img class="auth-life-logo" src="~/images/donysh-life-logo.png" alt="Donysh Life" width="140" height="140" /><p class="eyebrow">یک حساب برای همهٔ دُنیش</p><h1>ورود به دُنیش زندگی</h1><p>با همان حسابی که در دُنیش مالی داری وارد شو.</p>@if (Model.AuthError) { <div class="notice error" role="alert">ورود کامل نشد. دوباره تلاش کن.</div> }<form method="post"><button class="button primary" type="submit" data-busy-text="در حال انتقال امن…">ادامه با حساب دُنیش</button></form><a class="text-link" href="https://donysh.ir">بازگشت به دُنیش</a></main><script src="~/js/interaction-feedback.js" asp-append-version="true" defer></script></body></html>
