@page
@model Donysh.Life.Pages.Account.LoginModel
@{
    Layout = null;
}
<!doctype html>
<html lang="fa" dir="rtl"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>ورود به دُنیش زندگی</title><link rel="preload" href="~/fonts/YekanBakh-Regular.woff2" as="font" type="font/woff2" crossorigin /><link rel="stylesheet" href="~/css/app.css" /></head>
<body class="auth-body"><main class="auth-card"><img class="auth-life-logo" src="~/images/donysh-life-logo.png" alt="Donysh Life" width="140" height="140" /><p class="eyebrow">یک حساب برای همهٔ دُنیش</p><h1>ورود به دُنیش زندگی</h1><p>با همان حسابی که در دُنیش مالی داری وارد شو.</p>@if (Model.AuthError) { <div class="notice error" role="alert">ورود کامل نشد. دوباره تلاش کن.</div> }<form method="post"><button class="button primary" type="submit" data-busy-text="در حال انتقال امن…">ادامه با حساب دُنیش</button></form><a class="text-link" href="https://donysh.ir">بازگشت به دُنیش</a></main><script src="~/js/interaction-feedback.js" asp-append-version="true" defer></script></body></html>
