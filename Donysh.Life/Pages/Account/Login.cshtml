@page
@model Donysh.Life.Pages.Account.LoginModel
@{
    Layout = null;
}
<!doctype html>
<html lang="fa" dir="rtl"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>ورود به دونیش زندگی</title><link rel="stylesheet" href="~/css/app.css" /></head>
<body class="auth-body"><main class="auth-card"><img src="~/images/donysh-mark.png" alt="" width="64" height="64" /><p class="eyebrow">یک حساب برای همهٔ دونیش</p><h1>ورود به دونیش زندگی</h1><p>با همان حسابی که در دونیش مالی داری وارد شو.</p>@if (Model.AuthError) { <div class="notice error">ورود کامل نشد. دوباره تلاش کن.</div> }<form method="post"><button class="button primary" type="submit">ادامه با حساب دونیش</button></form><a class="text-link" href="https://donysh.ir">بازگشت به دونیش</a></main></body></html>
