@inject IConfiguration Configuration
@{
    var configuredFinanceUrl = Configuration["Products:FinanceUrl"];
    var financeUrl = Uri.TryCreate(configuredFinanceUrl, UriKind.Absolute, out var parsedFinanceUrl)
        && parsedFinanceUrl.Scheme == Uri.UriSchemeHttps
            ? parsedFinanceUrl.AbsoluteUri
            : "https://finance.donysh.ir/";
    var accountName = User.FindFirst("name")?.Value
        ?? User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
        ?? User.Identity?.Name
        ?? "کاربر دنیش";
    var accountEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
        ?? User.FindFirst("email")?.Value;
    var accountInitial = string.IsNullOrWhiteSpace(accountName)
        ? "د"
        : accountName.Trim()[..1];
}
<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d9488" />
    <title>@ViewData["Title"] | دُنیش زندگی</title>
    <link rel="icon" type="image/png" href="~/images/donysh-life-logo.png" />
    <link rel="apple-touch-icon" href="~/images/donysh-life-logo.png" />
    <link rel="preload" href="~/fonts/YekanBakh-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <script src="~/js/life-sidebar.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">رفتن به محتوای اصلی</a>
    <div class="app-shell">
        <aside id="life-sidebar" class="sidebar">
            <div class="sidebar-header">
                <a class="brand life-brand" asp-page="/Index" aria-label="دُنیش زندگی، صفحهٔ اصلی" title="دُنیش زندگی">
                    <img class="life-brand-logo" src="~/images/donysh-life-logo.png" alt="دنیش زندگی" width="176" height="176" />
                    <svg class="life-brand-mark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4C12 4 5 7 5 15a5 5 0 0 0 5 5c8 0 11-7 10-16Z"/><path d="M5 20c3-6 7-9 13-12"/></svg>
                </a>
                <button type="button" class="sidebar-toggle" data-life-sidebar-toggle aria-controls="life-sidebar" aria-expanded="true" aria-label="جمع‌کردن سایدبار" title="جمع‌کردن سایدبار">
                    <svg class="sidebar-toggle-collapse" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M15 3v18m-7-12 3 3-3 3"/></svg>
                    <svg class="sidebar-toggle-expand" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18m7-12-3 3 3 3"/></svg>
                </button>
            </div>
            <p class="sidebar-caption">زمانت را آگاهانه زندگی کن</p>
            <nav class="side-nav" aria-label="ناوبری اصلی">
                <a class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")" aria-current="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "page" : null)" aria-label="امروز" title="امروز" asp-page="/Index"><span aria-hidden="true">⌂</span><span class="nav-label">امروز</span></a>
                <a class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Activities" ? "active" : "")" aria-current="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Activities" ? "page" : null)" aria-label="فعالیت‌ها" title="فعالیت‌ها" asp-page="/Activities"><span aria-hidden="true">◎</span><span class="nav-label">فعالیت‌ها</span></a>
                <a class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Week" ? "active" : "")" aria-current="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Week" ? "page" : null)" aria-label="برنامهٔ هفته" title="برنامهٔ هفته" asp-page="/Week"><span aria-hidden="true">▦</span><span class="nav-label">برنامهٔ هفته</span></a>
                <a class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Ai" ? "active" : "")" aria-current="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Ai" ? "page" : null)" aria-label="دستیار هوشمند" title="دستیار هوشمند" asp-page="/Ai"><span aria-hidden="true">✦</span><span class="nav-label">دستیار هوشمند</span></a>
                <a class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Progress" ? "active" : "")" aria-current="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Progress" ? "page" : null)" aria-label="پیشرفت" title="پیشرفت" asp-page="/Progress"><span aria-hidden="true">↗</span><span class="nav-label">پیشرفت</span></a>
            </nav>
            <div class="sidebar-footer">
                <section class="account-card" aria-label="حساب واردشده">
                    <span class="account-avatar" aria-hidden="true">@accountInitial</span>
                    <span class="account-copy">
                        <small>واردشده با حساب</small>
                        <strong>@accountName</strong>
                        @if (!string.IsNullOrWhiteSpace(accountEmail))
                        {
                            <span dir="ltr">@accountEmail</span>
                        }
                    </span>
                    <span class="account-status" title="حساب فعال" aria-label="حساب فعال"></span>
                </section>
                <a class="product-switcher" href="@financeUrl" aria-label="رفتن به دُنیش مالی">
                    <span class="product-switcher-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M4 7.5h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-12a2 2 0 0 1 2-2h11" /><path d="M16 12h4v3h-4a1.5 1.5 0 0 1 0-3Z" /></svg>
                    </span>
                    <span class="product-switcher-copy"><small>بودجه و مخارج</small><strong>دُنیش مالی</strong></span>
                    <span class="product-switcher-arrow" aria-hidden="true">←</span>
                </a>
                <form method="post" asp-page="/Account/Logout" class="logout-form" data-native-submit data-logout-form>
                    <button type="submit" aria-label="خروج امن" title="خروج امن"><span class="logout-icon" aria-hidden="true">⇥</span><span class="logout-label">خروج امن</span></button>
                </form>
            </div>
        </aside>
        <div class="page-column">
            <header class="mobile-header">
                <a class="brand life-brand compact-brand" asp-page="/Index"><img class="life-brand-logo" src="~/images/donysh-life-logo.png" alt="دنیش زندگی" width="104" height="104" /></a>
                <div class="mobile-header-actions">
                    <span class="mobile-account" title="حساب واردشده: @accountName">
                        <span class="account-avatar" aria-hidden="true">@accountInitial</span>
                        <strong>@accountName</strong>
                    </span>
                    <a class="product-switcher compact" href="@financeUrl" aria-label="رفتن به دُنیش مالی">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7.5h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-12a2 2 0 0 1 2-2h11" /><path d="M16 12h4v3h-4a1.5 1.5 0 0 1 0-3Z" /></svg>
                        <span>مالی</span>
                    </a>
                </div>
            </header>
            <main id="main-content" class="content-shell @ViewData["ContentClass"]">
                @RenderBody()
            </main>
            <nav class="mobile-nav" aria-label="ناوبری موبایل">
                <a class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")" aria-current="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "page" : null)" asp-page="/Index"><span aria-hidden="true">⌂</span><small>امروز</small></a>
                <a class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Activities" ? "active" : "")" aria-current="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Activities" ? "page" : null)" asp-page="/Activities"><span aria-hidden="true">◎</span><small>فعالیت‌ها</small></a>
                <a class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Week" ? "active" : "")" aria-current="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Week" ? "page" : null)" asp-page="/Week"><span aria-hidden="true">▦</span><small>هفته</small></a>
                <a class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Ai" ? "active" : "")" aria-current="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Ai" ? "page" : null)" asp-page="/Ai"><span aria-hidden="true">✦</span><small>دستیار</small></a>
                <a class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Progress" ? "active" : "")" aria-current="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Progress" ? "page" : null)" asp-page="/Progress"><span aria-hidden="true">↗</span><small>پیشرفت</small></a>
                <form method="post" asp-page="/Account/Logout" class="mobile-logout-form" data-native-submit data-logout-form>
                    <button type="submit" aria-label="خروج از حساب"><span aria-hidden="true">⇥</span><small>خروج</small></button>
                </form>
            </nav>
        </div>
    </div>
    <script src="~/js/interaction-feedback.js" asp-append-version="true" defer></script>
    <script src="~/js/session-sync.js"
            data-session-status-url="/Account/SessionStatus"
            data-signed-out-url="/Account/SignedOut"
            asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
