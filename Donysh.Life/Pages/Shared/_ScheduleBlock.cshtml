@model Donysh.Life.Features.Scheduling.ScheduleBlockCardModel
@using Donysh.Life.Features.Scheduling
@using Donysh.Life.Features.Activities
@{
    var block = Model.Block;
}
<article class="schedule-block calendar-event @block.ColorClass @(block.IsActive ? "" : "inactive")" draggable="true"
         data-pattern-id="@block.Id" data-original-date="@block.OriginalDate.ToString("yyyy-MM-dd")"
         data-scheduled-date="@block.ScheduledDate.ToString("yyyy-MM-dd")" data-start-minute="@block.StartMinute" data-duration="@block.DurationMinutes">
    <div class="block-main"><span class="block-icon" aria-hidden="true"><svg><use href="/icons/activities.svg#@ActivityCatalog.IconSymbol(block.IconKey)"></use></svg></span><div><strong>@block.ActivityTitle</strong><span class="block-time"><bdi dir="ltr">@block.StartLabel</bdi> تا <bdi dir="ltr">@block.EndLabel</bdi></span>@if (!string.IsNullOrWhiteSpace(block.Note)) { <small>@block.Note</small> }</div></div>
    @if (block.OutcomeStatus is not null)
    {
        <span class="outcome-badge @block.OutcomeClass">@block.OutcomeLabel@if (block.ActualMinutes > 0) { <small> · @block.ActualMinutes دقیقه</small> }</span>
    }
    <button type="button" class="block-actions" data-open-edit="@block.Id" aria-label="ویرایش @block.ActivityTitle">•••</button>
    <dialog id="schedule-edit-@block.Id" class="calendar-dialog schedule-edit-dialog" aria-labelledby="edit-title-@block.Id">
        <div class="dialog-heading">
            <div><span class="section-icon" aria-hidden="true"><svg><use href="/icons/activities.svg#@ActivityCatalog.IconSymbol(block.IconKey)"></use></svg></span><div><h2 id="edit-title-@block.Id">ویرایش @block.ActivityTitle</h2><p><bdi dir="ltr">@block.StartLabel</bdi> تا <bdi dir="ltr">@block.EndLabel</bdi> · @block.DurationLabel</p></div></div>
            <button type="button" class="dialog-close" data-close-edit aria-label="بستن">×</button>
        </div>
        <div class="schedule-edit-content">
            <section class="tracking-card" aria-label="ثبت عملکرد @block.ActivityTitle">
                <div class="tracking-head"><div><strong>نتیجهٔ واقعی</strong><small>با یک انتخاب ثبت می‌شود</small></div>@if (block.OutcomeStatus is not null) { <span class="outcome-badge @block.OutcomeClass">@block.OutcomeLabel</span> }</div>
                <form method="post" asp-page="/Week" asp-page-handler="RecordOccurrence" class="tracking-form">
                    <input type="hidden" name="Occurrence.PatternId" value="@block.Id" />
                    <input type="hidden" name="Occurrence.OriginalDate" value="@block.OriginalDate.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="SelectedDay" value="@block.DayOfWeek" />
                    <input type="hidden" name="WeekStart" value="@Model.WeekStart.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="view" value="@Model.DisplayMode" />
                    <div class="outcome-choices">
                        <button type="submit" name="Occurrence.Status" value="Completed" class="outcome-choice completed" aria-pressed="@(block.OutcomeStatus == Donysh.Life.Domain.OccurrenceOutcomeStatus.Completed ? "true" : "false")"><span>✓</span>انجام شد</button>
                        <button type="submit" name="Occurrence.Status" value="Missed" class="outcome-choice missed" aria-pressed="@(block.OutcomeStatus == Donysh.Life.Domain.OccurrenceOutcomeStatus.Missed ? "true" : "false")"><span>×</span>انجام نشد</button>
                        <button type="submit" name="Occurrence.Status" value="Partial" class="outcome-choice partial" aria-pressed="@(block.OutcomeStatus == Donysh.Life.Domain.OccurrenceOutcomeStatus.Partial ? "true" : "false")"><span>◐</span>نیمه‌تمام</button>
                        <button type="submit" name="Occurrence.Status" value="Moved" class="outcome-choice moved" aria-pressed="@(block.OutcomeStatus == Donysh.Life.Domain.OccurrenceOutcomeStatus.Moved ? "true" : "false")"><span>↗</span>انتقال یافت</button>
                    </div>
                    <div class="field-grid tracking-details">
                        <label class="field"><span>زمان واقعی <small>اختیاری</small></span><input type="number" name="Occurrence.ActualMinutes" value="@(block.ActualMinutes > 0 ? block.ActualMinutes : null)" min="1" max="1440" inputmode="numeric" placeholder="دقیقه" /></label>
                        <label class="field"><span>تاریخ تازه <small>برای انتقال</small></span><input type="date" name="Occurrence.MovedToDate" value="@block.MovedToDate?.ToString("yyyy-MM-dd")" min="@block.ScheduledDate.AddDays(1).ToString("yyyy-MM-dd")" /></label>
                    </div>
                    <label class="field"><span>یادداشت نتیجه <small>اختیاری</small></span><input name="Occurrence.Note" value="@block.OutcomeNote" maxlength="160" placeholder="چه اتفاقی افتاد؟" /></label>
                </form>
                @if (block.OutcomeStatus is not null)
                {
                    <form method="post" asp-page="/Week" asp-page-handler="ClearOccurrence" class="clear-outcome-form"><input type="hidden" name="PatternId" value="@block.Id" /><input type="hidden" name="OriginalDate" value="@block.OriginalDate.ToString("yyyy-MM-dd")" /><input type="hidden" name="SelectedDay" value="@block.DayOfWeek" /><input type="hidden" name="WeekStart" value="@Model.WeekStart.ToString("yyyy-MM-dd")" /><input type="hidden" name="view" value="@Model.DisplayMode" /><button type="submit" class="text-button danger">پاک‌کردن وضعیت</button></form>
                }
            </section>
            <form method="post" asp-page="/Week" asp-page-handler="Save" class="schedule-form compact-schedule-form">
                <input type="hidden" name="PatternId" value="@block.Id" />
                <input type="hidden" name="WeekStart" value="@Model.WeekStart.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="view" value="@Model.DisplayMode" />
                <label class="field"><span>فعالیت</span><select name="Input.ActivityId">@foreach (var activity in Model.Activities) { <option value="@activity.Id" selected="@(activity.Id == block.ActivityId ? "selected" : null)">@activity.IconGlyph @activity.Title</option> }</select></label>
                <label class="field"><span>روز</span><select name="Input.DayOfWeek">@foreach (var day in WeekCalendar.Days) { <option value="@day" selected="@(day == block.DayOfWeek ? "selected" : null)">@WeekCalendar.DayName(day)</option> }</select></label>
                <div class="field-grid"><label class="field"><span>شروع</span><input name="Input.StartTime" value="@block.StartLabel" type="time" step="1800" required /></label><label class="field"><span>مدت</span><select name="Input.DurationMinutes">@foreach (var duration in WeekCalendar.DurationOptions) { <option value="@duration" selected="@(duration == block.DurationMinutes ? "selected" : null)">@WeekCalendar.DurationName(duration)</option> }</select></label></div>
                <label class="field"><span>یادداشت</span><input name="Input.Note" value="@block.Note" maxlength="160" /></label>
                <button class="button primary" type="submit">ویرایش همهٔ هفته‌ها</button>
            </form>
            <div class="resize-actions" aria-label="تغییر مدت این برنامه">
                <button type="button" class="text-button resize-block" data-resize="-30" disabled="@(block.DurationMinutes <= 30 ? "disabled" : null)">۳۰ دقیقه کمتر</button>
                <button type="button" class="text-button resize-block" data-resize="30" disabled="@(block.EndMinute >= 1440 ? "disabled" : null)">۳۰ دقیقه بیشتر</button>
            </div>
            <div class="block-secondary-actions">
                <form method="post" asp-page="/Week" asp-page-handler="CancelOccurrence"><input type="hidden" name="PatternId" value="@block.Id" /><input type="hidden" name="OriginalDate" value="@block.OriginalDate.ToString("yyyy-MM-dd")" /><input type="hidden" name="SelectedDay" value="@block.DayOfWeek" /><input type="hidden" name="WeekStart" value="@Model.WeekStart.ToString("yyyy-MM-dd")" /><input type="hidden" name="view" value="@Model.DisplayMode" /><button class="text-button danger" type="submit">حذف فقط از این هفته</button></form>
                <form method="post" asp-page="/Week" asp-page-handler="Toggle"><input type="hidden" name="PatternId" value="@block.Id" /><input type="hidden" name="SelectedDay" value="@block.DayOfWeek" /><input type="hidden" name="WeekStart" value="@Model.WeekStart.ToString("yyyy-MM-dd")" /><input type="hidden" name="view" value="@Model.DisplayMode" /><button class="text-button" type="submit">@(block.IsActive ? "غیرفعال‌کردن الگو" : "فعال‌کردن الگو")</button></form>
                <form method="post" asp-page="/Week" asp-page-handler="Delete" class="delete-form"><input type="hidden" name="PatternId" value="@block.Id" /><input type="hidden" name="SelectedDay" value="@block.DayOfWeek" /><input type="hidden" name="WeekStart" value="@Model.WeekStart.ToString("yyyy-MM-dd")" /><input type="hidden" name="view" value="@Model.DisplayMode" /><label><input type="checkbox" name="ConfirmDelete" value="true" required /> حذف همه را تأیید می‌کنم</label><button class="text-button danger" type="submit">حذف از همهٔ هفته‌ها</button></form>
            </div>
        </div>
    </dialog>
    <button type="button" class="schedule-resize-handle" aria-label="تغییر مدت @block.ActivityTitle؛ اکنون @block.DurationLabel" title="برای تغییر مدت بکشید"><span aria-hidden="true"></span></button>
</article>
