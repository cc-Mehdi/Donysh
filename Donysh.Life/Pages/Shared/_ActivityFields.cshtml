@model Donysh.Life.Features.Activities.ActivityForm
@using Donysh.Life.Features.Activities
<div class="field-grid">
    <label class="field field-wide"><span>عنوان فعالیت</span><input name="Input.Title" value="@Model.Title" maxlength="80" placeholder="مثلاً ورزش یا مطالعه" autocomplete="off" required /><span asp-validation-for="Title" class="field-error"></span></label>
    <label class="field"><span>دسته‌بندی <small>اختیاری</small></span><input name="Input.Category" value="@Model.Category" maxlength="60" placeholder="مثلاً سلامت" autocomplete="off" /><span asp-validation-for="Category" class="field-error"></span></label>
    <label class="field"><span>هدف هفتگی (ساعت)</span><input name="Input.WeeklyHours" value="@Model.WeeklyHours.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" min="0.5" max="168" step="0.5" inputmode="decimal" required /><span asp-validation-for="WeeklyHours" class="field-error"></span></label>
    <partial name="Shared/_ActivityAppearance" model="@(new ActivityAppearancePickerModel(Model.Title, Model.ColorHex, Model.IconKey))" />
    <span asp-validation-for="ColorHex" class="field-error"></span><span asp-validation-for="IconKey" class="field-error"></span>
</div>
