{
    email {$ACME_EMAIL}
}

(secure_headers) {
    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        Cross-Origin-Opener-Policy "same-origin"
        X-Permitted-Cross-Domain-Policies "none"
    }
}

{$DOMAIN} {
    encode zstd gzip
    import secure_headers
    route {
        # Serve only the fixed public APK name. The host directory is mounted
        # read-only, directory browsing is disabled, and clients revalidate so
        # replacing the file publishes a new version without changing the URL.
        handle /downloads/donysh-mobile.apk {
            root * /srv/mobile-downloads
            rewrite * /donysh-mobile.apk
            header {
                Content-Type "application/vnd.android.package-archive"
                Content-Disposition "attachment; filename=donysh-mobile.apk"
                Cache-Control "no-store, max-age=0"
            }
            file_server
        }

        # Keep installed mobile clients, in-flight OIDC callbacks and already-open
        # Finance tabs functional during the public-domain cutover.
        @legacy_backend path /api/* /signin-oidc /signout-callback-oidc /css/* /js/* /fonts/* /images/*
        reverse_proxy @legacy_backend web:8080

        @legacy_finance_get {
            method GET HEAD
            path /Account* /Ai* /Budgets* /Categories* /Expenses* /Mobile* /Obligations* /Reports* /Savings* /Settings* /Workspaces*
        }
        redir @legacy_finance_get https://{$FINANCE_DOMAIN}{uri} 308

        @legacy_finance_write path /Account* /Ai* /Budgets* /Categories* /Expenses* /Mobile* /Obligations* /Reports* /Savings* /Settings* /Workspaces*
        reverse_proxy @legacy_finance_write web:8080

        reverse_proxy landing:8080
    }
    log {
        output stdout
        format json
    }
}

{$FINANCE_DOMAIN} {
    encode zstd gzip
    import secure_headers
    reverse_proxy web:8080
    log {
        output stdout
        format json
    }
}

{$AUTH_DOMAIN} {
    encode zstd gzip
    import secure_headers
    reverse_proxy auth:8080
    log {
        output stdout
        format json
    }
}

{$LIFE_DOMAIN} {
    encode zstd gzip
    import secure_headers
    reverse_proxy life:8080
    log {
        output stdout
        format json
    }
}
