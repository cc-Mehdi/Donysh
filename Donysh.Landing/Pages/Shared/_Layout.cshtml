@using Donysh.Landing.Infrastructure
@using Microsoft.Extensions.Options
@inject LandingAssetUrlBuilder AssetUrls
@inject IOptions<Donysh.Landing.Configuration.LandingLinksOptions> ProductOptions
@{
    var cssUrl = AssetUrls.Versioned(
        "/landing-assets/css/app.css",
        "/css/app.css",
        Context.Request.PathBase);
    var iconUrl = AssetUrls.Versioned(
        "/landing-assets/brand/donysh-icon.png",
        "/brand/donysh-icon.png",
        Context.Request.PathBase);
    var socialUrl = AssetUrls.Versioned(
        "/landing-assets/brand/donysh-social.png",
        "/brand/donysh-social.png",
        Context.Request.PathBase);
    var products = ProductOptions.Value;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#070b18" media="(prefers-color-scheme: dark)" />
    <meta name="description" content="دُنیش، خانهٔ ابزارهای ساده و یکپارچه برای مدیریت پول، زمان و مسیر زندگی است." />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/png" href="@iconUrl" />
    <link rel="apple-touch-icon" href="@iconUrl" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="@(Context.Request.Scheme)://@(Context.Request.Host)@socialUrl" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="@(Context.Request.Scheme)://@(Context.Request.Host)@socialUrl" />
    <link rel="dns-prefetch" href="@products.FinanceUrl" />
    <link rel="preconnect" href="@products.FinanceUrl" />
    <link rel="dns-prefetch" href="@products.AuthUrl" />
    <link rel="preconnect" href="@products.AuthUrl" />
    <link rel="stylesheet" href="@cssUrl" />
</head>
<body class="landing-body">
    <a class="skip-link" href="#main-content">رفتن به محتوای اصلی</a>
    @RenderBody()
</body>
</html>
