@page
@using Microsoft.Extensions.Options
@inject IOptions<LandingLinksOptions> ProductOptions
@{
    ViewData["Title"] = "دُنیش | وضوح برای پول و زمان";
    var products = ProductOptions.Value;
}

<header class="site-header">
    <nav class="nav-shell" aria-label="ناوبری اصلی">
        <a class="wordmark-link" href="#top" aria-label="دُنیش، صفحهٔ اصلی">
            <img src="/landing-assets/images/donysh-wordmark.png" alt="دُنیش" width="178" height="58" />
        </a>
        <div class="nav-links">
            <a href="#products">محصول‌ها</a>
            <a href="#experience">چطور کار می‌کند؟</a>
            <a href="#mobile-app">برنامهٔ همراه</a>
        </div>
        <a class="nav-action" href="@(products.AuthUrl.TrimEnd('/') + "/Account/Login")">
            <span>ورود به حساب</span>
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6" /></svg>
        </a>
    </nav>
</header>

<main id="main-content">
    <section id="top" class="hero section-shell" aria-labelledby="hero-title">
        <div class="hero-copy">
            <p class="eyebrow"><span aria-hidden="true"></span> دو محصول، یک حساب امن</p>
            <h1 id="hero-title">برای پولت <strong>وضوح.</strong><br />برای زمانت <em>جهت.</em></h1>
            <p class="hero-lead">دُنیش کمک می‌کند پول، زمان و هدف‌هایت را ساده‌تر ببینی؛ تصمیم بگیری و بدون گم‌شدن میان ابزارهای شلوغ، آرام جلو بروی.</p>
            <div class="hero-actions">
                <a class="button button-primary" href="@products.FinanceUrl">
                    شروع با دُنیش مالی
                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6" /></svg>
                </a>
                <a class="button button-secondary" href="#products">دیدن دنیای دُنیش</a>
            </div>
            <div class="trust-row" aria-label="ویژگی‌های اصلی">
                <span><i aria-hidden="true">✓</i>ورود یکپارچه و امن</span>
                <span><i aria-hidden="true">✓</i>داده‌های هر محصول، مستقل</span>
                <span><i aria-hidden="true">✓</i>طراحی ساده و فارسی</span>
            </div>
        </div>

        <div class="hero-art" aria-label="دُنیش، پیوند مدیریت پول و زمان">
            <div class="hero-glow" aria-hidden="true"></div>
            <div class="hero-grid" aria-hidden="true"></div>
            <div class="brand-sculpture">
                <span class="sculpture-ring ring-one" aria-hidden="true"></span>
                <span class="sculpture-ring ring-two" aria-hidden="true"></span>
                <span class="brand-mark-wrap">
                    <img src="/landing-assets/images/donysh-mark.png" alt="" width="176" height="176" />
                </span>
            </div>
            <a class="floating-product finance-float" href="@products.FinanceUrl">
                <span class="mini-icon finance-mini" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M4 7.5A2.5 2.5 0 0 1 6.5 5H18a2 2 0 0 1 2 2v2H4V7.5Z"/><path d="M4 9h16v10H6a2 2 0 0 1-2-2V9Z"/><path d="M16 13h5v3h-5a1.5 1.5 0 0 1 0-3Z"/></svg>
                </span>
                <span><small>پول، بودجه و هدف‌ها</small><strong>دُنیش مالی</strong></span>
                <b aria-hidden="true">↗</b>
            </a>
            <a class="floating-product life-float" href="@products.LifeUrl">
                <img src="/landing-assets/images/donysh-life-logo.png" alt="دنیش زندگی" width="96" height="96" />
                <span><small>زمان، برنامه و پیشرفت</small><strong>دُنیش زندگی</strong></span>
                <b aria-hidden="true">↗</b>
            </a>
            <div class="signal-pill signal-one" aria-hidden="true"><i></i><span>همین امروز</span></div>
            <div class="signal-pill signal-two" aria-hidden="true"><i></i><span>قدم بعدی روشن</span></div>
        </div>
    </section>

    <section class="signal-strip" aria-label="توانایی‌های دُنیش">
        <div class="signal-track">
            <span>بودجه‌ای که می‌فهمی</span><i>✦</i><span>برنامه‌ای که انجام می‌شود</span><i>✦</i><span>هدف‌هایی که جلو می‌روند</span><i>✦</i><span>گزارشی که تصمیم می‌سازد</span><i>✦</i>
            <span aria-hidden="true">بودجه‌ای که می‌فهمی</span><i aria-hidden="true">✦</i><span aria-hidden="true">برنامه‌ای که انجام می‌شود</span><i aria-hidden="true">✦</i><span aria-hidden="true">هدف‌هایی که جلو می‌روند</span><i aria-hidden="true">✦</i><span aria-hidden="true">گزارشی که تصمیم می‌سازد</span><i aria-hidden="true">✦</i>
        </div>
    </section>

    <section id="products" class="products-section section-shell reveal-section" aria-labelledby="products-title">
        <div class="section-heading split-heading">
            <div>
                <p class="eyebrow">محصول‌های دُنیش</p>
                <h2 id="products-title">هر بخش، متمرکز.<br />همه‌چیز، هماهنگ.</h2>
            </div>
            <p>هر برنامه کار خودش را دقیق انجام می‌دهد، اما حساب و تجربهٔ کاربری بین آن‌ها پیوسته است. از چیزی که امروز لازم داری شروع کن.</p>
        </div>

        <div class="product-bento">
            <article class="product-showcase finance-showcase">
                <div class="product-copy">
                    <div class="product-meta"><span class="live-dot">در دسترس</span><span>دُنیش مالی</span></div>
                    <h3>تصویر کامل پولت،<br />بدون جدول‌های گیج‌کننده.</h3>
                    <p>مخارج، بودجه‌ها، اقساط و هدف‌های پس‌انداز را در فضاهای شخصی یا مشترک کنار هم ببین.</p>
                    <ul class="feature-pills">
                        <li>فضاهای مشترک</li><li>بودجهٔ هوشمند</li><li>دستیار مالی</li>
                    </ul>
                    <a class="text-action" href="@products.FinanceUrl">ورود به دُنیش مالی <span aria-hidden="true">←</span></a>
                </div>
                <div class="finance-dashboard" aria-hidden="true">
                    <div class="mock-header"><i></i><i></i><i></i><span>نمای ماه</span></div>
                    <div class="mock-balance"><small>قابل خرج این ماه</small><strong>۱۲٬۴۸۰٬۰۰۰ <em>ریال</em></strong><span><i></i>۶۲٪ بودجه باقی مانده</span></div>
                    <div class="mock-bars"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
                    <div class="mock-row"><span><i></i>خریدهای روزانه</span><b>۲٬۸۴۰٬۰۰۰</b></div>
                    <div class="mock-row"><span><i></i>حمل‌ونقل</span><b>۱٬۳۲۰٬۰۰۰</b></div>
                </div>
            </article>

            <article class="product-showcase life-showcase">
                <div class="life-brand-panel">
                    <span class="life-orbit" aria-hidden="true"></span>
                    <img src="/landing-assets/images/donysh-life-logo.png" alt="دنیش زندگی" width="220" height="220" />
                </div>
                <div class="product-copy">
                    <div class="product-meta"><span class="life-dot">نسخهٔ آغازین</span><span>دُنیش زندگی</span></div>
                    <h3>زمانت را برای چیزهای مهم پس بگیر.</h3>
                    <p>هفته‌ات را بچین، کارهای واقعی را ثبت کن و پیشرفت هدف‌ها را با یک نگاه ببین.</p>
                    <ul class="feature-pills life-pills">
                        <li>برنامهٔ روز و هفته</li><li>سنجش پیشرفت</li><li>هدف زمانی</li>
                    </ul>
                    <a class="text-action life-action" href="@products.LifeUrl">ورود به دُنیش زندگی <span aria-hidden="true">←</span></a>
                </div>
            </article>
        </div>
    </section>

    <section id="experience" class="experience-section section-shell reveal-section" aria-labelledby="experience-title">
        <div class="experience-intro">
            <p class="eyebrow">یک مسیر ساده</p>
            <h2 id="experience-title">از دادهٔ پراکنده<br />تا تصمیم روشن.</h2>
            <p>دُنیش قرار نیست کار دیگری روی دوشت بگذارد. اطلاعات را مرتب می‌کند تا سریع‌تر به کاری که مهم است برسی.</p>
        </div>
        <ol class="experience-steps">
            <li><span>۰۱</span><div><i aria-hidden="true">◉</i><strong>واقعیت را ثبت کن</strong><p>خرج‌ها و زمان واقعی، ساده و بی‌دردسر کنار هم قرار می‌گیرند.</p></div></li>
            <li><span>۰۲</span><div><i aria-hidden="true">◇</i><strong>الگو را ببین</strong><p>گزارش‌ها به‌جای عدد خام، وضعیت قابل فهم نشان می‌دهند.</p></div></li>
            <li><span>۰۳</span><div><i aria-hidden="true">↗</i><strong>قدم بعدی را بردار</strong><p>برای بودجه، پس‌انداز و زمانت تصمیمی کوچک اما واقعی بگیر.</p></div></li>
        </ol>
    </section>

    <section id="mobile-app" class="download-section section-shell reveal-section" aria-labelledby="mobile-app-title">
        <div class="download-panel">
            <div class="download-copy">
                <p class="eyebrow">همراه دُنیش مالی</p>
                <h2 id="mobile-app-title">پیامک بانکی می‌آید؛<br />خرج، آمادهٔ بررسی می‌شود.</h2>
                <p>برنامهٔ اندروید دُنیش فقط پیامک‌های بانکی انتخاب‌شده را روی گوشی بررسی می‌کند و پس از تأیید تو، خرج را به فضای مالی دلخواه می‌فرستد.</p>
                <div class="download-actions">
                    <a class="button button-light" href="/downloads/donysh-mobile.apk" download>
                        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3v12m0 0 5-5m-5 5-5-5M5 21h14" /></svg>
                        دانلود برنامهٔ اندروید
                    </a>
                    <span>ویژهٔ اندروید</span>
                </div>
            </div>
            <div class="phone-scene" aria-hidden="true">
                <div class="phone-shell">
                    <div class="phone-island"></div>
                    <div class="phone-logo"><img src="/landing-assets/images/donysh-mark.png" alt="" width="64" height="64" /></div>
                    <span>خرج تازه پیدا شد</span>
                    <strong>۲٬۴۵۰٬۰۰۰ ریال</strong>
                    <div class="phone-notice"><i>✓</i><span>آمادهٔ بررسی و ارسال</span></div>
                </div>
                <span class="phone-ring ring-a"></span><span class="phone-ring ring-b"></span>
            </div>
        </div>
    </section>

    <section class="final-cta section-shell reveal-section" aria-labelledby="cta-title">
        <div class="cta-mark" aria-hidden="true"><img src="/landing-assets/images/donysh-mark.png" alt="" width="84" height="84" /></div>
        <div>
            <p class="eyebrow">شروع، ساده‌تر از چیزی است که فکر می‌کنی</p>
            <h2 id="cta-title">امروز یک تصمیم روشن‌تر بگیر.</h2>
        </div>
        <a class="button button-light" href="@(products.AuthUrl.TrimEnd('/') + "/Account/Login")">ورود به حساب دُنیش</a>
    </section>
</main>

<footer class="site-footer">
    <div class="section-shell footer-inner">
        <div class="footer-brand">
            <img src="/landing-assets/images/donysh-wordmark.png" alt="دُنیش" width="140" height="46" />
            <p>وضوح برای پول، زمان و مسیر زندگی.</p>
        </div>
        <div class="footer-links">
            <a href="@products.FinanceUrl">دُنیش مالی</a>
            <a href="@products.LifeUrl">دُنیش زندگی</a>
            <a href="/downloads/donysh-mobile.apk" download>برنامهٔ اندروید</a>
            <a href="@products.AuthUrl">حساب کاربری</a>
        </div>
        <p class="copyright">© @DateTime.UtcNow.Year دُنیش</p>
    </div>
</footer>
