@page
@using Microsoft.Extensions.Options
@inject IOptions<LandingLinksOptions> ProductOptions
@{
    ViewData["Title"] = "دُنیش | پول و زمان، روشن‌تر";
    var products = ProductOptions.Value;
    // Start sign-in from a relying product so the central account service receives
    // a valid OIDC return path and can bring the user back after authentication.
    var loginUrl = products.FinanceUrl.TrimEnd('/') + "/Account/Login";
}

<header class="site-header">
    <nav class="nav-shell" aria-label="ناوبری اصلی">
        <a class="brand-link" href="#top" aria-label="دُنیش، صفحهٔ اصلی"><img src="/landing-assets/images/donysh-mark.png" alt="" width="48" height="48" /><span>دُنیش</span></a>
        <div class="nav-links"><a href="#products">محصول‌ها</a><a href="#method">روش دُنیش</a><a href="#mobile">برنامهٔ همراه</a></div>
        <a class="nav-login" href="@loginUrl">ادامه با حساب دُنیش <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg></a>
    </nav>
</header>

<main id="main-content">
    <section id="top" class="hero page-width" aria-labelledby="hero-title">
        <div class="hero-copy">
            <p class="announcement"><span aria-hidden="true"></span> یک حساب برای مدیریت پول و زندگی</p>
            <h1 id="hero-title">پولت را بفهم.<br /><strong>زمانت را زندگی کن.</strong></h1>
            <p class="hero-description">دُنیش اطلاعات پراکنده را به یک تصویر روشن تبدیل می‌کند؛ تا بدانی پولت کجا می‌رود، هفته‌ات چگونه می‌گذرد و قدم بعدی چیست.</p>
            <div class="hero-actions">
                <a class="button primary-button" href="@products.FinanceUrl">شروع با دُنیش مالی <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg></a>
                <a class="button quiet-button" href="@products.LifeUrl">دیدن دُنیش زندگی</a>
            </div>
            <ul class="hero-points" aria-label="مزیت‌های دُنیش"><li><span aria-hidden="true">✓</span>ساده و فارسی</li><li><span aria-hidden="true">✓</span>ورود امن و یکپارچه</li><li><span aria-hidden="true">✓</span>قابل استفاده روی هر دستگاه</li></ul>
        </div>

        <div class="hero-stage" aria-label="نمایی از تجربهٔ دُنیش">
            <span class="stage-orb orb-one" aria-hidden="true"></span><span class="stage-orb orb-two" aria-hidden="true"></span>
            <div class="overview-window">
                <div class="window-bar" aria-hidden="true"><i></i><i></i><i></i><span>نمای امروز</span></div>
                <div class="overview-head">
                    <span class="overview-logo"><img src="/landing-assets/images/donysh-mark.png" alt="" width="72" height="72" /></span>
                    <span><small>سلام، امروز همه‌چیز روشن است</small><strong>نمای شخصی من</strong></span><b>امروز</b>
                </div>
                <div class="overview-grid">
                    <div class="overview-balance"><span>قابل خرج این ماه</span><strong>۱۲٬۴۸۰٬۰۰۰</strong><small>ریال</small><div class="balance-progress"><i></i></div><p><b>۶۲٪</b> از بودجه باقی مانده</p></div>
                    <div class="overview-focus"><span>تمرکز امروز</span><strong>۳ ساعت و ۳۰ دقیقه</strong><div class="focus-bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div><p>دو کار مهم در برنامه داری</p></div>
                </div>
                <div class="overview-list">
                    <div><span class="list-icon violet">↗</span><span><small>پس‌انداز اضطراری</small><strong>در مسیر هدف</strong></span><b>۴۸٪</b></div>
                    <div><span class="list-icon mint">✓</span><span><small>برنامهٔ امروز</small><strong>سه کار انجام شد</strong></span><b>۳ از ۵</b></div>
                </div>
            </div>
            <div class="floating-note finance-note"><span class="note-icon">⌁</span><span><small>خرج تازه ثبت شد</small><strong>۲۴۵٬۰۰۰ ریال</strong></span><b>✓</b></div>
            <div class="floating-note life-note"><img src="/landing-assets/images/donysh-life-logo.png" alt="دنیش زندگی" width="72" height="72" /><span><small>برنامهٔ بعدی</small><strong>مطالعه · ساعت ۱۸</strong></span><b>←</b></div>
        </div>
    </section>

    <section class="proof-strip" aria-label="ویژگی‌های کلیدی"><div class="page-width proof-grid"><div><strong>۱</strong><span>حساب یکپارچه</span></div><div><strong>۲</strong><span>محصول متمرکز</span></div><div><strong>۰</strong><span>تبلیغ و شلوغی اضافه</span></div><p>اطلاعات هر محصول مستقل می‌ماند؛ تجربهٔ استفاده، یکپارچه است.</p></div></section>

    <section id="products" class="products page-width" aria-labelledby="products-title">
        <div class="section-heading"><p class="section-kicker">محصول‌های دُنیش</p><h2 id="products-title">هر چیزی در جای خودش؛<br />همه‌چیز در یک مسیر.</h2><p>برای مدیریت مالی و برنامه‌ریزی زندگی، دو محیط مستقل داری که با همان حساب دُنیش در دسترس‌اند.</p></div>
        <div class="product-grid">
            <article class="product-card finance-card">
                <div class="product-topline"><span>۰۱</span><b>دُنیش مالی</b><i>فعال</i></div>
                <div class="product-icon finance-product-icon" aria-hidden="true"><img src="/landing-assets/images/donysh-mark.png" alt="" width="96" height="96" /></div>
                <h3>تصمیم مالی بهتر،<br />با تصویر واقعی‌تر.</h3><p>مخارج، بودجه‌ها، اقساط و پس‌اندازها را برای خودت یا فضای مشترک مدیریت کن.</p>
                <ul><li>فضاهای مالی شخصی و مشترک</li><li>بودجه و هدف‌های پس‌انداز</li><li>گزارش و دستیار هوشمند</li></ul>
                <a href="@products.FinanceUrl">ورود به دُنیش مالی <span aria-hidden="true">←</span></a>
                <div class="finance-visual" aria-hidden="true"><div><small>بودجهٔ خرید</small><strong>۷۲٪</strong><i><b></b></i></div><div><small>پس‌انداز این ماه</small><strong>۳٬۰۰۰٬۰۰۰</strong><i><b></b></i></div></div>
            </article>
            <article class="product-card life-card">
                <div class="product-topline"><span>۰۲</span><b>دُنیش زندگی</b><i>نسخهٔ آغازین</i></div>
                <div class="life-logo-frame"><img src="/landing-assets/images/donysh-life-logo.png" alt="دنیش زندگی" width="210" height="210" /></div>
                <h3>هفته‌ای که برای<br />زندگی تو ساخته شده.</h3><p>برنامه را بچین، زمان واقعی فعالیت‌ها را ثبت کن و پیشرفتت را بدون حدس‌زدن ببین.</p>
                <ul><li>نمای روز و هفته</li><li>ثبت نتیجهٔ واقعی</li><li>گزارش پیشرفت زمانی</li></ul>
                <a href="@products.LifeUrl">ورود به دُنیش زندگی <span aria-hidden="true">←</span></a>
                <div class="life-visual" aria-hidden="true"><span>شنبه</span><span>یکشنبه</span><span>دوشنبه</span><span>سه‌شنبه</span><i></i><i></i><i></i><i></i></div>
            </article>
        </div>
    </section>

    <section id="method" class="method-section"><div class="page-width method-layout">
        <div class="method-copy"><p class="section-kicker">روش دُنیش</p><h2>کمتر حدس بزن؛<br />روشن‌تر تصمیم بگیر.</h2><p>قرار نیست هر روز وقت زیادی برای مدیریت ابزارها بگذاری. دُنیش واقعیت را جمع می‌کند و قدم بعدی را واضح‌تر نشان می‌دهد.</p><a class="inline-link" href="@loginUrl">ادامه با حساب دُنیش <span aria-hidden="true">←</span></a></div>
        <ol class="method-steps"><li><span>۱</span><div><strong>واقعیت را ثبت کن</strong><p>خرج‌ها، بودجه‌ها و زمانی که واقعاً صرف کرده‌ای.</p></div></li><li><span>۲</span><div><strong>تصویر را ببین</strong><p>گزارشی کوتاه و قابل فهم، بدون عددهای پراکنده.</p></div></li><li><span>۳</span><div><strong>قدم بعدی را بردار</strong><p>یک تصمیم کوچک برای پول، زمان یا هدف‌هایت.</p></div></li></ol>
    </div></section>

    <section id="mobile" class="mobile-section page-width" aria-labelledby="mobile-title"><div class="mobile-card">
        <div class="mobile-copy"><p class="section-kicker light-kicker">برنامهٔ همراه دُنیش مالی</p><h2 id="mobile-title">پیامک بانکی می‌آید؛<br />خرج آمادهٔ بررسی می‌شود.</h2><p>برنامهٔ اندروید فقط پیامک‌های انتخاب‌شده را روی گوشی تحلیل می‌کند. پس از تأیید تو، مبلغ و عنوان خرج به فضای مالی دلخواه فرستاده می‌شود.</p><div class="mobile-actions"><a class="button download-button" href="/downloads/donysh-mobile.apk" download><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 5-5m-5 5-5-5M5 21h14" /></svg>دانلود برنامهٔ اندروید</a><span>ویژهٔ اندروید</span></div></div>
        <div class="phone-wrap" aria-hidden="true"><div class="phone"><span class="phone-camera"></span><div class="phone-brand"><img src="/landing-assets/images/donysh-mark.png" alt="" width="56" height="56" /><span><small>دُنیش همراه</small><strong>پیامک تازه</strong></span></div><div class="phone-expense"><small>برداشت شناسایی‌شده</small><strong>۱٬۴۰۰٬۰۰۰ ریال</strong><span>بلو بانک · امروز ۱۷:۵۵</span></div><div class="phone-title"><small>عنوان پیشنهادی</small><strong>خرید روزانه</strong></div><div class="phone-confirm">آمادهٔ تأیید</div></div></div>
    </div></section>

    <section class="closing page-width" aria-labelledby="closing-title"><div class="closing-mark"><img src="/landing-assets/images/donysh-mark.png" alt="" width="96" height="96" /></div><div><p>شروع از همین امروز</p><h2 id="closing-title">یک تصمیم روشن‌تر، کافی است.</h2></div><a class="button closing-button" href="@loginUrl">ادامه با دُنیش</a></section>
</main>

<footer class="site-footer"><div class="page-width footer-grid">
    <div class="footer-brand"><a class="footer-brand-lockup" href="#top" aria-label="دُنیش، صفحهٔ اصلی"><img src="/landing-assets/images/donysh-mark.png" alt="" width="48" height="48" /><strong>دُنیش</strong></a><p>وضوح برای پول، زمان و مسیر زندگی.</p></div>
    <div class="footer-column"><strong>محصول‌ها</strong><a href="@products.FinanceUrl">دُنیش مالی</a><a href="@products.LifeUrl">دُنیش زندگی</a><a href="/downloads/donysh-mobile.apk" download>برنامهٔ همراه</a></div>
    <div class="footer-column"><strong>حساب</strong><a href="@loginUrl">ادامه با حساب دُنیش</a><a href="@products.AuthUrl">مرکز حساب کاربری</a></div>
    <p class="copyright">© @DateTime.UtcNow.Year دُنیش؛ ساخته‌شده برای تصمیم‌های روشن‌تر.</p>
</div></footer>
