@page
@model IndexModel
@{
    ViewData["Title"] = "حساب مرکزی";
}
<section class="simple-card status-card">
    <partial name="_Brand" />
    <div class="status-illustration success-illustration" aria-hidden="true"><span>✓</span></div>
    <p class="eyebrow">حساب آماده است</p>
    <h1>ورود با موفقیت انجام شد</h1>
    <p>حساب مرکزی شما فعال است. یکی از محصولات دُنیش را برای ادامه انتخاب کنید.</p>
    <div class="destination-grid">
        <a href="https://finance.donysh.ir/" class="destination-card"><span class="destination-icon finance-destination" aria-hidden="true">◒</span><span><strong>دُنیش مالی</strong><small>بودجه، مخارج و هدف‌ها</small></span><b aria-hidden="true">←</b></a>
        <a href="https://life.donysh.ir/" class="destination-card"><span class="destination-icon life-destination" aria-hidden="true">◫</span><span><strong>دُنیش زندگی</strong><small>برنامهٔ روز و هفته</small></span><b aria-hidden="true">←</b></a>
    </div>
    <form method="post" asp-page="/Account/Logout" class="quiet-form">
        <button class="text-button" type="submit">خروج از حساب مرکزی</button>
    </form>
</section>
