@page
@{
    ViewData["Title"] = "خروج انجام شد";
}
<section class="simple-card status-card">
    <partial name="_Brand" />
    <div class="status-illustration success-illustration" aria-hidden="true"><span>✓</span></div>
    <p class="eyebrow">نشست پایان یافت</p>
    <h1>با خیال راحت خارج شدید</h1>
    <p>نشست حساب مرکزی روی این مرورگر بسته شد. اطلاعات شما همچنان امن و دست‌نخورده باقی می‌ماند.</p>
    <div class="simple-actions">
        <a asp-page="/Account/Login" class="primary-button"><span>ورود دوباره</span><span aria-hidden="true">←</span></a>
        <a href="https://donysh.ir/" class="secondary-button">رفتن به صفحهٔ اصلی دُنیش</a>
    </div>
</section>
