@page
@model Donysh.Auth.Pages.Account.ChangePasswordModel
@{ ViewData["Title"] = "تغییر رمز عبور"; }
<section class="form-card account-action-card"><partial name="_Brand" /><a asp-page="/Account/Manage" class="account-back">بازگشت به مدیریت حساب ←</a><header class="panel-header"><p class="eyebrow">امنیت حساب</p><h1>تغییر رمز عبور</h1><p>رمز تازه باید حداقل ۸ نویسه، یک حرف لاتین کوچک و یک عدد داشته باشد.</p></header>
    <form method="post" class="auth-form"><div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div><div class="field"><label asp-for="Input.CurrentPassword"></label><input asp-for="Input.CurrentPassword" autocomplete="current-password" required /><span asp-validation-for="Input.CurrentPassword"></span></div><div class="field"><label asp-for="Input.NewPassword"></label><input asp-for="Input.NewPassword" autocomplete="new-password" required /><span asp-validation-for="Input.NewPassword"></span></div><div class="field"><label asp-for="Input.ConfirmPassword"></label><input asp-for="Input.ConfirmPassword" autocomplete="new-password" required /><span asp-validation-for="Input.ConfirmPassword"></span></div><button class="primary-button" type="submit">ذخیرهٔ رمز تازه</button></form>
</section>
