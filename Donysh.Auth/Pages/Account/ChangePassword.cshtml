@page
@model Donysh.Auth.Pages.Account.ChangePasswordModel
@{ ViewData["Title"] = "تغییر رمز عبور"; }
<section class="form-card account-action-card change-password-card">
    <div class="account-action-top"><partial name="_Brand" /><a asp-page="/Account/Manage" class="account-back">بازگشت به مدیریت حساب ←</a></div>
    <header class="panel-header"><p class="eyebrow">امنیت حساب</p><h1>تغییر رمز عبور</h1><p>رمز فعلی را وارد کنید و برای حساب خود رمزی تازه بسازید.</p></header>
    <form method="post" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <div class="field"><label asp-for="Input.CurrentPassword"></label><div class="password-field" dir="ltr"><input asp-for="Input.CurrentPassword" class="password-input" autocomplete="current-password" required /><button type="button" class="password-toggle" data-password-toggle aria-controls="Input_CurrentPassword" aria-label="نمایش رمز عبور" aria-pressed="false"><partial name="_PasswordVisibilityIcon" /></button></div><span asp-validation-for="Input.CurrentPassword"></span></div>
        <div class="field"><label asp-for="Input.NewPassword"></label><div class="password-field" dir="ltr"><input asp-for="Input.NewPassword" class="password-input" autocomplete="new-password" data-new-password required /><button type="button" class="password-toggle" data-password-toggle aria-controls="Input_NewPassword" aria-label="نمایش رمز عبور" aria-pressed="false"><partial name="_PasswordVisibilityIcon" /></button></div><span asp-validation-for="Input.NewPassword"></span></div>
        <ul class="password-rules" data-password-rules aria-label="شرایط رمز تازه">
            <li data-password-rule="length"><span aria-hidden="true">✓</span> دست‌کم ۸ نویسه</li>
            <li data-password-rule="letter"><span aria-hidden="true">✓</span> دست‌کم یک حرف لاتین کوچک</li>
            <li data-password-rule="digit"><span aria-hidden="true">✓</span> دست‌کم یک عدد</li>
        </ul>
        <div class="field"><label asp-for="Input.ConfirmPassword"></label><div class="password-field" dir="ltr"><input asp-for="Input.ConfirmPassword" class="password-input" autocomplete="new-password" required /><button type="button" class="password-toggle" data-password-toggle aria-controls="Input_ConfirmPassword" aria-label="نمایش رمز عبور" aria-pressed="false"><partial name="_PasswordVisibilityIcon" /></button></div><span asp-validation-for="Input.ConfirmPassword"></span></div>
        <button class="primary-button" type="submit">ذخیرهٔ رمز تازه</button>
    </form>
</section>
