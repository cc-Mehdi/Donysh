@page
@model Donysh.Auth.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "رمز عبور جدید";
}
<section class="form-card">
    <partial name="_Brand" />
    <header class="panel-header"><p class="eyebrow">بازیابی امن</p><h1>رمز عبور جدید</h1><p>یک رمز عبور تازه و غیرتکراری انتخاب کنید.</p></header>
    <form method="post" class="auth-form">
        <input asp-for="Input.Email" type="hidden" /><input asp-for="Input.Code" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="field"><label asp-for="Input.Password"></label><input asp-for="Input.Password" autocomplete="new-password" dir="ltr" /><span asp-validation-for="Input.Password"></span></div>
        <div class="field"><label asp-for="Input.ConfirmPassword"></label><input asp-for="Input.ConfirmPassword" autocomplete="new-password" dir="ltr" /><span asp-validation-for="Input.ConfirmPassword"></span></div>
        <button class="primary-button" type="submit">ثبت رمز عبور جدید</button>
    </form>
</section>
