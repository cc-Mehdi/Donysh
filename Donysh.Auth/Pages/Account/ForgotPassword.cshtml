@page
@model Donysh.Auth.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "بازیابی رمز عبور";
}
<section class="form-card">
    <partial name="_Brand" />
    <header class="panel-header"><p class="eyebrow">بازیابی امن</p><h1>رمز عبور را فراموش کرده‌اید؟</h1><p>اگر حساب واجد شرایط باشد، پیوند بازیابی برایتان ارسال می‌شود.</p></header>
    @if (!Model.Available)
    {
        <div class="phase-notice" role="status"><span>◉</span><p>بازیابی رمز تا پایان انتقال امن حساب‌های فعلی فعال نیست.</p></div>
    }
    else
    {
        <form method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="field"><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" dir="ltr" /><span asp-validation-for="Email"></span></div>
            <button class="primary-button" type="submit">ارسال پیوند بازیابی</button>
        </form>
    }
    <a asp-page="/Account/Login" class="text-link">بازگشت به ورود</a>
</section>
