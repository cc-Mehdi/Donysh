@page
@model Donysh.Auth.Pages.Account.LoginModel
@{
    ViewData["Title"] = "ورود";
}
<div class="auth-frame">
    <section class="auth-story" aria-labelledby="story-title">
        <partial name="_Brand" />
        <div class="story-copy">
            <span class="eyebrow">یک حساب، همهٔ ابزارهای دُنیش</span>
            <h1 id="story-title">ورود ساده و امن به اکوسیستم دُنیش</h1>
            <p>این سرویس، پایهٔ ورود یکپارچهٔ محصولات دُنیش است. اطلاعات هر محصول همچنان در فضای مستقل خودش باقی می‌ماند.</p>
        </div>
        <ul class="trust-list" aria-label="ویژگی‌های امنیتی">
            <li><span>✓</span> نشست مستقل و محافظت‌شده</li>
            <li><span>✓</span> ارتباط رمزگذاری‌شده در محیط عملیاتی</li>
            <li><span>✓</span> دسترسی فقط با تأیید خود شما</li>
        </ul>
    </section>

    <section class="auth-panel" aria-labelledby="login-title">
        <div class="mobile-brand"><partial name="_Brand" /></div>
        @if (!Model.MigrationCompleted)
        {
            <div class="phase-notice" role="status">
                <span aria-hidden="true">◉</span>
                <p><strong>نسخهٔ زیرساختی</strong> حساب‌های فعلی بخش مالی هنوز به این صفحه منتقل نشده‌اند.</p>
            </div>
        }
        <header class="panel-header">
            <p class="eyebrow">حساب مرکزی دُنیش</p>
            <h2 id="login-title">خوش آمدید</h2>
            <p>برای ادامه، ایمیل و رمز عبور حساب مرکزی را وارد کنید.</p>
        </header>

        <form method="post" asp-page="/Account/Login" class="auth-form">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <div class="field">
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" autocomplete="email" inputmode="email" dir="ltr" autofocus />
                <span asp-validation-for="Input.Email"></span>
            </div>
            <div class="field">
                <div class="field-heading">
                    <label asp-for="Input.Password"></label>
                    @if (Model.PasswordRecoveryAvailable)
                    {
                        <a asp-page="/Account/ForgotPassword">رمز عبور را فراموش کرده‌اید؟</a>
                    }
                </div>
                <div class="password-field" dir="ltr">
                    <input asp-for="Input.Password" class="password-input" autocomplete="current-password" dir="ltr" />
                    <button type="button" class="password-toggle" data-password-toggle
                            aria-controls="Input_Password" aria-label="نمایش رمز عبور" aria-pressed="false">
                        <svg data-eye-open aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" />
                            <circle cx="12" cy="12" r="2.75" />
                        </svg>
                        <svg data-eye-closed aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" hidden>
                            <path d="m3 3 18 18M10.6 6.1A9.9 9.9 0 0 1 12 6c6 0 9.5 6 9.5 6a15.7 15.7 0 0 1-2.2 2.8M6.2 6.2C3.8 7.8 2.5 12 2.5 12s3.5 6 9.5 6a9.8 9.8 0 0 0 3.1-.5M9.9 9.9a3 3 0 0 0 4.2 4.2" />
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Input.Password"></span>
            </div>
            <label class="check-row">
                <input asp-for="Input.RememberMe" />
                <span>ورود من را روی این دستگاه حفظ کن</span>
            </label>
            <button class="primary-button" type="submit">ورود امن</button>
        </form>

        @if (Model.RegistrationAvailable)
        {
            <p class="panel-foot">حساب ندارید؟ <a asp-page="/Account/Register">ساخت حساب مرکزی</a></p>
        }
        else
        {
            <p class="panel-foot muted">
                @(Model.MigrationCompleted
                    ? "ساخت حساب جدید در حال حاضر غیرفعال است."
                    : "ساخت حساب جدید پس از آماده‌شدن انتقال کاربران فعال می‌شود.")
            </p>
        }
    </section>
</div>
