# تنظیمات اصلی برنامه
POSTGRES_DB=hesabyar
POSTGRES_USER=hesabyar
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
TZ=Asia/Tehran
APP_PORT=8080

# دامنه‌های عمومی سامانه؛ در مرحلهٔ انتقال، DOMAIN همچنان نسخهٔ مالی فعلی را نیز ارائه می‌کند.
DOMAIN=example.com
FINANCE_DOMAIN=finance.example.com
ACME_EMAIL=admin@example.com

# سرویس مستقل احراز هویت؛ این مقادیر فقط با docker-compose.platform.yml استفاده می‌شوند.
AUTH_DOMAIN=auth.example.com
LIFE_DOMAIN=life.example.com
AUTH_POSTGRES_DB=donysh_auth
AUTH_POSTGRES_USER=donysh_auth
AUTH_POSTGRES_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_PASSWORD
AUTH_SIGNING_CERT_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_CERTIFICATE_PASSWORD
AUTH_ENCRYPTION_CERT_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_CERTIFICATE_PASSWORD
FINANCE_OIDC_CLIENT_SECRET=REPLACE_WITH_A_LONG_RANDOM_OIDC_CLIENT_SECRET
CROSS_APP_LOGOUT_SECRET=REPLACE_WITH_A_SHARED_LONG_RANDOM_LOGOUT_SECRET

# پایگاه داده و کلید ارتباطی مستقل دُنیش زندگی
LIFE_POSTGRES_DB=donysh_life
LIFE_POSTGRES_USER=donysh_life
LIFE_POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
LIFE_OIDC_CLIENT_SECRET=REPLACE_WITH_A_LONG_RANDOM_OIDC_CLIENT_SECRET

# این دو پرچم فقط پس از انتقال و بررسی کاربران روی سرور فعال می‌شوند.
LEGACY_IDENTITY_IMPORT_COMPLETED=false
CENTRAL_AUTH_ENABLED=false

# ثبت‌نام و ارسال پیام حساب مرکزی. برای فعال‌شدن عملی ثبت‌نام، SMTP باید کامل باشد.
AUTH_PUBLIC_REGISTRATION=true
AUTH_PASSWORD_RECOVERY=true
AUTH_SMTP_HOST=smtp.example.com
AUTH_SMTP_PORT=587
AUTH_SMTP_USE_SSL=true
AUTH_SMTP_TIMEOUT_SECONDS=20
AUTH_SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
AUTH_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
AUTH_SMTP_FROM_ADDRESS=no-reply@example.com
AUTH_SMTP_FROM_NAME=Donysh
