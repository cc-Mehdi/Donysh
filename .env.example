# تنظیمات اصلی برنامه
POSTGRES_DB=hesabyar
POSTGRES_USER=hesabyar
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
TZ=Asia/Tehran
APP_PORT=8080

# این دو مقدار فقط هنگام اتصال دامنه استفاده می‌شوند.
DOMAIN=example.com
ACME_EMAIL=admin@example.com

# سرویس مستقل احراز هویت؛ این مقادیر فقط با docker-compose.platform.yml استفاده می‌شوند.
AUTH_DOMAIN=auth.example.com
AUTH_POSTGRES_DB=donysh_auth
AUTH_POSTGRES_USER=donysh_auth
AUTH_POSTGRES_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_PASSWORD
AUTH_SIGNING_CERT_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_CERTIFICATE_PASSWORD
AUTH_ENCRYPTION_CERT_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_CERTIFICATE_PASSWORD
FINANCE_OIDC_CLIENT_SECRET=REPLACE_WITH_A_LONG_RANDOM_OIDC_CLIENT_SECRET

# این دو پرچم فقط پس از انتقال و بررسی کاربران روی سرور فعال می‌شوند.
LEGACY_IDENTITY_IMPORT_COMPLETED=false
CENTRAL_AUTH_ENABLED=false
