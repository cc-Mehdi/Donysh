<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:DonyshMobile.UI"
             x:Class="DonyshMobile.SenderPickerPage"
             FlowDirection="RightToLeft" Title="انتخاب فرستنده">
    <Grid x:Name="PickerContent" Padding="20,18" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
        <VerticalStackLayout Spacing="6">
            <Label Text="انتخاب فرستنده" Style="{StaticResource PageTitle}" />
            <Label Text="یک شماره یا نام را از پیامک‌های اخیر انتخاب کنید. نیازی به وارد کردن پیش‌شماره نیست."
                   Style="{StaticResource MutedText}" />
        </VerticalStackLayout>
        <SearchBar Grid.Row="1" x:Name="SenderSearch" Placeholder="جست‌وجوی شماره یا نام"
                   TextChanged="OnSearchChanged" />
        <Label Grid.Row="2" x:Name="ResultCountLabel" FontSize="12" Style="{StaticResource MutedText}" />
        <CollectionView Grid.Row="3" x:Name="SenderList" SelectionMode="Single"
                        SelectionChanged="OnSenderSelected">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="16,30" Spacing="10">
                    <Label Text="فرستنده‌ای پیدا نشد" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Label Text="عبارت کوتاه‌تری جست‌وجو کنید یا به صفحه قبل برگردید و فرستنده را دستی اضافه کنید."
                           Style="{StaticResource MutedText}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E0E7FF, Dark=#312E81}" />
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light=#6366F1, Dark=#A5B4FC}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Text="{Binding .}" FontSize="17" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="{x:Static ui:AppIcons.CheckCircle}" Style="{StaticResource SectionIcon}" FontSize="17" WidthRequest="22" />
                                <Label Text="انتخاب" Style="{StaticResource MutedText}" FontSize="12" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14">
            <VerticalStackLayout Spacing="10">
                <Label x:Name="SelectionLabel" Text="یک فرستنده از فهرست انتخاب کنید."
                       Style="{StaticResource MutedText}" />
                <ui:DonyshButton x:Name="ConfirmButton" Glyph="{x:Static ui:AppIcons.Add}" Text="افزودن به فرستنده‌های تحت نظر" IsEnabled="False"
                        Clicked="OnConfirmClicked" Style="{StaticResource PrimaryAction}" />
                <Label Text="پیامک‌های قدیمی وارد نمی‌شوند؛ از این پس پیام‌های جدید این فرستنده ثبت می‌شوند."
                       FontSize="12" Style="{StaticResource MutedText}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
