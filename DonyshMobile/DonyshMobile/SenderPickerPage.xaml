<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DonyshMobile.SenderPickerPage"
             FlowDirection="RightToLeft" Title="انتخاب فرستنده">
    <Grid Padding="20,18" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Label Text="فرستنده را از پیامک‌های دریافتی انتخاب کنید" Style="{StaticResource PageTitle}" />
        <SearchBar Grid.Row="1" x:Name="SenderSearch" Placeholder="جست‌وجوی شماره یا نام"
                   TextChanged="OnSearchChanged" />
        <CollectionView Grid.Row="2" x:Name="SenderList" SelectionMode="Single"
                        SelectionChanged="OnSenderSelected">
            <CollectionView.EmptyView>
                <Label Text="فرستنده‌ای پیدا نشد." Style="{StaticResource MutedText}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8">
                        <Label Text="{Binding .}" FontSize="17" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
