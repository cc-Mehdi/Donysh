<?xml version="1.0" encoding="utf-8" ?>
<ui:DonyshPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:DonyshMobile.UI"
             x:Class="DonyshMobile.ConnectionPage" Title="تنظیمات و اتصال">
    <ScrollView>
        <VerticalStackLayout x:Name="ConnectionContent" Padding="18,12,18,28" Spacing="14" MaximumWidthRequest="800" HorizontalOptions="Fill">
            <VerticalStackLayout Spacing="4">
                <Label x:Name="PageHeadingLabel" Text="همه‌چیز تحت کنترل شما" Style="{StaticResource PageTitle}" />
                <Label x:Name="PageDescriptionLabel" Text="مقصد ارسال، عنوان پیام‌ها و ظاهر برنامه را تنظیم کنید." Style="{StaticResource MutedText}" />
            </VerticalStackLayout>
            <Border x:Name="ConnectionStatusCard" Style="{StaticResource InfoCard}" Padding="18">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Text="{x:Static ui:AppIcons.Sync}" Style="{StaticResource SectionIcon}" />
                        <Label Grid.Column="1" Text="اتصال و وضعیت ارسال" Style="{StaticResource SectionTitle}" />
                    </Grid>
                    <Label x:Name="ConnectionStatusLabel" FontSize="16" FontAttributes="Bold" />
                    <Label x:Name="NetworkStatusLabel" Style="{StaticResource Caption}" />
                    <Label x:Name="QueueStatusLabel" Style="{StaticResource StatusBadge}" />
                    <Label x:Name="LastStatusLabel" Style="{StaticResource MutedText}" />
                    <ui:DonyshButton x:Name="ManualSyncButton" Glyph="{x:Static ui:AppIcons.Send}" Text="ارسال دستی یک نوبت" Clicked="OnSyncClicked" Style="{StaticResource PrimaryAction}" />
                    <Label Text="در هر نوبت تا ۵ پیام فرستاده می‌شود. پیام‌ها فقط پس از تأیید سامانه، ارسال‌شده می‌شوند." Style="{StaticResource Caption}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button x:Name="ChangeConnectionButton" Text="تغییر مقصد" Clicked="OnChangeConnectionClicked" Style="{StaticResource QuietAction}" />
                        <Button x:Name="DisconnectButton" Grid.Column="1" Text="قطع اتصال" Clicked="OnDisconnectClicked" Style="{StaticResource DangerAction}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Border x:Name="PairingCard" Style="{StaticResource Card}" Padding="18">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Text="{x:Static ui:AppIcons.Link}" Style="{StaticResource SectionIcon}" />
                        <Label Grid.Column="1" Text="وصل‌کردن گوشی به دونیش" Style="{StaticResource SectionTitle}" />
                    </Grid>
                    <Label Text="۱. در سایت، «همراه دونیش» را باز کنید و فضای مالی و دستهٔ مقصد را انتخاب کنید.&#10;۲. کد اتصال بسازید و همین‌جا وارد کنید." Style="{StaticResource MutedText}" />
                    <Label Text="کد اتصال یک‌بارمصرف" FontAttributes="Bold" />
                    <Border Style="{StaticResource FieldCard}">
                        <Entry x:Name="PairCodeEntry" Placeholder="کد را از سایت کپی کنید" MaxLength="40" IsPassword="True"
                               IsTextPredictionEnabled="False" IsSpellCheckEnabled="False" ReturnType="Done"
                               Completed="OnConnectClicked" FlowDirection="LeftToRight" HorizontalTextAlignment="Start" />
                    </Border>
                    <Button x:Name="CustomServerButton" Text="آدرس سایت متفاوت است؟" Clicked="OnToggleServerClicked" Style="{StaticResource QuietAction}" />
                    <VerticalStackLayout x:Name="ServerPanel" IsVisible="False" Spacing="6">
                        <Label Text="آدرس سایت مورد اعتماد شما" FontAttributes="Bold" />
                        <Border Style="{StaticResource FieldCard}">
                            <Entry x:Name="ServerEntry" Placeholder="https://donysh.ir" Keyboard="Url" MaxLength="200"
                                   IsTextPredictionEnabled="False" IsSpellCheckEnabled="False" FlowDirection="LeftToRight" HorizontalTextAlignment="Start" />
                        </Border>
                    </VerticalStackLayout>
                    <ui:DonyshButton x:Name="ConnectButton" Glyph="{x:Static ui:AppIcons.Security}" Text="اتصال امن به سامانه" Clicked="OnConnectClicked" Style="{StaticResource SuccessAction}" />
                </VerticalStackLayout>
            </Border>
            <Border x:Name="BusyCard" IsVisible="False" Style="{StaticResource AccentCard}" Padding="15">
                <HorizontalStackLayout Spacing="12">
                    <ActivityIndicator x:Name="BusyIndicator" IsRunning="False" />
                    <Label Text="در حال انجام درخواست…" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <Border x:Name="TitleSettingsCard" Style="{StaticResource Card}" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="5">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="{x:Static ui:AppIcons.Title}" Style="{StaticResource SectionIcon}" />
                                <Label Grid.Column="1" Text="عنوان پیش از ارسال" Style="{StaticResource SectionTitle}" />
                            </Grid>
                            <Label Text="پیام‌های تازه تا نوشتن عنوان منتظر می‌مانند. با خاموش‌کردن این گزینه، ارسال خودکار بدون عنوان هم انجام می‌شود." Style="{StaticResource MutedText}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" x:Name="RequireTitleSwitch" Toggled="OnRequireTitleToggled" SemanticProperties.Description="عنوان برای ارسال خودکار الزامی باشد" />
                    </Grid>
                    <Button Text="عنوان‌گذاری پیام‌های منتظر" Clicked="OnPendingTitlesClicked" Style="{StaticResource SecondaryAction}" />
                    <Button x:Name="NotificationSettingsButton" Text="تنظیمات اعلان‌های گوشی" Clicked="OnNotificationSettingsClicked" Style="{StaticResource QuietAction}" />
                </VerticalStackLayout>
            </Border>
            <Border x:Name="AppearanceCard" Style="{StaticResource Card}" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Text="{x:Static ui:AppIcons.Palette}" Style="{StaticResource SectionIcon}" />
                        <Label Grid.Column="1" Text="ظاهر و حس برنامه" Style="{StaticResource SectionTitle}" />
                    </Grid>
                    <ui:DonyshPicker x:Name="ThemePicker" Title="رنگ‌بندی برنامه" SelectedIndexChanged="OnThemeChanged">
                        <ui:DonyshPicker.Items><x:String>هماهنگ با گوشی</x:String><x:String>روشن</x:String><x:String>تیره</x:String></ui:DonyshPicker.Items>
                    </ui:DonyshPicker>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="حرکت‌های نرم رابط" FontAttributes="Bold" />
                            <Label Text="کوتاه و بدون حرکت‌های تکرارشونده" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" x:Name="MotionSwitch" Toggled="OnMotionToggled" SemanticProperties.Description="حرکت‌های رابط" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="بازخورد لمسی هنگام ثبت" FontAttributes="Bold" VerticalOptions="Center" />
                        <Switch Grid.Column="1" x:Name="HapticsSwitch" Toggled="OnHapticsToggled" SemanticProperties.Description="بازخورد لمسی" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Border x:Name="PrivacyCard" Style="{StaticResource AccentCard}" Padding="18">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Text="{x:Static ui:AppIcons.Security}" Style="{StaticResource SectionIcon}" />
                        <Label Grid.Column="1" Text="حریم خصوصی پیام‌های شما" Style="{StaticResource SectionTitle}" />
                    </Grid>
                    <Label Text="داده‌های پیامکی روی گوشی رمزگذاری می‌شوند. فقط پیام‌های فرستنده‌های انتخابی به مقصد اتصال شما ارسال می‌شوند. پیام‌های تأییدشده پس از هفت روز از گوشی پاک می‌شوند؛ پیام‌های ارسال‌نشده در صف می‌مانند." Style="{StaticResource MutedText}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ui:DonyshPage>
