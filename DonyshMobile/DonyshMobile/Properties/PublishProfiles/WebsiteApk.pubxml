<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net9.0-android</TargetFramework>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
    <PublishTrimmed>true</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(DONYSH_ANDROID_KEYSTORE)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>$(DONYSH_ANDROID_KEY_ALIAS)</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>env:DONYSH_ANDROID_STORE_PASSWORD</AndroidSigningStorePass>
    <AndroidSigningKeyPass>env:DONYSH_ANDROID_KEY_PASSWORD</AndroidSigningKeyPass>
  </PropertyGroup>
  <Target Name="ValidateWebsiteApkSigning" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(DONYSH_ANDROID_KEYSTORE)' == ''"
           Text="Set DONYSH_ANDROID_KEYSTORE to the absolute path of the permanent release keystore." />
    <Error Condition="'$(DONYSH_ANDROID_KEY_ALIAS)' == ''"
           Text="Set DONYSH_ANDROID_KEY_ALIAS to the permanent release key alias." />
    <Error Condition="'$(DONYSH_ANDROID_STORE_PASSWORD)' == ''"
           Text="Set DONYSH_ANDROID_STORE_PASSWORD before publishing the website APK." />
    <Error Condition="'$(DONYSH_ANDROID_KEY_PASSWORD)' == ''"
           Text="Set DONYSH_ANDROID_KEY_PASSWORD before publishing the website APK." />
    <Error Condition="!Exists('$(DONYSH_ANDROID_KEYSTORE)')"
           Text="The release keystore was not found at '$(DONYSH_ANDROID_KEYSTORE)'." />
  </Target>
</Project>
