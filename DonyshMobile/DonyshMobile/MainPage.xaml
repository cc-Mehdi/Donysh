<?xml version="1.0" encoding="utf-8" ?>
<ui:DonyshPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DonyshMobile"
             xmlns:ui="clr-namespace:DonyshMobile.UI"
             x:Class="DonyshMobile.MainPage" x:DataType="local:MainPage"
             Title="دُنیش" Shell.NavBarIsVisible="False">
    <Grid x:Name="PageContent" Padding="18,12" RowDefinitions="Auto,*" RowSpacing="14">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Image Source="donysh_logo.png" WidthRequest="42" HeightRequest="42" SemanticProperties.Description="نشان دُنیش" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                <Label Text="دُنیش همراه" FontSize="21" FontFamily="YekanBakhBold" />
                <Label Text="همراهِ خرج‌های روزانه" Style="{StaticResource Caption}" />
            </VerticalStackLayout>
            <ui:DonyshButton x:Name="SettingsButton" Grid.Column="2" Glyph="{x:Static ui:AppIcons.Settings}" Text="تنظیمات" Clicked="OnConnectionClicked" Style="{StaticResource QuietAction}"
                    SemanticProperties.Hint="اتصال به سامانه، ظاهر و تنظیمات ارسال" />
        </Grid>
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Refreshing="OnRefreshing">
            <CollectionView ItemsSource="{Binding Senders}" SelectionMode="Single" SelectionChanged="OnSenderSelected">
                <CollectionView.Header>
                    <VerticalStackLayout Spacing="14" Padding="0,0,0,12">
                        <Border Padding="20" StrokeThickness="0" StrokeShape="RoundRectangle 26">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                                    <GradientStop Color="#5143D8" Offset="0" />
                                    <GradientStop Color="#087F82" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <VerticalStackLayout Spacing="9">
                                <Label Text="{Binding ConnectionText}" FontSize="12" TextColor="#DDEBFF" />
                                <Label Text="پیامک‌ها، مرتب و آماده" FontSize="23" FontAttributes="Bold" TextColor="White" />
                                <Label Text="{Binding NextStepText}" FontSize="14" LineHeight="1.35" TextColor="#E0EAFF" />
                                <ui:DonyshButton x:Name="NextStepButton" Glyph="{x:Static ui:AppIcons.Back}" Text="{Binding NextStepAction}" Clicked="OnNextStepClicked" BackgroundColor="White"
                                        TextColor="#37328E" HorizontalOptions="Start" Margin="0,4,0,0"
                                        IsVisible="{Binding HasNextStep}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Style="{StaticResource InfoCard}" Padding="14" IsVisible="{Binding HasConnection}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Label Text="{x:Static ui:AppIcons.Workspace}" Style="{StaticResource SectionIcon}" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="فضای مالی پیش‌فرض" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding WorkspaceText}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <ui:DonyshButton Grid.Column="2" Glyph="{x:Static ui:AppIcons.Sync}" Text="تغییر"
                                                 Clicked="OnWorkspaceShortcutClicked" Style="{StaticResource SecondaryAction}" />
                            </Grid>
                        </Border>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="9">
                            <Border x:Name="SenderStatCard" Style="{StaticResource StatInfoCard}">
                                <VerticalStackLayout Spacing="2">
                                    <Label x:Name="SenderStatIcon" Text="{x:Static ui:AppIcons.Sms}" Style="{StaticResource StatIcon}"
                                           TextColor="{AppThemeBinding Light=#1478A8, Dark=#78C9EF}" />
                                    <Label Text="{Binding SenderCount}" FontSize="25" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#105F87, Dark=#A3DCF5}" />
                                    <Label Text="فرستنده" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border x:Name="PendingStatCard" Grid.Column="1" Style="{StaticResource StatWarningCard}">
                                <VerticalStackLayout Spacing="2">
                                    <Label x:Name="PendingStatIcon" Text="{x:Static ui:AppIcons.Schedule}" Style="{StaticResource StatIcon}"
                                           TextColor="{AppThemeBinding Light=#B65D08, Dark=#F5BB62}" />
                                    <Label Text="{Binding PendingCount}" FontSize="25" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#9A4D08, Dark=#FFD18B}" />
                                    <Label Text="در انتظار" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border x:Name="SentStatCard" Grid.Column="2" Style="{StaticResource StatSuccessCard}">
                                <VerticalStackLayout Spacing="2">
                                    <Label x:Name="SentStatIcon" Text="{x:Static ui:AppIcons.CheckCircle}" Style="{StaticResource StatIcon}"
                                           TextColor="{AppThemeBinding Light=#078675, Dark=#70D8BF}" />
                                    <Label Text="{Binding SentCount}" FontSize="25" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#066C60, Dark=#9DE6D3}" />
                                    <Label Text="ارسال‌شده" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource AccentCard}" Padding="16" IsVisible="{Binding HasUntitled}">
                            <VerticalStackLayout Spacing="9">
                                <Label Text="{Binding UntitledText}" Style="{StaticResource SectionTitle}" />
                                <Label Text="عنوان را بنویسید تا پیام برای ارسال خودکار آماده شود." Style="{StaticResource MutedText}" />
                                <ui:DonyshButton Glyph="{x:Static ui:AppIcons.Title}" Text="عنوان‌گذاری پیام‌ها" Clicked="OnPendingTitlesClicked" Style="{StaticResource SuccessAction}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Style="{StaticResource InfoCard}" Padding="16" IsVisible="{Binding NeedsPermissionAttention}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="دریافت پیامک‌های جدید" FontAttributes="Bold" />
                                    <Label Text="{Binding PermissionStatusText}" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="{Binding PermissionButtonText}" Clicked="OnPermissionClicked"
                                        Style="{StaticResource SecondaryAction}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource AccentCard}" Padding="16">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                                <Label Text="{x:Static ui:AppIcons.History}" Style="{StaticResource SectionIcon}"
                                       VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="پیامک‌های جامانده" Style="{StaticResource SectionTitle}" />
                                    <Label Text="فرستنده و بازه را انتخاب کنید و پیش از افزودن، پیام‌ها را ببینید."
                                           Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                                <ui:DonyshButton Grid.Column="2" Glyph="{x:Static ui:AppIcons.Search}"
                                                 Text="بررسی" Clicked="OnMissedMessagesClicked"
                                                 Style="{StaticResource SecondaryAction}"
                                                 SemanticProperties.Hint="بازکردن بررسی پیامک‌های جامانده" />
                            </Grid>
                        </Border>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="2,5,0,0">
                            <Label Text="فرستنده‌های زیر نظر" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                            <ui:DonyshButton Grid.Column="1" Glyph="{x:Static ui:AppIcons.Add}" Text="افزودن" Clicked="OnAddSenderMenuClicked" Style="{StaticResource SecondaryAction}" />
                        </Grid>
                        <VerticalStackLayout x:Name="ManualPanel" IsVisible="False" Spacing="8">
                            <Border Style="{StaticResource FieldCard}">
                                <Entry x:Name="SenderEntry" Placeholder="شماره یا نام فرستنده" MaxLength="64"
                                       IsTextPredictionEnabled="False" IsSpellCheckEnabled="False" ReturnType="Done" Completed="OnAddSenderClicked" />
                            </Border>
                            <Button Text="ثبت فرستنده" Clicked="OnAddSenderClicked" Style="{StaticResource SuccessAction}" />
                        </VerticalStackLayout>
                        <Border Style="{StaticResource FieldCard}" IsVisible="{Binding ShowSenderSearch}">
                            <SearchBar Placeholder="جست‌وجوی فرستنده" TextChanged="OnSenderSearchChanged" />
                        </Border>
                    </VerticalStackLayout>
                </CollectionView.Header>
                <CollectionView.EmptyView>
                    <Border Style="{StaticResource Card}" Padding="26">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="هنوز فرستنده‌ای در این فهرست نیست" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <Label Text="از دکمهٔ «افزودن» نخستین فرستنده را انتخاب کنید." Style="{StaticResource MutedText}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:SenderItem">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Style="{StaticResource InfoCard}" WidthRequest="44" HeightRequest="44" StrokeThickness="0">
                                    <Label Text="{x:Static ui:AppIcons.Sms}" FontFamily="MaterialIconsRound" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                    <Label Text="{Binding Address}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Details}" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="{x:Static ui:AppIcons.More}" FontFamily="MaterialIconsRound" FontSize="24" Style="{StaticResource QuietAction}"
                                        CommandParameter="{Binding Id}" Clicked="OnSenderActionsClicked" SemanticProperties.Description="گزینه‌های فرستنده" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <Label Text="برای به‌روزکردن وضعیت، صفحه را به پایین بکشید." Style="{StaticResource Caption}" Padding="8,14" HorizontalTextAlignment="Center" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>
    </Grid>
</ui:DonyshPage>
