<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DonyshMobile"
             x:Class="DonyshMobile.MainPage"
             x:DataType="local:MainPage"
             FlowDirection="RightToLeft"
             BackgroundColor="#F8FAFC"
             Title="مانیتور پیامک">
    <Grid RowDefinitions="Auto,Auto,*" Padding="20,18" RowSpacing="16">
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <HorizontalStackLayout Spacing="10">
                <Image Source="donysh_logo.svg" WidthRequest="38" HeightRequest="38" />
                <Label Text="Donysh Mobile" FontSize="27" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Label Text="فقط پیامک‌های جدیدِ فرستنده‌های انتخاب‌شده، روی همین گوشی نگهداری می‌شوند."
                   FontSize="13" TextColor="#64748B" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="12">
            <Border Stroke="#C7D2FE" BackgroundColor="#EEF2FF" Padding="15" StrokeShape="RoundRectangle 18">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="دسترسی دریافت پیامک" FontAttributes="Bold" TextColor="#312E81" />
                        <Label Text="{Binding PermissionStatusText}" FontSize="12" TextColor="#4F46E5" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="{Binding PermissionButtonText}" Clicked="OnPermissionClicked"
                            Padding="14,8" FontSize="12" BackgroundColor="#4F46E5" TextColor="White" CornerRadius="12" />
                </Grid>
            </Border>

            <Border Stroke="#E2E8F0" BackgroundColor="White" Padding="15" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="افزودن شماره یا نام فرستنده" FontAttributes="Bold" TextColor="#0F172A" />
                    <Label Text="مقداری را وارد کنید که گوشی به‌عنوان فرستنده نمایش می‌دهد؛ مانند 30001234 یا BankName."
                           FontSize="12" TextColor="#64748B" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry x:Name="SenderEntry" Placeholder="شماره یا نام فرستنده" MaxLength="160"
                               ClearButtonVisibility="WhileEditing" ReturnType="Done" Completed="OnAddSenderClicked"
                               BackgroundColor="#F8FAFC" TextColor="#0F172A" />
                        <Button Grid.Column="1" Text="افزودن" Clicked="OnAddSenderClicked"
                                BackgroundColor="#059669" TextColor="White" CornerRadius="12" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="10">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="فرستنده‌های تحت مانیتور" FontSize="17" FontAttributes="Bold" TextColor="#0F172A" />
                <Label Grid.Column="1" Text="{Binding SenderCountText}" FontSize="12"
                       TextColor="#64748B" VerticalOptions="Center" />
            </Grid>

            <CollectionView Grid.Row="1" ItemsSource="{Binding Senders}" SelectionMode="Single"
                            SelectionChanged="OnSenderSelected">
                <CollectionView.EmptyView>
                    <Border Stroke="#CBD5E1" StrokeDashArray="5,4" Padding="24" StrokeShape="RoundRectangle 18">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="📨" FontSize="34" HorizontalTextAlignment="Center" />
                            <Label Text="هنوز فرستنده‌ای اضافه نشده است." FontAttributes="Bold"
                                   TextColor="#334155" HorizontalTextAlignment="Center" />
                            <Label Text="یک شماره یا نام فرستنده اضافه کنید؛ از آن لحظه پیامک‌های جدید ذخیره می‌شوند."
                                   FontSize="12" TextColor="#64748B" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:SenderItem">
                        <Border Margin="0,0,0,9" Stroke="#E2E8F0" BackgroundColor="White"
                                Padding="14" StrokeShape="RoundRectangle 16">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border WidthRequest="44" HeightRequest="44" BackgroundColor="#E0E7FF"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 14">
                                    <Label Text="✉" FontSize="20" TextColor="#4338CA"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Address}" FontAttributes="Bold" TextColor="#0F172A"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Details}" FontSize="12" TextColor="#64748B"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="حذف" FontSize="11" Padding="10,7"
                                        BackgroundColor="#FFF1F2" TextColor="#BE123C" CornerRadius="10"
                                        CommandParameter="{Binding Id}" Clicked="OnRemoveSenderClicked" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
