<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DonyshMobile"
             x:Class="DonyshMobile.TemplateEditorPage"
             x:DataType="local:TemplateEditorPage"
             FlowDirection="RightToLeft" Title="تعریف قالب">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,36" Spacing="15">
            <Label Text="تعریف قالب پیامک" Style="{StaticResource PageTitle}" />
            <Label x:Name="SenderLabel" Style="{StaticResource MutedText}" />

            <Label Text="روش ساخت" Style="{StaticResource SectionTitle}" />
            <Picker x:Name="SourcePicker" SelectedIndexChanged="OnSourceChanged">
                <Picker.Items>
                    <x:String>قالب شخصی</x:String>
                    <x:String>انتخاب از بانک‌های پیش‌فرض</x:String>
                </Picker.Items>
            </Picker>

            <Border x:Name="PresetSection" Style="{StaticResource InfoCard}" Padding="14" IsVisible="False">
                <VerticalStackLayout Spacing="8">
                    <Label Text="بانک پیش‌فرض" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#312E81, Dark=#E0E7FF}" />
                    <Picker x:Name="PresetPicker" Title="بانک را انتخاب کنید"
                            SelectedIndexChanged="OnPresetSelected" />
                    <Label x:Name="PresetDescriptionLabel" FontSize="12"
                           TextColor="{AppThemeBinding Light=#4338CA, Dark=#C7D2FE}" />
                    <Label Text="متن و مقادیر این قالب پایین نمایش داده شده‌اند و قابل ویرایش هستند."
                           FontSize="12" TextColor="{AppThemeBinding Light=#4338CA, Dark=#C7D2FE}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="متن کامل پیام" Style="{StaticResource SectionTitle}" />
            <Picker x:Name="SavedMessagePicker" Title="یا یک پیام ثبت‌شده را انتخاب کنید"
                    SelectedIndexChanged="OnSavedMessageSelected" />
            <Editor x:Name="MessageEditor" HeightRequest="190" MaxLength="10000"
                    Placeholder="کل پیامک را اینجا قرار دهید..." />

            <Grid ColumnDefinitions="0.9*,1.25*,Auto" ColumnSpacing="8">
                <Label Text="کلید" Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" />
                <Label Grid.Column="1" Text="مقدار داخل پیام" Style="{StaticResource SectionTitle}" />
            </Grid>
            <VerticalStackLayout x:Name="FieldsLayout" Spacing="8"
                                 BindableLayout.ItemsSource="{Binding Fields}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:TemplateFieldRow">
                        <Grid ColumnDefinitions="0.9*,1.25*,Auto" ColumnSpacing="8">
                            <Picker SelectedItem="{Binding KeyLabel, Mode=TwoWay}">
                                <Picker.Items>
                                    <x:String>نام بانک</x:String>
                                    <x:String>نوع تراکنش</x:String>
                                    <x:String>مبلغ</x:String>
                                    <x:String>واحد</x:String>
                                    <x:String>ساعت</x:String>
                                    <x:String>تاریخ</x:String>
                                </Picker.Items>
                            </Picker>
                            <Entry Grid.Column="1" Text="{Binding Value, Mode=TwoWay}"
                                   Placeholder="مقدار را بنویسید" />
                            <Button Grid.Column="2" Text="×" FontSize="18" Padding="10,4"
                                    CommandParameter="{Binding Id}" Clicked="OnRemoveFieldClicked"
                                    Style="{StaticResource DangerAction}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Button Text="+ افزودن ردیف" Clicked="OnAddFieldClicked" Style="{StaticResource SecondaryAction}" />

            <Label Text="نام قالب (اختیاری)" Style="{StaticResource SectionTitle}" />
            <Entry x:Name="NameEntry" Placeholder="مثلاً بلو بانک — برداشت" MaxLength="80" />

            <Button Text="بررسی قالب" Clicked="OnReviewClicked" Style="{StaticResource PrimaryAction}" />
            <Border x:Name="PreviewCard" Style="{StaticResource Card}" Padding="14" IsVisible="False">
                <VerticalStackLayout Spacing="7">
                    <Label Text="پیش‌نمایش قالب" Style="{StaticResource SectionTitle}" />
                    <Label x:Name="PreviewResultLabel"
                           TextColor="{AppThemeBinding Light=#047857, Dark=#6EE7B7}" />
                    <Label x:Name="PatternPreviewLabel" FontSize="12" Style="{StaticResource MutedText}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="ذخیره قالب" Clicked="OnSaveClicked" Style="{StaticResource SuccessAction}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
