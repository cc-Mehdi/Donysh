<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DonyshMobile"
             x:Class="DonyshMobile.TemplateEditorPage"
             x:DataType="local:TemplateEditorPage"
             FlowDirection="RightToLeft" Title="تعریف قالب">
    <ScrollView x:Name="EditorScroll">
        <VerticalStackLayout x:Name="EditorContent" Padding="20,18,20,36" Spacing="16">
            <VerticalStackLayout Spacing="5">
                <Label Text="خواندن خودکار پیامک" Style="{StaticResource PageTitle}" />
                <Label x:Name="SenderLabel" Style="{StaticResource MutedText}" />
                <Label x:Name="IntroLabel" Text="فقط مبلغ را از پیام مشخص کنید. تاریخ، ساعت و اطلاعات دیگر را در صورت نیاز اضافه کنید."
                       Style="{StaticResource MutedText}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="۱ · از کجا شروع کنیم؟" Style="{StaticResource SectionTitle}" />
                    <Picker x:Name="SourcePicker" SelectedIndexChanged="OnSourceChanged"
                            SemanticProperties.Description="روش شروع ساخت قالب">
                        <Picker.Items>
                            <x:String>از پیامک خودم می‌سازم</x:String>
                            <x:String>از قالب آماده بانک شروع می‌کنم</x:String>
                        </Picker.Items>
                    </Picker>
                    <VerticalStackLayout x:Name="PresetSection" Spacing="8" IsVisible="False">
                        <Picker x:Name="PresetPicker" Title="انتخاب بانک"
                                SelectedIndexChanged="OnPresetSelected" />
                        <Label x:Name="PresetDescriptionLabel" Style="{StaticResource MutedText}" FontSize="12" />
                        <Button x:Name="BankSampleButton" Text="نمایش نمونهٔ بانک" Clicked="OnToggleBankSampleClicked"
                                Style="{StaticResource QuietAction}" />
                        <Label x:Name="BankSampleLabel" IsVisible="False" Style="{StaticResource MutedText}" />
                        <Label Text="بانک را انتخاب کنید، سپس پیام خودتان را بررسی کنید. مبلغ، تاریخ و ساعت خودکار خوانده می‌شوند؛ نمونهٔ بانک هم برای مقایسه نمایش داده می‌شود."
                               Style="{StaticResource MutedText}" FontSize="12" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="۲ · پیام نمونه را وارد کنید" Style="{StaticResource SectionTitle}" />
                    <Picker x:Name="SavedMessagePicker" Title="انتخاب از پیام‌های این فرستنده"
                            SelectedIndexChanged="OnSavedMessageSelected" />
                    <Label x:Name="SavedMessageHint" Style="{StaticResource MutedText}" FontSize="12" />
                    <Editor x:Name="MessageEditor" HeightRequest="175" MaxLength="2048"
                            Placeholder="کل پیامک را اینجا بچسبانید…" TextChanged="OnInputChanged"
                            IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                            SemanticProperties.Description="متن کامل پیامک نمونه" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label x:Name="FieldsTitleLabel" Text="۳ · بخش‌های پیام را مشخص کنید" Style="{StaticResource SectionTitle}" />
                    <Label x:Name="FieldsHelpLabel" Text="سمت راست نام بخش و سمت چپ مقدار آن را بنویسید. مبلغ را با موجودی حساب اشتباه نگیرید."
                           Style="{StaticResource MutedText}" FontSize="12" />
                    <Button x:Name="EditFieldsButton" Text="می‌خواهم بخش‌ها را دستی تغییر دهم" Clicked="OnEditFieldsClicked"
                            IsVisible="False" Style="{StaticResource QuietAction}" />
                    <VerticalStackLayout x:Name="ManualFieldsPanel" Spacing="12">
                    <Grid ColumnDefinitions="0.9*,1.35*,48" ColumnSpacing="8">
                        <Label Text="بخش پیام" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="مقدار پیامک" FontAttributes="Bold" />
                    </Grid>
                    <VerticalStackLayout x:Name="FieldsLayout" Spacing="12"
                                         BindableLayout.ItemsSource="{Binding Fields}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:TemplateFieldRow">
                                <Grid ColumnDefinitions="0.9*,1.35*,48" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                                    <Picker SelectedItem="{Binding KeyLabel, Mode=TwoWay}">
                                        <Picker.Items>
                                            <x:String>نام بانک</x:String>
                                            <x:String>نوع تراکنش</x:String>
                                            <x:String>مبلغ</x:String>
                                            <x:String>واحد</x:String>
                                            <x:String>ساعت</x:String>
                                            <x:String>تاریخ</x:String>
                                        </Picker.Items>
                                    </Picker>
                                    <Entry Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" MaxLength="200"
                                           Placeholder="{Binding Example}" IsSpellCheckEnabled="False"
                                           IsTextPredictionEnabled="False" />
                                    <Button Grid.Column="2" Text="×" FontSize="20" Padding="0"
                                            CommandParameter="{Binding Id}" Clicked="OnRemoveFieldClicked"
                                            SemanticProperties.Description="حذف این ردیف"
                                            Style="{StaticResource DangerAction}" />
                                    <Label Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Hint}" FontSize="12"
                                           Style="{StaticResource MutedText}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="افزودن تاریخ، ساعت یا اطلاعات دیگر" Clicked="OnAddFieldClicked"
                            Style="{StaticResource SecondaryAction}" />
                    <Label Text="لازم نیست ردیف‌های خالی را پر کنید. اگر واحد و نوع را ننویسید، مبلغ ریال و تراکنش برداشت است. برای پیام واریز، «نوع تراکنش» را اضافه کنید."
                           Style="{StaticResource MutedText}" FontSize="12" />
                    </VerticalStackLayout>
                    <Label Text="نام قالب · اختیاری" Style="{StaticResource SectionTitle}" Margin="0,6,0,0" />
                    <Entry x:Name="NameEntry" Placeholder="مثلاً برداشت از بلو" MaxLength="80"
                           TextChanged="OnInputChanged" />
                </VerticalStackLayout>
            </Border>

            <Button x:Name="ReviewButton" Text="بررسی با همین پیام نمونه" Clicked="OnReviewClicked"
                    Style="{StaticResource SecondaryAction}" />
            <Border x:Name="PreviewCard" Style="{StaticResource InfoCard}" Padding="16" IsVisible="False">
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="PreviewTitleLabel" Text="نتیجه بررسی" Style="{StaticResource SectionTitle}" />
                    <Label x:Name="PreviewResultLabel" SemanticProperties.Description="نتیجه خواندن پیام نمونه" />
                    <Button x:Name="DetailsButton" Text="نمایش الگوی پیام" Clicked="OnToggleDetailsClicked"
                            Style="{StaticResource SecondaryAction}" IsVisible="False" />
                    <Label x:Name="PatternPreviewLabel" FontSize="12" Style="{StaticResource MutedText}" IsVisible="False" />
                </VerticalStackLayout>
            </Border>
            <Button x:Name="SaveButton" Text="بررسی و ذخیره قالب" Clicked="OnSaveClicked"
                    Style="{StaticResource PrimaryAction}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
