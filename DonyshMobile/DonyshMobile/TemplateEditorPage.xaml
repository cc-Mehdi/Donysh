<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DonyshMobile.TemplateEditorPage"
             FlowDirection="RightToLeft" Title="ساخت قالب">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,36" Spacing="16">
            <Label Text="ساخت ساده قالب" Style="{StaticResource PageTitle}" />
            <Label x:Name="SenderLabel" Style="{StaticResource MutedText}" />

            <Border Style="{StaticResource InfoCard}" Padding="14">
                <Label Text="یک پیام واقعی را انتخاب کنید. برنامه مبلغ، تاریخ و ساعت را پیدا می‌کند و قالب را برایتان می‌سازد."
                       TextColor="{AppThemeBinding Light=#3730A3, Dark=#C7D2FE}" FontSize="13" />
            </Border>

            <Label Text="۱. پیام نمونه" Style="{StaticResource SectionTitle}" />
            <Picker x:Name="SamplePicker" Title="یک پیام ذخیره‌شده را انتخاب کنید"
                    SelectedIndexChanged="OnSampleSelected" />
            <Editor x:Name="SampleEditor" HeightRequest="150" IsReadOnly="True"
                    Placeholder="ابتدا یک پیام از این فرستنده دریافت کنید." />

            <VerticalStackLayout x:Name="FieldsSection" Spacing="12" IsVisible="False">
                <Label Text="۲. اطلاعات تراکنش" Style="{StaticResource SectionTitle}" />
                <Label Text="مبلغ تراکنش را انتخاب کنید؛ مبلغ موجودی حساب را انتخاب نکنید."
                       Style="{StaticResource MutedText}" FontSize="12" />
                <Picker x:Name="AmountPicker" Title="مبلغ تراکنش" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="واحد مبلغ" Style="{StaticResource SectionTitle}" />
                        <Picker x:Name="UnitPicker">
                            <Picker.Items><x:String>ریال</x:String><x:String>تومان</x:String></Picker.Items>
                        </Picker>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="نوع تراکنش" Style="{StaticResource SectionTitle}" />
                        <Picker x:Name="KindPicker" SelectedIndexChanged="OnKindChanged">
                            <Picker.Items><x:String>برداشت</x:String><x:String>واریز</x:String></Picker.Items>
                        </Picker>
                    </VerticalStackLayout>
                </Grid>

                <Label Text="عبارت تشخیص نوع در پیام" Style="{StaticResource SectionTitle}" />
                <Entry x:Name="TypePhraseEntry" Placeholder="مثلاً: از حسابت پرید" MaxLength="100" />
                <Label Text="برنامه هر بار این عبارت را ببیند، آن را به نوع انتخاب‌شده بالا تبدیل می‌کند. خالی گذاشتن یعنی این قالب همیشه همان نوع را دارد."
                       Style="{StaticResource MutedText}" FontSize="12" />

                <Border Style="{StaticResource Card}" Padding="12">
                    <Label x:Name="DetectedFieldsLabel" Style="{StaticResource MutedText}" FontSize="12" />
                </Border>

                <Button Text="ساخت و بررسی قالب" Clicked="OnGenerateClicked" Style="{StaticResource PrimaryAction}" />
            </VerticalStackLayout>

            <Border x:Name="ResultCard" Style="{StaticResource Card}" Padding="14" IsVisible="False">
                <VerticalStackLayout Spacing="6">
                    <Label Text="نتیجه" Style="{StaticResource SectionTitle}" />
                    <Label x:Name="ResultLabel" TextColor="{AppThemeBinding Light=#047857, Dark=#6EE7B7}" />
                </VerticalStackLayout>
            </Border>

            <Button x:Name="AdvancedButton" Text="تنظیمات پیشرفته" Clicked="OnAdvancedClicked"
                    Style="{StaticResource SecondaryAction}" />
            <VerticalStackLayout x:Name="AdvancedSection" IsVisible="False" Spacing="10">
                <Label Text="نام قالب" Style="{StaticResource SectionTitle}" />
                <Entry x:Name="NameEntry" Placeholder="مثلاً برداشت بلو" MaxLength="80" />
                <Label Text="متن فنی قالب" Style="{StaticResource SectionTitle}" />
                <Editor x:Name="PatternEditor" HeightRequest="160" MaxLength="2000" />
                <Label Text="نگاشت‌های بیشتر؛ هر خط به شکل عبارت=برداشت یا عبارت=واریز"
                       Style="{StaticResource MutedText}" FontSize="12" />
                <Editor x:Name="MappingsEditor" HeightRequest="100"
                        Placeholder="از حسابت پرید=برداشت&#10;واریز به حساب=واریز" />
            </VerticalStackLayout>

            <Button Text="ذخیره قالب" Clicked="OnSaveClicked" Style="{StaticResource SuccessAction}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
