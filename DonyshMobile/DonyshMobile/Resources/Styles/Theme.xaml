<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:ui="clr-namespace:DonyshMobile.UI">
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="{AppThemeBinding Light=#F1F2FF, Dark=#10162B}" />
                    <GradientStop Offset="0.48" Color="{AppThemeBinding Light=#F5F7FB, Dark=#09111F}" />
                    <GradientStop Offset="1" Color="{AppThemeBinding Light=#EDF9F5, Dark=#0A1A20}" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="FlowDirection" Value="RightToLeft" />
    </Style>
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="YekanBakh" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#15243C, Dark=#ECF2FF}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>
    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="YekanBakhMedium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="BackgroundColor" Value="#5B4CF0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="MinimumWidthRequest" Value="48" />
        <Setter Property="ui:UiMotion.AnimatePress" Value="True" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled"><VisualState.Setters>
                        <Setter Property="Opacity" Value="0.45" />
                    </VisualState.Setters></VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}" />
    <Style TargetType="ui:DonyshButton" BasedOn="{StaticResource ButtonBase}" />
    <Style x:Key="SectionIcon" TargetType="Label">
        <Setter Property="FontFamily" Value="MaterialIconsRound" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#5145D8, Dark=#C9C5FF}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="WidthRequest" Value="30" />
    </Style>
    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="YekanBakh" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#15243C, Dark=#F1F5FF}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#67768C, Dark=#A0AFC6}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="50" />
        <Setter Property="ClearButtonVisibility" Value="WhileEditing" />
    </Style>
    <Style TargetType="Editor">
        <Setter Property="FontFamily" Value="YekanBakh" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#15243C, Dark=#F1F5FF}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#67768C, Dark=#A0AFC6}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="70" />
    </Style>
    <Style TargetType="Picker">
        <Setter Property="FontFamily" Value="YekanBakh" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#15243C, Dark=#F1F5FF}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light=#67768C, Dark=#A0AFC6}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="50" />
    </Style>
    <Style TargetType="SearchBar">
        <Setter Property="FontFamily" Value="YekanBakh" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#15243C, Dark=#ECF2FF}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#67768C, Dark=#A0AFC6}" />
        <Setter Property="CancelButtonColor" Value="{AppThemeBinding Light=#5B4CF0, Dark=#B9B4FF}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="50" />
    </Style>
    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="#5B4CF0" />
        <Setter Property="ThumbColor" Value="{AppThemeBinding Light=White, Dark=#C7D2FE}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>
    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="YekanBakhDisplay" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#15243C, Dark=#F1F5FF}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="YekanBakhBold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#15243C, Dark=#F1F5FF}" />
    </Style>
    <Style x:Key="MutedText" TargetType="Label">
        <Setter Property="FontFamily" Value="YekanBakh" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="1.3" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#586B85, Dark=#ADBCD3}" />
    </Style>
    <Style x:Key="Caption" TargetType="Label" BasedOn="{StaticResource MutedText}">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#162237}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light=#E0E7F2, Dark=#2A3953}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 22" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>
    <Style x:Key="FieldCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F5F7FC, Dark=#0F1A2D}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="12,2" />
    </Style>
    <Style x:Key="InfoCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EAF5FC, Dark=#132B3D}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light=#C7E4F4, Dark=#25506A}" />
    </Style>
    <Style x:Key="AccentCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E9F8F2, Dark=#102F2B}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light=#B9E6D6, Dark=#246056}" />
    </Style>
    <Style x:Key="StatusBadge" TargetType="Label">
        <Setter Property="FontFamily" Value="YekanBakhMedium" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#5145D8, Dark=#C9C5FF}" />
    </Style>
    <Style x:Key="SuggestionChip" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="FontFamily" Value="YekanBakhMedium" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EEEFFD, Dark=#292C56}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#453BB7, Dark=#DDD9FF}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="MinimumHeightRequest" Value="36" />
        <Setter Property="Margin" Value="3" />
    </Style>
    <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource ButtonBase}" />
    <Style x:Key="SuccessAction" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="BackgroundColor" Value="#078675" />
    </Style>
    <Style x:Key="SecondaryAction" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EEEFFD, Dark=#292C56}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#453BB7, Dark=#DDD9FF}" />
    </Style>
    <Style x:Key="QuietAction" TargetType="Button" BasedOn="{StaticResource SecondaryAction}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style x:Key="DangerAction" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFF0F1, Dark=#412336}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#A91D46, Dark=#FFC0CE}" />
    </Style>
    <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="10,12" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
    </Style>
    <Style x:Key="StatInfoCard" TargetType="Border" BasedOn="{StaticResource StatCard}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EDF7FD, Dark=#112A3D}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light=#C9E7F6, Dark=#28516B}" />
    </Style>
    <Style x:Key="StatWarningCard" TargetType="Border" BasedOn="{StaticResource StatCard}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFF7E8, Dark=#342816}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light=#F3D7A2, Dark=#6B4C20}" />
    </Style>
    <Style x:Key="StatSuccessCard" TargetType="Border" BasedOn="{StaticResource StatCard}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EAF9F3, Dark=#102F2A}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light=#BDE8D9, Dark=#255D52}" />
    </Style>
    <Style x:Key="StatIcon" TargetType="Label">
        <Setter Property="FontFamily" Value="MaterialIconsRound" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="WidthRequest" Value="28" />
        <Setter Property="HeightRequest" Value="28" />
    </Style>
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light=#F5F7FB, Dark=#09111F}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light=#15243C, Dark=#ECF2FF}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light=#15243C, Dark=#ECF2FF}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
    </Style>
</ResourceDictionary>
