<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DonyshMobile"
             x:Class="DonyshMobile.TemplatesPage"
             x:DataType="local:TemplatesPage"
             FlowDirection="RightToLeft" BackgroundColor="#F8FAFC" Title="قالب‌های پیامک">
    <Grid Padding="20,18" RowDefinitions="Auto,Auto,*" RowSpacing="15">
        <VerticalStackLayout Spacing="6">
            <Label Text="قالب‌های این فرستنده" FontSize="24" FontAttributes="Bold" TextColor="#0F172A" />
            <Label Text="{Binding SenderAddress}" TextColor="#64748B" />
            <Label Text="هر قالب فقط روی پیام‌های همین فرستنده امتحان می‌شود." FontSize="12" TextColor="#64748B" />
        </VerticalStackLayout>
        <Button Grid.Row="1" Text="افزودن قالب تازه" Clicked="OnAddClicked"
                BackgroundColor="#4F46E5" TextColor="White" CornerRadius="12" />
        <CollectionView Grid.Row="2" ItemsSource="{Binding Templates}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="هنوز قالبی ثبت نشده است. یک قالب بسازید و آن را روی پیام واقعی آزمایش کنید."
                       TextColor="#64748B" HorizontalTextAlignment="Center" Margin="10,30" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:TemplateItem">
                    <Border Padding="14" Margin="0,0,0,10" BackgroundColor="White" Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 16">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontAttributes="Bold" TextColor="#0F172A" />
                                <Label Text="{Binding Details}" FontSize="12" TextColor="#64748B" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="ویرایش" CommandParameter="{Binding Id}" Clicked="OnEditClicked"
                                    BackgroundColor="#EEF2FF" TextColor="#4338CA" FontSize="12" CornerRadius="10" />
                            <Button Grid.Column="2" Text="حذف" CommandParameter="{Binding Id}" Clicked="OnDeleteClicked"
                                    BackgroundColor="#FFF1F2" TextColor="#BE123C" FontSize="12" CornerRadius="10" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
