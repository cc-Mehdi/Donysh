<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DonyshMobile"
             x:Class="DonyshMobile.TemplatesPage"
             x:DataType="local:TemplatesPage"
             FlowDirection="RightToLeft" Title="قالب‌های پیامک">
    <Grid Padding="20,18" RowDefinitions="Auto,Auto,*" RowSpacing="15">
        <VerticalStackLayout Spacing="6">
            <Label Text="قالب‌های این فرستنده" Style="{StaticResource PageTitle}" />
            <Label Text="{Binding SenderAddress}" Style="{StaticResource MutedText}" />
            <Label Text="هر قالب فقط روی پیام‌های همین فرستنده امتحان می‌شود." FontSize="12" Style="{StaticResource MutedText}" />
        </VerticalStackLayout>
        <Button Grid.Row="1" Text="افزودن قالب تازه" Clicked="OnAddClicked"
                Style="{StaticResource PrimaryAction}" />
        <CollectionView Grid.Row="2" ItemsSource="{Binding Templates}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="هنوز قالبی ثبت نشده است. یک قالب بسازید و آن را روی پیام واقعی آزمایش کنید."
                       Style="{StaticResource MutedText}" HorizontalTextAlignment="Center" Margin="10,30" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:TemplateItem">
                    <Border Padding="14" Margin="0,0,0,10" Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                <Label Text="{Binding Details}" FontSize="12" Style="{StaticResource MutedText}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="ویرایش" CommandParameter="{Binding Id}" Clicked="OnEditClicked"
                                    Style="{StaticResource SecondaryAction}" FontSize="12" CornerRadius="10" />
                            <Button Grid.Column="2" Text="حذف" CommandParameter="{Binding Id}" Clicked="OnDeleteClicked"
                                    Style="{StaticResource DangerAction}" FontSize="12" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
