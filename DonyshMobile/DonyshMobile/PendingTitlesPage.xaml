<?xml version="1.0" encoding="utf-8" ?>
<ui:DonyshPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DonyshMobile"
             xmlns:ui="clr-namespace:DonyshMobile.UI"
             x:Class="DonyshMobile.PendingTitlesPage"
             FlowDirection="RightToLeft" Title="عنوان‌گذاری پیام‌ها">
    <Grid x:Name="TitlesContent" Padding="18,12" RowDefinitions="Auto,*" RowSpacing="14">
        <VerticalStackLayout Spacing="5">
            <Label Text="پیام‌های منتظر عنوان" Style="{StaticResource PageTitle}" />
            <Label x:Name="RemainingLabel" Style="{StaticResource StatusBadge}" />
            <Label Text="برای هر پیام عنوانی کوتاه بنویسید. تا آن زمان، ارسال خودکار آن انجام نمی‌شود."
                   FontSize="13" Style="{StaticResource MutedText}" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="1" x:Name="PendingList">
            <CollectionView.EmptyView>
                <Label Text="همهٔ پیام‌های منتظر عنوان‌گذاری شده‌اند." Style="{StaticResource MutedText}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:PendingTitleItem">
                    <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Sender}" FontAttributes="Bold" />
                            <Label Text="{Binding ReceivedAt}" Style="{StaticResource Caption}" />
                            <Label Text="{Binding Body}" MaxLines="4" LineBreakMode="TailTruncation" />
                            <Border Style="{StaticResource FieldCard}">
                                <Entry Text="{Binding DraftTitle, Mode=TwoWay}" Placeholder="این خرج برای چه بود؟" MaxLength="160" ReturnType="Done" Completed="OnSetTitleClicked" />
                            </Border>
                            <Label Text="پیشنهادهای سریع" Style="{StaticResource Caption}"
                                   IsVisible="{Binding HasSuggestions}" />
                            <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignItems="Start"
                                        FlowDirection="RightToLeft" IsVisible="{Binding HasSuggestions}"
                                        BindableLayout.ItemsSource="{Binding Suggestions}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Button Text="{Binding .}" CommandParameter="{Binding .}" Clicked="OnSuggestionClicked"
                                                Style="{StaticResource SuggestionChip}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                            <ui:DonyshButton Glyph="{x:Static ui:AppIcons.CheckCircle}" Text="ذخیرهٔ عنوان و آماده‌سازی ارسال" CommandParameter="{Binding Id}"
                                    Clicked="OnSetTitleClicked" Style="{StaticResource SuccessAction}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ui:DonyshPage>
