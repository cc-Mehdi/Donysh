<?xml version="1.0" encoding="utf-8" ?>
<ui:DonyshPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:local="clr-namespace:DonyshMobile"
               xmlns:ui="clr-namespace:DonyshMobile.UI"
               x:Class="DonyshMobile.PendingTitlesPage"
               FlowDirection="RightToLeft" Title="عنوان‌گذاری پیام‌ها">
    <Grid x:Name="TitlesContent" Padding="18,10,18,6" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <VerticalStackLayout Spacing="6">
            <Label Text="پیام‌های منتظر عنوان" Style="{StaticResource PageTitle}" FontSize="23" />
            <Label x:Name="RemainingLabel" Style="{StaticResource StatusBadge}" />
            <Label Text="برای هر پیام عنوانی کوتاه بنویسید. تا آن زمان، ارسال خودکار انجام نمی‌شود."
                   Style="{StaticResource MutedText}" />
            <HorizontalStackLayout Spacing="6" Margin="0,4,0,0">
                <Border BackgroundColor="{AppThemeBinding Light=#5B4CF0, Dark=#7568F5}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="12,7">
                    <Label Text="عنوان لازم" FontSize="12" TextColor="White" />
                </Border>
                <Button Text="نیازمند بررسی" Clicked="OnReviewClicked" Style="{StaticResource SuggestionChip}" />
                <Button Text="همهٔ پیام‌ها" Clicked="OnAllMessagesClicked" Style="{StaticResource SuggestionChip}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
        <CollectionView Grid.Row="1" x:Name="PendingList" ItemsUpdatingScrollMode="KeepScrollOffset">
            <CollectionView.EmptyView>
                <Border Style="{StaticResource AccentCard}" Padding="25" Margin="0,10">
                    <VerticalStackLayout Spacing="7">
                        <Label Text="همهٔ عنوان‌ها ثبت شده‌اند" Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" />
                        <Label Text="پیام‌های آماده در صف ارسال می‌مانند تا دریافت آن‌ها تأیید شود."
                               Style="{StaticResource MutedText}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:PendingTitleItem">
                    <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="{Binding AmountText}" FontFamily="YekanBakhBold" FontSize="20" />
                                <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#FFF4D9, Dark=#40341C}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="8,4">
                                    <Label Text="عنوان لازم" FontSize="11"
                                           TextColor="{AppThemeBinding Light=#8A5B00, Dark=#FFD98A}" />
                                </Border>
                            </Grid>
                            <Label Text="{Binding SenderAndDate}" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource FieldCard}" Padding="10,7">
                                <Label Text="{Binding Body}" MaxLines="1" LineBreakMode="TailTruncation"
                                       Style="{StaticResource MutedText}" />
                            </Border>
                            <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignItems="Start"
                                        FlowDirection="RightToLeft" IsVisible="{Binding HasSuggestions}"
                                        BindableLayout.ItemsSource="{Binding Suggestions}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Button Text="{Binding .}" CommandParameter="{Binding .}" Clicked="OnSuggestionClicked"
                                                Style="{StaticResource SuggestionChip}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                            <Border Style="{StaticResource FieldCard}">
                                <Entry Text="{Binding DraftTitle, Mode=TwoWay}" Placeholder="این خرج برای چه بود؟"
                                       MaxLength="160" ReturnType="Done" Completed="OnSetTitleClicked"
                                       SemanticProperties.Description="عنوان این پیام" />
                            </Border>
                            <ui:DonyshButton Glyph="{x:Static ui:AppIcons.CheckCircle}"
                                             Text="ذخیرهٔ عنوان و آماده‌سازی ارسال" CommandParameter="{Binding Id}"
                                             Clicked="OnSetTitleClicked" Style="{StaticResource SuccessAction}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Border Grid.Row="2" Style="{StaticResource BottomNavSurface}">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="0">
                <ui:DonyshButton Glyph="{x:Static ui:AppIcons.Workspace}" Text="خانه" Clicked="OnHomeClicked"
                                 Style="{StaticResource BottomTab}" AutomationId="HomeTab" />
                <ui:DonyshButton Grid.Column="1" Glyph="{x:Static ui:AppIcons.Message}" Text="پیام‌ها"
                                 Clicked="OnAllMessagesClicked" Style="{StaticResource BottomTabActive}" AutomationId="MessagesTab" />
                <ui:DonyshButton Grid.Column="2" Glyph="{x:Static ui:AppIcons.Sms}" Text="فرستنده‌ها"
                                 Clicked="OnSendersClicked" Style="{StaticResource BottomTab}" AutomationId="SendersTab" />
            </Grid>
        </Border>
    </Grid>
</ui:DonyshPage>
