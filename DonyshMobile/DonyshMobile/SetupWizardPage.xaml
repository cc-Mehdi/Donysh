<?xml version="1.0" encoding="utf-8" ?>
<ui:DonyshPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DonyshMobile"
             xmlns:ui="clr-namespace:DonyshMobile.UI"
             x:Class="DonyshMobile.SetupWizardPage"
             x:DataType="local:SetupWizardPage"
             FlowDirection="RightToLeft"
             Title="راه‌اندازی دُنیش">
    <ScrollView>
        <VerticalStackLayout x:Name="WizardContent" Padding="20,18,20,34" Spacing="18" MaximumWidthRequest="620" HorizontalOptions="Fill">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Image Source="donysh_logo.svg" WidthRequest="54" HeightRequest="54"
                       SemanticProperties.Description="نشان دُنیش" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="راه‌اندازی دُنیش همراه" Style="{StaticResource PageTitle}" FontSize="22" />
                    <Label Text="هر بار فقط یک قدم" Style="{StaticResource MutedText}" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Text="{Binding ProgressText}" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="{Binding ProgressFraction}" Style="{StaticResource Caption}" />
                </Grid>
                <ProgressBar Progress="{Binding ProgressValue}" ProgressColor="#4F46E5" HeightRequest="6" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Label x:Name="ConnectionStepLabel" Text="اتصال" HorizontalTextAlignment="Center" Style="{StaticResource Caption}" />
                    <Label x:Name="SenderStepLabel" Grid.Column="1" Text="فرستنده" HorizontalTextAlignment="Center" Style="{StaticResource Caption}" />
                    <Label x:Name="TemplateStepLabel" Grid.Column="2" Text="قالب" HorizontalTextAlignment="Center" Style="{StaticResource Caption}" />
                </Grid>
            </VerticalStackLayout>

            <Border x:Name="ConnectionStepCard" Style="{StaticResource Card}" Padding="20" IsVisible="{Binding IsConnectionStep}">
                <VerticalStackLayout Spacing="14">
                    <Border Style="{StaticResource InfoCard}" WidthRequest="54" HeightRequest="54" HorizontalOptions="Start" StrokeThickness="0">
                        <Label Text="{x:Static ui:AppIcons.Link}" FontFamily="MaterialIconsRound" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="وارد حساب دُنیش شوید" Style="{StaticResource SectionTitle}" FontSize="20" />
                    <Label Text="با همان رایانامه و گذرواژهٔ سایت وارد شوید. پس از ورود، فضاهای مالی شما نمایش داده می‌شوند." Style="{StaticResource MutedText}" LineHeight="1.35" />
                    <ui:DonyshButton x:Name="OpenConnectionButton" Glyph="{x:Static ui:AppIcons.Security}" Text="ورود به حساب دُنیش" Clicked="OnConnectionClicked"
                            Style="{StaticResource PrimaryAction}" AutomationId="SetupConnectionButton" />
                    <Label Text="گذرواژه روی گوشی ذخیره نمی‌شود و این گوشی دسترسی جداگانه دریافت می‌کند." Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="SenderStepCard" Style="{StaticResource Card}" Padding="20" IsVisible="{Binding IsSenderStep}">
                <VerticalStackLayout Spacing="14">
                    <Border Style="{StaticResource InfoCard}" WidthRequest="54" HeightRequest="54" HorizontalOptions="Start" StrokeThickness="0">
                        <Label Text="{x:Static ui:AppIcons.Sms}" FontFamily="MaterialIconsRound" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="فرستندهٔ بانکی را انتخاب کنید" Style="{StaticResource SectionTitle}" FontSize="20" />
                    <Label Text="از فهرست پیامک‌های گوشی انتخاب کنید تا نام یا شمارهٔ فرستنده بدون خطای نوشتاری ثبت شود." Style="{StaticResource MutedText}" LineHeight="1.35" />
                    <ui:DonyshButton x:Name="PickSenderButton" Glyph="{x:Static ui:AppIcons.Search}" Text="انتخاب از پیامک‌های گوشی" Clicked="OnPickSenderClicked"
                            Style="{StaticResource PrimaryAction}" AutomationId="SetupSenderButton" />
                    <Button Text="شماره یا نام را دستی وارد می‌کنم" Clicked="OnToggleManualClicked" Style="{StaticResource QuietAction}" />
                    <VerticalStackLayout x:Name="ManualSenderPanel" IsVisible="False" Spacing="9">
                        <Border Style="{StaticResource FieldCard}">
                            <Entry x:Name="ManualSenderEntry" Placeholder="شماره یا نام فرستنده" MaxLength="64"
                                   IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" ReturnType="Done"
                                   Completed="OnAddManualSenderClicked" />
                        </Border>
                        <Button Text="ثبت فرستنده" Clicked="OnAddManualSenderClicked" Style="{StaticResource SecondaryAction}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border x:Name="PermissionStepCard" Style="{StaticResource Card}" Padding="20" IsVisible="{Binding IsPermissionStep}">
                <VerticalStackLayout Spacing="14">
                    <Border Style="{StaticResource InfoCard}" WidthRequest="54" HeightRequest="54" HorizontalOptions="Start" StrokeThickness="0">
                        <Label Text="{x:Static ui:AppIcons.Security}" FontFamily="MaterialIconsRound" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="دریافت پیامک را فعال کنید" Style="{StaticResource SectionTitle}" FontSize="20" />
                    <Label Text="دُنیش فقط پیام‌های فرستنده‌هایی را که خودتان انتخاب کرده‌اید نگه می‌دارد. پیام‌های دیگر خوانده یا ارسال نمی‌شوند." Style="{StaticResource MutedText}" LineHeight="1.35" />
                    <ui:DonyshButton x:Name="PermissionButton" Glyph="{x:Static ui:AppIcons.Notification}" Text="فعال‌کردن دریافت پیامک" Clicked="OnPermissionClicked"
                            Style="{StaticResource PrimaryAction}" AutomationId="SetupPermissionButton" />
                    <Label Text="فرستنده ثبت شد؛ پس از دادن اجازه، خودکار به قدم بعد می‌روید." Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="TemplateStepCard" Style="{StaticResource Card}" Padding="20" IsVisible="{Binding IsTemplateStep}">
                <VerticalStackLayout Spacing="14">
                    <Border Style="{StaticResource InfoCard}" WidthRequest="54" HeightRequest="54" HorizontalOptions="Start" StrokeThickness="0">
                        <Label Text="{x:Static ui:AppIcons.Template}" FontFamily="MaterialIconsRound" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="روش خواندن پیام را مشخص کنید" Style="{StaticResource SectionTitle}" FontSize="20" />
                    <Label Text="با یک پیام نمونه مشخص می‌کنید مبلغ، تاریخ و نوع تراکنش از کدام بخش پیام خوانده شود. برای بانک‌های آماده، بیشتر بخش‌ها خودکار تکمیل می‌شوند." Style="{StaticResource MutedText}" LineHeight="1.35" />
                    <Border Style="{StaticResource InfoCard}" Padding="12">
                        <Label Text="{Binding SelectedSenderText}" FontAttributes="Bold" />
                    </Border>
                    <ui:DonyshButton x:Name="CreateTemplateButton" Glyph="{x:Static ui:AppIcons.Add}" Text="ساخت نخستین قالب" Clicked="OnTemplateClicked"
                            Style="{StaticResource PrimaryAction}" AutomationId="SetupTemplateButton" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="CompleteStepCard" Style="{StaticResource AccentCard}" Padding="22" IsVisible="{Binding IsCompleteStep}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{x:Static ui:AppIcons.CheckCircle}" FontFamily="MaterialIconsRound" FontSize="40" TextColor="#059669" HorizontalTextAlignment="Center" />
                    <Label Text="دُنیش آماده است" Style="{StaticResource PageTitle}" HorizontalTextAlignment="Center" />
                    <Label Text="اتصال، فرستنده و قالب ثبت شدند. از این پس پیام‌های تازه طبق انتخاب شما بررسی می‌شوند." Style="{StaticResource MutedText}" HorizontalTextAlignment="Center" LineHeight="1.35" />
                    <ui:DonyshButton x:Name="FinishButton" Glyph="{x:Static ui:AppIcons.Check}" Text="ورود به برنامه" Clicked="OnFinishClicked"
                            Style="{StaticResource SuccessAction}" AutomationId="SetupFinishButton" />
                </VerticalStackLayout>
            </Border>

            <Label x:Name="StatusLabel" IsVisible="False" Style="{StaticResource MutedText}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ui:DonyshPage>
