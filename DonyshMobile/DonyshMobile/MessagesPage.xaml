<?xml version="1.0" encoding="utf-8" ?>
<ui:DonyshPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DonyshMobile"
             xmlns:ui="clr-namespace:DonyshMobile.UI"
             x:Class="DonyshMobile.MessagesPage" x:DataType="local:MessagesPage" Title="پیام‌های فرستنده">
    <Grid x:Name="MessagesContent" RowDefinitions="Auto,Auto,*" Padding="18,12" RowSpacing="12">
        <VerticalStackLayout Spacing="5">
            <Label Text="{Binding SenderAddress}" Style="{StaticResource PageTitle}" />
            <Label Text="پیام‌های هفت روز گذشته؛ وضعیت ارسال هر پیام جداگانه مشخص است." Style="{StaticResource MutedText}" />
            <ui:DonyshButton Glyph="{x:Static ui:AppIcons.Template}" Text="قالب‌های این فرستنده" Clicked="OnTemplatesClicked" Style="{StaticResource SecondaryAction}" />
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Row="1" Spacing="7">
            <Border Style="{StaticResource FieldCard}">
                <SearchBar x:Name="MessageSearchBar" Placeholder="جست‌وجو در عنوان و متن پیام" TextChanged="OnSearchChanged" />
            </Border>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <ui:DonyshPicker x:Name="StatusPicker" Title="وضعیت پیام" SelectedIndexChanged="OnFilterChanged" SelectedIndex="0">
                    <ui:DonyshPicker.Items><x:String>همهٔ پیام‌ها</x:String><x:String>منتظر ارسال</x:String><x:String>ارسال‌شده</x:String><x:String>نیازمند بررسی</x:String><x:String>کنار گذاشته‌شده</x:String><x:String>منتظر عنوان</x:String></ui:DonyshPicker.Items>
                </ui:DonyshPicker>
                <Label Grid.Column="1" Text="{Binding MessageCountText}" Style="{StaticResource Caption}" VerticalOptions="Center" />
            </Grid>
            <ui:DonyshButton x:Name="RetryVisibleMessagesButton" Glyph="{x:Static ui:AppIcons.Refresh}" Text="بازگرداندن پیام‌های این فهرست به صف"
                    IsVisible="{Binding HasRetryableMessages}" Clicked="OnRetryVisibleClicked" Style="{StaticResource SecondaryAction}" />
            <Label x:Name="RetryStatusLabel" IsVisible="False" Style="{StaticResource MutedText}" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="2" ItemsSource="{Binding Messages}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Border Style="{StaticResource Card}" Padding="26">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="پیامی در این فهرست نیست" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="فیلتر را تغییر دهید یا منتظر پیامک تازهٔ این فرستنده باشید." Style="{StaticResource MutedText}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:MessageItem">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="{Binding Title}" FontSize="18" FontFamily="YekanBakhBold" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding ReceivedAt}" Style="{StaticResource Caption}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" Style="{StaticResource InfoCard}" Padding="10,5" StrokeThickness="0"
                                            VerticalOptions="Start">
                                        <Label Text="{Binding TransactionType}" Style="{StaticResource StatusBadge}" />
                                    </Border>
                                </Grid>
                                <Label Text="{Binding AmountText}" FontSize="22" FontFamily="YekanBakhBold"
                                       TextColor="{AppThemeBinding Light=#15243C, Dark=#F1F5FF}" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                    <Label Text="{x:Static ui:AppIcons.Sync}" Style="{StaticResource SectionIcon}" FontSize="17" WidthRequest="22" />
                                    <Label Grid.Column="1" Text="{Binding DeliveryStatus}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                </Grid>
                                <Border Style="{StaticResource AccentCard}" Padding="9,4" StrokeThickness="0"
                                        HorizontalOptions="Start" IsVisible="{Binding RecoveredFromInbox}">
                                    <Label Text="بازیابی‌شده از پیامک‌های گوشی" Style="{StaticResource Caption}" />
                                </Border>
                                <ui:DonyshButton AutomationId="MessageDetailsButton" Glyph="{x:Static ui:AppIcons.ExpandMore}" Text="{Binding DetailsAction}" CommandParameter="{Binding Id}"
                                                 Clicked="OnDetailsClicked" Style="{StaticResource QuietAction}" />

                                <VerticalStackLayout IsVisible="{Binding IsExpanded}" Spacing="10">
                                    <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#E0E7F2, Dark=#2A3953}" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                        <Label Text="{x:Static ui:AppIcons.Message}" Style="{StaticResource SectionIcon}" FontSize="18" WidthRequest="24" />
                                        <Label Grid.Column="1" Text="متن اصلی پیامک" FontFamily="YekanBakhBold" VerticalOptions="Center" />
                                    </Grid>
                                    <Border Style="{StaticResource FieldCard}" Padding="12">
                                        <Label Text="{Binding Body}" LineHeight="1.35" />
                                    </Border>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                        <ui:DonyshButton AutomationId="EditMessageTitleButton" Glyph="{x:Static ui:AppIcons.Edit}" Text="عنوان پیام" IsVisible="{Binding CanEditTitle}" CommandParameter="{Binding Id}"
                                                         Clicked="OnSetTitleClicked" Style="{StaticResource SecondaryAction}" />
                                        <ui:DonyshButton Grid.Column="1" Glyph="{x:Static ui:AppIcons.Template}" Text="قالب‌های پیامک" Clicked="OnTemplatesClicked"
                                                         Style="{StaticResource SecondaryAction}" />
                                    </Grid>
                                    <ui:DonyshButton x:Name="RetryMessageButton" Glyph="{x:Static ui:AppIcons.Refresh}" AutomationId="RetryMessageButton"
                                                     Text="بازگرداندن به صف ارسال" IsVisible="{Binding CanRetry}"
                                                     CommandParameter="{Binding Id}" Clicked="OnRetryMessageClicked" Style="{StaticResource SecondaryAction}" />
                                    <ui:DonyshButton Glyph="{x:Static ui:AppIcons.Delete}" AutomationId="ExcludeMessageButton"
                                                     Text="کنار گذاشتن از ارسال" IsVisible="{Binding CanExclude}"
                                                     CommandParameter="{Binding Id}" Clicked="OnExcludeMessageClicked" Style="{StaticResource DangerAction}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ui:DonyshPage>
