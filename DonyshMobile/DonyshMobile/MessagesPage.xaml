<?xml version="1.0" encoding="utf-8" ?>
<ui:DonyshPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:local="clr-namespace:DonyshMobile"
               xmlns:ui="clr-namespace:DonyshMobile.UI"
               x:Class="DonyshMobile.MessagesPage"
               x:DataType="local:MessagesPage"
               Title="پیام‌های فرستنده">
    <Grid x:Name="MessagesContent" RowDefinitions="Auto,Auto,Auto,*" Padding="16,10" RowSpacing="11">
        <Border Style="{StaticResource Card}" Padding="14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="پیام‌های این فرستنده" Style="{StaticResource Caption}" />
                    <Label Text="{Binding SenderAddress}" Style="{StaticResource PageTitle}" FontSize="21"
                           LineBreakMode="TailTruncation" />
                    <Label Text="{Binding MessageCountText}" Style="{StaticResource MutedText}" />
                </VerticalStackLayout>
                <ui:DonyshButton Grid.Column="1" Glyph="{x:Static ui:AppIcons.Template}" Text="قالب‌ها"
                                 Clicked="OnTemplatesClicked" Style="{StaticResource SecondaryAction}"
                                 VerticalOptions="Center" Padding="12,9" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,10">
            <VerticalStackLayout Spacing="9">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                        <Label Text="{x:Static ui:AppIcons.Filter}" Style="{StaticResource SectionIcon}" FontSize="19" WidthRequest="24" />
                        <Label Text="فیلتر سریع" Style="{StaticResource SectionTitle}" FontSize="15" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Grid.Column="1" Text="{Binding VisibleMessageCountText}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                </Grid>
                <Border Style="{StaticResource FieldCard}" Padding="8,0">
                    <SearchBar x:Name="MessageSearchBar" Placeholder="جست‌وجو در عنوان یا متن پیام"
                               TextChanged="OnSearchChanged" AutomationId="MessageSearch" />
                </Border>
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="StatusFilterChips" Spacing="5">
                        <Button x:Name="AllFilterButton" Text="همه" CommandParameter="0" Clicked="OnStatusFilterClicked"
                                Style="{StaticResource SuggestionChip}" AutomationId="FilterAll" />
                        <Button x:Name="PendingFilterButton" Text="در صف" CommandParameter="1" Clicked="OnStatusFilterClicked"
                                Style="{StaticResource SuggestionChip}" AutomationId="FilterPending" />
                        <Button x:Name="TitleFilterButton" Text="بدون عنوان" CommandParameter="5" Clicked="OnStatusFilterClicked"
                                Style="{StaticResource SuggestionChip}" AutomationId="FilterUntitled" />
                        <Button x:Name="ReviewFilterButton" Text="نیازمند بررسی" CommandParameter="3" Clicked="OnStatusFilterClicked"
                                Style="{StaticResource SuggestionChip}" AutomationId="FilterRejected" />
                        <Button x:Name="SentFilterButton" Text="ارسال‌شده" CommandParameter="2" Clicked="OnStatusFilterClicked"
                                Style="{StaticResource SuggestionChip}" AutomationId="FilterSent" />
                        <Button x:Name="ExcludedFilterButton" Text="کنار گذاشته‌شده" CommandParameter="4" Clicked="OnStatusFilterClicked"
                                Style="{StaticResource SuggestionChip}" AutomationId="FilterExcluded" />
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>
        </Border>

        <VerticalStackLayout Grid.Row="2" Spacing="6">
            <ui:DonyshButton x:Name="RetryVisibleMessagesButton" Glyph="{x:Static ui:AppIcons.Refresh}"
                             Text="بازگرداندن پیام‌های نمایان به صف" IsVisible="{Binding HasRetryableMessages}"
                             Clicked="OnRetryVisibleClicked" Style="{StaticResource SecondaryAction}" />
            <Label x:Name="RetryStatusLabel" IsVisible="False" Style="{StaticResource MutedText}" />
        </VerticalStackLayout>

        <RefreshView x:Name="MessagesRefreshView" Grid.Row="3" Refreshing="OnRefreshRequested"
                     RefreshColor="#5B4CF0">
            <CollectionView ItemsSource="{Binding Messages}" SelectionMode="None"
                            ItemsUpdatingScrollMode="KeepScrollOffset">
                <CollectionView.EmptyView>
                    <Border Style="{StaticResource Card}" Padding="28" Margin="0,6">
                        <VerticalStackLayout Spacing="9" HorizontalOptions="Center">
                            <Label Text="{x:Static ui:AppIcons.Message}" Style="{StaticResource SectionIcon}"
                                   FontSize="34" WidthRequest="48" />
                            <Label Text="پیامی پیدا نشد" FontFamily="YekanBakhBold" FontSize="17"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="عبارت جست‌وجو یا فیلتر را تغییر دهید."
                                   Style="{StaticResource MutedText}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:MessageItem">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding AmountText}" FontSize="22" FontFamily="YekanBakhBold"
                                               TextColor="{AppThemeBinding Light=#15243C, Dark=#F1F5FF}" />
                                        <Label Text="{Binding TransactionType}" Style="{StaticResource MutedText}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" Padding="9" StrokeThickness="0" HeightRequest="42" WidthRequest="42"
                                            BackgroundColor="{Binding StatusBackground}" StrokeShape="RoundRectangle 14"
                                            VerticalOptions="Start">
                                        <Label Text="{Binding StatusIcon}" FontFamily="MaterialIconsRound" FontSize="21"
                                               TextColor="{Binding StatusForeground}" HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                    <Label Text="{x:Static ui:AppIcons.Title}" Style="{StaticResource SectionIcon}"
                                           FontSize="17" WidthRequest="23" />
                                    <Label Grid.Column="1" Text="{Binding Title}" FontFamily="YekanBakhBold"
                                           LineBreakMode="TailTruncation" MaxLines="1" VerticalOptions="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                    <Label Text="{x:Static ui:AppIcons.Schedule}" Style="{StaticResource SectionIcon}"
                                           FontSize="17" WidthRequest="23" />
                                    <Label Grid.Column="1" Text="{Binding ReceivedAt}" Style="{StaticResource Caption}"
                                           VerticalOptions="Center" />
                                </Grid>
                                <Border Padding="10,6" StrokeThickness="0" BackgroundColor="{Binding StatusBackground}"
                                        StrokeShape="RoundRectangle 12">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                        <Label Text="{Binding StatusIcon}" FontFamily="MaterialIconsRound" FontSize="16"
                                               TextColor="{Binding StatusForeground}" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding DeliveryStatus}" FontFamily="YekanBakhMedium"
                                               FontSize="12" TextColor="{Binding StatusForeground}" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource AccentCard}" Padding="9,4" StrokeThickness="0"
                                        HorizontalOptions="Start" IsVisible="{Binding RecoveredFromInbox}">
                                    <Label Text="از پیامک‌های گوشی بازیابی شده" Style="{StaticResource Caption}" />
                                </Border>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="7">
                                    <ui:DonyshButton AutomationId="MessageDetailsButton" Glyph="{Binding DetailsIcon}"
                                                     Text="{Binding DetailsAction}" CommandParameter="{Binding Id}"
                                                     Clicked="OnDetailsClicked" Style="{StaticResource QuietAction}" />
                                    <ui:DonyshButton Grid.Column="1" AutomationId="EditMessageTitleButton"
                                                     Glyph="{x:Static ui:AppIcons.Edit}" Text="ثبت عنوان"
                                                     IsVisible="{Binding CanEditTitle}" CommandParameter="{Binding Id}"
                                                     Clicked="OnSetTitleClicked" Style="{StaticResource SecondaryAction}" />
                                </Grid>

                                <VerticalStackLayout IsVisible="{Binding IsExpanded}" Spacing="10">
                                    <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#E0E7F2, Dark=#2A3953}" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                        <Label Text="{x:Static ui:AppIcons.Sms}" Style="{StaticResource SectionIcon}"
                                               FontSize="18" WidthRequest="24" />
                                        <Label Grid.Column="1" Text="متن پیامک" FontFamily="YekanBakhBold" VerticalOptions="Center" />
                                    </Grid>
                                    <Border Style="{StaticResource FieldCard}" Padding="12">
                                        <Label Text="{Binding Body}" LineHeight="1.35" />
                                    </Border>
                                    <ui:DonyshButton x:Name="RetryMessageButton" Glyph="{x:Static ui:AppIcons.Refresh}"
                                                     AutomationId="RetryMessageButton" Text="بازگرداندن به صف ارسال"
                                                     IsVisible="{Binding CanRetry}" CommandParameter="{Binding Id}"
                                                     Clicked="OnRetryMessageClicked" Style="{StaticResource SecondaryAction}" />
                                    <ui:DonyshButton Glyph="{x:Static ui:AppIcons.Delete}" AutomationId="ExcludeMessageButton"
                                                     Text="کنار گذاشتن از ارسال" IsVisible="{Binding CanExclude}"
                                                     CommandParameter="{Binding Id}" Clicked="OnExcludeMessageClicked"
                                                     Style="{StaticResource DangerAction}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ui:DonyshPage>
