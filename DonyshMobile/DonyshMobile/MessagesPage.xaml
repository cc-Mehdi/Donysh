<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DonyshMobile"
             x:Class="DonyshMobile.MessagesPage"
             x:DataType="local:MessagesPage"
             FlowDirection="RightToLeft"
             >
    <Grid RowDefinitions="Auto,Auto,*" Padding="20,18" RowSpacing="14">
        <VerticalStackLayout Spacing="4">
            <Label Text="{Binding SenderAddress}" Style="{StaticResource PageTitle}" />
            <Label Text="پیام‌های دریافت‌شده در هفت روز گذشته" FontSize="13" Style="{StaticResource MutedText}" />
        </VerticalStackLayout>

        <Button Grid.Row="1" Text="قالب‌های این فرستنده" Clicked="OnTemplatesClicked"
                Style="{StaticResource PrimaryAction}" />
        <CollectionView Grid.Row="2" ItemsSource="{Binding Messages}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Border Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#475569}" StrokeDashArray="5,4" Padding="28" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="📭" FontSize="36" HorizontalTextAlignment="Center" />
                        <Label Text="در هفت روز گذشته پیامی ثبت نشده است."
                               Style="{StaticResource MutedText}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:MessageItem">
                    <Border Margin="0,0,0,10" Style="{StaticResource Card}" Padding="15">
                        <VerticalStackLayout Spacing="9">
                            <Label Text="{Binding ReceivedAt}" FontSize="11" TextColor="{AppThemeBinding Light=#4F46E5, Dark=#A5B4FC}" />
                            <Label Text="{Binding ParsedSummary}" FontSize="12" TextColor="{AppThemeBinding Light=#047857, Dark=#6EE7B7}" />
                            <Label Text="{Binding Body}" FontSize="14" LineHeight="1.5"
                                   TextColor="{AppThemeBinding Light=#1E293B, Dark=#E2E8F0}" FlowDirection="RightToLeft" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
