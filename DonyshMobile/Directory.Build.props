<Project>
  <PropertyGroup>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and Exists('$(LOCALAPPDATA)\Android\Sdk\platforms')">$(LOCALAPPDATA)\Android\Sdk</AndroidSdkDirectory>
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' and Exists('C:\Program Files\Java\jdk-17.0.19\bin\javac.exe')">C:\Program Files\Java\jdk-17.0.19</JavaSdkDirectory>
  </PropertyGroup>
</Project>
